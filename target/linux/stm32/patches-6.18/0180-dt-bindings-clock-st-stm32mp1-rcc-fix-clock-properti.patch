From fcd63b7794470e0bfd5d3045e05ed00779e337ff Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Thu, 26 Jan 2023 17:45:24 +0100
Subject: [PATCH] dt-bindings: clock: st,stm32mp1-rcc: fix clock properties

For compatible "st,stm32mp1-rcc-secure", the "ETH_RX_CLK/ETH_REF_CLK"
can be added to support optional external ethernet RX clock in the DT
as it is already supported for "st,stm32mp1-rcc".

In case of "st,stm32mp1-rcc" (stm32mp1 clock driver without RCC
security support hardened), "clocks" and "clock-names" describe
oscillators; they are optional to be backward compatible, they are
required only for "st,stm32mp1-rcc-secure".

Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I4d8a715e1032cf2d600c185268a46385b1f5d8dc
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/619780
Tested-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Reviewed-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 .../bindings/clock/st,stm32mp1-rcc.yaml       | 42 ++++++++-----------
 1 file changed, 17 insertions(+), 25 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/st,stm32mp1-rcc.yaml b/Documentation/devicetree/bindings/clock/st,stm32mp1-rcc.yaml
index 0d4a5db45b1b..1f0bc159d160 100644
--- a/Documentation/devicetree/bindings/clock/st,stm32mp1-rcc.yaml
+++ b/Documentation/devicetree/bindings/clock/st,stm32mp1-rcc.yaml
@@ -102,43 +102,35 @@ allOf:
         - clocks
         - clock-names
 
-  - if:
-      properties:
-        compatible:
-          contains:
-            const: st,stm32mp1-rcc-secure
-    then:
+    else:
       properties:
         clocks:
-          description: Specifies oscillators.
-          minItems: 5
-          maxItems: 5
+          description:
+            Specifies oscillators and the external RX clock for ethernet MAC.
+          maxItems: 6
 
         clock-names:
           items:
-            - const: hse
-            - const: hsi
-            - const: csi
-            - const: lse
-            - const: lsi
-      required:
-        - clocks
-        - clock-names
-
+            enum:
+              - hse
+              - hsi
+              - csi
+              - lse
+              - lsi
+              - ETH_RX_CLK/ETH_REF_CLK
   - if:
       properties:
         compatible:
           contains:
-            const: st,stm32mp1-rcc
+            enum:
+              - st,stm32mp1-rcc-secure
     then:
       properties:
         clocks:
-          description:
-            Specifies the external RX clock for ethernet MAC.
-          maxItems: 1
-
-        clock-names:
-          const: ETH_RX_CLK/ETH_REF_CLK
+          minItems: 5
+      required:
+        - clocks
+        - clock-names
 
 additionalProperties: false
 
-- 
2.53.0

