From b6078a5a13e7fa214a12595c3d8da8849d0237d5 Mon Sep 17 00:00:00 2001
From: Alain Volmat <alain.volmat@foss.st.com>
Date: Wed, 22 May 2024 19:47:58 +0200
Subject: [PATCH] arm64: dts: st: add dcmi node on stm32mp21x

Add the node for the DCMI controller in stm32mp211.dtsi

Signed-off-by: Alain Volmat <alain.volmat@foss.st.com>
Change-Id: I39b296c66d194d77dae776ebd3b5424c99f478a3
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/538956
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
Domain-Review: Philippe CORNU <philippe.cornu@foss.st.com>
Tested-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Philippe CORNU <philippe.cornu@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp211.dtsi b/arch/arm64/boot/dts/st/stm32mp211.dtsi
index 6c959c4b2158..c25052672e3d 100644
--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -1102,6 +1102,20 @@ ospi1: spi@40430000 {
 				status = "disabled";
 			};
 
+			dcmi: dcmi@404a0000 {
+				compatible = "st,stm32-dcmi";
+				reg = <0x404a0000 0x0 0x400>;
+				interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
+				resets = <&rcc DCMIPSSI_R>;
+				clocks = <&rcc CK_BUS_DCMIPSSI>;
+				clock-names = "mclk";
+				dmas = <&hpdma 105 0x60 0x3012>;
+				dma-names = "tx";
+				access-controllers = <&rifsc 88>;
+				power-domains = <&d1_pd>;
+				status = "disabled";
+			};
+
 			hash2: hash@42010000 {
 				compatible = "st,stm32mp13-hash";
 				reg = <0x42010000 0x0 0x400>;
-- 
2.53.0

