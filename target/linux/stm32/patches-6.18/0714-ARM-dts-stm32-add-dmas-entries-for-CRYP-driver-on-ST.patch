From 3695ea427f6c54e7a9648430e43803d55dd3f2cf Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 9 Mar 2026 17:07:16 +0100
Subject: [PATCH] ARM: dts: stm32: add dmas entries for CRYP driver on STM32MP1

The CRYP IP can use the MDMA to transfer in and out buffers.
The DMA can be used in CRYP for stm32mp13xc, stm32mp13xf, stm32mp15xc,
stm32mp15xf. It is enabled by default to gain performance.

Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Change-Id: Ia67b3e037282ae1b3d61627441973266b881f4fa
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/545752
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm/boot/dts/st/stm32mp13xc.dtsi | 3 +++
 arch/arm/boot/dts/st/stm32mp13xf.dtsi | 3 +++
 arch/arm/boot/dts/st/stm32mp15xc.dtsi | 3 +++
 arch/arm/boot/dts/st/stm32mp15xf.dtsi | 3 +++
 4 files changed, 12 insertions(+)

--- a/arch/arm/boot/dts/st/stm32mp13xc.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp13xc.dtsi
@@ -11,6 +11,9 @@
 		interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH>;
 		clocks = <&rcc CRYP1>;
 		resets = <&rcc CRYP1_R>;
+		dmas = <&mdma 28 0x0 0x400202 0x0 0x0>,
+		       <&mdma 29 0x3 0x400808 0x0 0x0>;
+		dma-names = "mem2cryp", "cryp2mem";
 		access-controllers = <&etzpc 42>;
 		status = "disabled";
 	};
--- a/arch/arm/boot/dts/st/stm32mp13xf.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp13xf.dtsi
@@ -11,6 +11,9 @@
 		interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH>;
 		clocks = <&rcc CRYP1>;
 		resets = <&rcc CRYP1_R>;
+		dmas = <&mdma 28 0x0 0x400202 0x0 0x0>,
+		       <&mdma 29 0x3 0x400808 0x0 0x0>;
+		dma-names = "mem2cryp", "cryp2mem";
 		access-controllers = <&etzpc 42>;
 		status = "disabled";
 	};
--- a/arch/arm/boot/dts/st/stm32mp15xc.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp15xc.dtsi
@@ -11,6 +11,9 @@
 		interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>;
 		clocks = <&rcc CRYP1>;
 		resets = <&rcc CRYP1_R>;
+		dmas = <&mdma1 29 0x0 0x400202 0x0 0x0>,
+		       <&mdma1 30 0x3 0x400808 0x0 0x0>;
+		dma-names = "mem2cryp", "cryp2mem";
 		access-controllers = <&etzpc 9>;
 		status = "disabled";
 	};
--- a/arch/arm/boot/dts/st/stm32mp15xf.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp15xf.dtsi
@@ -13,6 +13,9 @@
 		interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>;
 		clocks = <&rcc CRYP1>;
 		resets = <&rcc CRYP1_R>;
+		dmas = <&mdma1 29 0x0 0x400202 0x0 0x0>,
+		       <&mdma1 30 0x3 0x400808 0x0 0x0>;
+		dma-names = "mem2cryp", "cryp2mem";
 		access-controllers = <&etzpc 9>;
 		status = "disabled";
 	};
