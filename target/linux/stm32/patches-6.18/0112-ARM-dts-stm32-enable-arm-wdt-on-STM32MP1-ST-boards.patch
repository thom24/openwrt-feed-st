 arch/arm/boot/dts/st/stm32mp157f-dk2.dts | 6 ++++++
 arch/arm/boot/dts/st/stm32mp157f-ed1.dts | 6 ++++++
 9 files changed, 54 insertions(+)

--- a/arch/arm/boot/dts/st/stm32mp135f-dk.dts
+++ b/arch/arm/boot/dts/st/stm32mp135f-dk.dts
@@ -167,6 +167,12 @@
 	};
 };
 
+&arm_wdt {
+	timeout-sec = <32>;
+	bootph-all;
+	status = "okay";
+};
+
 &bsec {
 	bootph-all;
 };
--- a/arch/arm/boot/dts/st/stm32mp157a-dk1.dts
+++ b/arch/arm/boot/dts/st/stm32mp157a-dk1.dts
@@ -21,6 +21,12 @@
 	};
 };
 
+&arm_wdt {
+	timeout-sec = <32>;
+	bootph-all;
+	status = "okay";
+};
+
 &cpu0 {
 	clocks = <&scmi_clk CK_SCMI_MPU>;
 };
