From deeddbcf425ad9aa3600a4d254a92b9fb286da84 Mon Sep 17 00:00:00 2001
From: Pankaj Dev <pankaj.dev@st.com>
Date: Wed, 23 Nov 2022 20:19:55 +0530
Subject: [PATCH] arm64: dts: st: add USB3DR support in stm32mp257f-ev1

Add the required node(s) for USB3-DWC3 support: USB3DR
Enable usb-role-switch on stm32mp257f-ev1, to support dual role USB2
with power delivery on Type-C connector.

Signed-off-by: Pankaj Dev <pankaj.dev@st.com>
Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: I3c60586ce242e1afe65cf144deff1ecf0e984917
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/568992
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 31 ++++++++++++++++++++++
 1 file changed, 31 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -708,6 +708,23 @@
 		#address-cells = <1>;
 		#size-cells = <0>;
 		status = "okay";
+
+		typec@35 {
+			compatible = "st,stm32mp25-typec";
+			reg = <0x35>;
+			interrupts-extended = <&intc_rpmsg 0>;
+			status = "okay";
+			connector {
+				compatible = "usb-c-connector";
+				label = "USB-C";
+
+				port {
+					typec_ep: endpoint {
+						remote-endpoint = <&dwc3_ep>;
+					};
+				};
+			};
+		};
 	};
 };
 
@@ -1006,6 +1023,20 @@
 	status = "okay";
 };
 
+&usb3dr {
+	status = "okay";
+
+	dwc3: usb@48300000 {
+		maximum-speed = "high-speed";
+		usb-role-switch;
+		port {
+			dwc3_ep: endpoint {
+				remote-endpoint = <&typec_ep>;
+			};
+		};
+	};
+};
+
 &usbh {
 	status = "okay";
 
