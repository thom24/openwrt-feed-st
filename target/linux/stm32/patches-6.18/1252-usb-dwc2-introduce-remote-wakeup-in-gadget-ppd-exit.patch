From c6d6fd47f53581125b1ad45b9a57e081df6f2c32 Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Mon, 17 Feb 2025 16:27:51 +0100
Subject: [PATCH] usb: dwc2: introduce remote wakeup in gadget ppd exit

Add remote wakeup parameter to dwc2_gadget_exit_partial_power_down()
routine.
This is a precursor patch to add support for device initiated wakeup.

Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: Icc5db01a34cae137787a0cad0ae8e7da02774c27
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/438174
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Pankaj DEV <pankaj.dev@st.com>
---
 drivers/usb/dwc2/core.c   |  2 +-
 drivers/usb/dwc2/core.h   |  4 ++--
 drivers/usb/dwc2/drd.c    |  2 +-
 drivers/usb/dwc2/gadget.c | 16 +++++++++++++++-
 4 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/drivers/usb/dwc2/core.c b/drivers/usb/dwc2/core.c
index 368da20ae14d..dd206a7bd8c0 100644
--- a/drivers/usb/dwc2/core.c
+++ b/drivers/usb/dwc2/core.c
@@ -120,7 +120,7 @@ int dwc2_exit_partial_power_down(struct dwc2_hsotg *hsotg, int rem_wakeup,
 		return dwc2_host_exit_partial_power_down(hsotg, rem_wakeup,
 							 restore);
 	else
-		return dwc2_gadget_exit_partial_power_down(hsotg, restore);
+		return dwc2_gadget_exit_partial_power_down(hsotg, rem_wakeup, restore);
 }
 
 /**
diff --git a/drivers/usb/dwc2/core.h b/drivers/usb/dwc2/core.h
index b8ab5f08a2b2..4dffedffe07d 100644
--- a/drivers/usb/dwc2/core.h
+++ b/drivers/usb/dwc2/core.h
@@ -1456,7 +1456,7 @@ int dwc2_gadget_exit_hibernation(struct dwc2_hsotg *hsotg,
 				 int rem_wakeup, int reset);
 int dwc2_gadget_enter_partial_power_down(struct dwc2_hsotg *hsotg);
 int dwc2_gadget_exit_partial_power_down(struct dwc2_hsotg *hsotg,
-					bool restore);
+					int rem_wakeup, bool restore);
 void dwc2_gadget_enter_clock_gating(struct dwc2_hsotg *hsotg);
 void dwc2_gadget_exit_clock_gating(struct dwc2_hsotg *hsotg,
 				   int rem_wakeup);
@@ -1504,7 +1504,7 @@ static inline int dwc2_gadget_exit_hibernation(struct dwc2_hsotg *hsotg,
 static inline int dwc2_gadget_enter_partial_power_down(struct dwc2_hsotg *hsotg)
 { return 0; }
 static inline int dwc2_gadget_exit_partial_power_down(struct dwc2_hsotg *hsotg,
-						      bool restore)
+						      int rem_wakeup, bool restore)
 { return 0; }
 static inline void dwc2_gadget_enter_clock_gating(struct dwc2_hsotg *hsotg) {}
 static inline void dwc2_gadget_exit_clock_gating(struct dwc2_hsotg *hsotg,
diff --git a/drivers/usb/dwc2/drd.c b/drivers/usb/dwc2/drd.c
index a267e79190af..65c1a3677532 100644
--- a/drivers/usb/dwc2/drd.c
+++ b/drivers/usb/dwc2/drd.c
@@ -215,7 +215,7 @@ static int dwc2_drd_role_sw_set(struct usb_role_switch *sw, enum usb_role role)
 	     dwc2_is_device_mode(hsotg) &&
 	     hsotg->lx_state == DWC2_L2) {
 		if (hsotg->in_ppd)
-			dwc2_gadget_exit_partial_power_down(hsotg, true);
+			dwc2_gadget_exit_partial_power_down(hsotg, 0, true);
 
 		if (hsotg->params.power_down == DWC2_POWER_DOWN_PARAM_NONE &&
 		    !hsotg->params.no_clock_gating)
diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
index ef11d31f47e7..d512ea04a0d6 100644
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -5794,6 +5794,7 @@ int dwc2_gadget_enter_partial_power_down(struct dwc2_hsotg *hsotg)
  * power down.
  *
  * @hsotg: Programming view of the DWC_otg controller
+ * @rem_wakeup: indicates device initiated remote wakeup signal
  * @restore: indicates whether need to restore the registers or not.
  *
  * Return: non-zero if failed to exit device partial power down.
@@ -5801,7 +5802,7 @@ int dwc2_gadget_enter_partial_power_down(struct dwc2_hsotg *hsotg)
  * This function is for exiting from device mode partial power down.
  */
 int dwc2_gadget_exit_partial_power_down(struct dwc2_hsotg *hsotg,
-					bool restore)
+					int rem_wakeup, bool restore)
 {
 	u32 pcgcctl;
 	u32 dctl;
@@ -5834,6 +5835,19 @@ int dwc2_gadget_exit_partial_power_down(struct dwc2_hsotg *hsotg,
 	dctl |= DCTL_PWRONPRGDONE;
 	dwc2_writel(hsotg, dctl, DCTL);
 
+	if (rem_wakeup) {
+		u32 glpmcfg = dwc2_readl(hsotg, GLPMCFG);
+
+		if (glpmcfg & (GLPMCFG_ENBLSLPM | GLPMCFG_HIRD_THRES_MASK)) {
+			glpmcfg &= ~(GLPMCFG_ENBLSLPM | GLPMCFG_HIRD_THRES_MASK);
+			dwc2_writel(hsotg, glpmcfg, GLPMCFG);
+		}
+
+		dwc2_writel(hsotg, dctl | DCTL_RMTWKUPSIG, DCTL);
+		mdelay(1);
+		dwc2_writel(hsotg, dctl, DCTL);
+	}
+
 	/* Set in_ppd flag to 0 as here core exits from suspend. */
 	hsotg->in_ppd = 0;
 	hsotg->lx_state = DWC2_L0;
-- 
2.53.0

