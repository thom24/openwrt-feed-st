From 8e25e7d272dbc67829387ab37e5c9cd88193850e Mon Sep 17 00:00:00 2001
From: Simeon Marijon <simeon.marijon@foss.st.com>
Date: Fri, 25 Aug 2023 09:40:13 +0200
Subject: [PATCH] dt-bindings: arm: stm32: add st,stm32-tamp-nvram's properties
 for syscon

st,stm32-tamp-nvram requires some specific properties from its parent
st,stm32-syscon.

Change-Id: I05f9807afdf105e0701a5042cc125eb9ceb6e725
Signed-off-by: Simeon Marijon <simeon.marijon@foss.st.com>
Signed-off-by: Patrice Chotard <patrice.chotard@foss.st.com>
---
 .../bindings/arm/stm32/st,stm32-syscon.yaml   | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/stm32/st,stm32-syscon.yaml b/Documentation/devicetree/bindings/arm/stm32/st,stm32-syscon.yaml
index 95d2319afe23..d893e183fee8 100644
--- a/Documentation/devicetree/bindings/arm/stm32/st,stm32-syscon.yaml
+++ b/Documentation/devicetree/bindings/arm/stm32/st,stm32-syscon.yaml
@@ -39,6 +39,19 @@ properties:
   "#clock-cells":
     const: 0
 
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 1
+
+  ranges: true
+
+patternProperties:
+  "^nvram@[0-9a-f]+$":
+    type: object
+    $ref: /schemas/nvmem/st,stm32-tamp-nvram.yaml#
+
 required:
   - compatible
   - reg
@@ -61,6 +74,15 @@ allOf:
     then:
       required:
         - "#clock-cells"
+  - if:
+      properties:
+        compatible:
+          const: st,stm32-tamp
+    then:
+      required:
+        - '#address-cells'
+        - '#size-cells'
+        - ranges
 
 additionalProperties: false
 
-- 
2.53.0

