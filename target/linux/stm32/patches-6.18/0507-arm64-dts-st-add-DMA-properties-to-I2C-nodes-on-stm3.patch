From 857f8687e7cfa2943c380e0fcefda26054165e7e Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Mon, 25 May 2026 11:38:40 +0200
Subject: [PATCH] arm64: dts: st: add DMA properties to I2C nodes on stm32mp21

Enable DMA support on I2C of stm32mp21.

Change-Id: I59816ea6dfb68fa5426217b3263932e90fd0b764
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/571049
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp211.dtsi b/arch/arm64/boot/dts/st/stm32mp211.dtsi
index 338a631dbeba..776728749208 100644
--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -299,6 +299,9 @@ i2c1: i2c@40170000 {
 				resets = <&rcc I2C1_R>;
 				#address-cells = <1>;
 				#size-cells = <0>;
+				dmas = <&hpdma 23 0x40 0x3012>,
+				       <&hpdma 24 0x40 0x3021>;
+				dma-names = "rx", "tx";
 				access-controllers = <&rifsc 41>;
 				i2c-analog-filter;
 				wakeup-source;
@@ -315,6 +318,9 @@ i2c2: i2c@40180000 {
 				resets = <&rcc I2C2_R>;
 				#address-cells = <1>;
 				#size-cells = <0>;
+				dmas = <&hpdma 26 0x40 0x3012>,
+				       <&hpdma 27 0x40 0x3021>;
+				dma-names = "rx", "tx";
 				access-controllers = <&rifsc 42>;
 				i2c-analog-filter;
 				wakeup-source;
@@ -351,6 +357,9 @@ i2c3: i2c@46040000 {
 				resets = <&rcc I2C3_R>;
 				#address-cells = <1>;
 				#size-cells = <0>;
+				dmas = <&hpdma 29 0x40 0x3012>,
+				       <&hpdma 30 0x40 0x3021>;
+				dma-names = "rx", "tx";
 				access-controllers = <&rifsc 43>;
 				i2c-analog-filter;
 				wakeup-source;
-- 
2.53.0

