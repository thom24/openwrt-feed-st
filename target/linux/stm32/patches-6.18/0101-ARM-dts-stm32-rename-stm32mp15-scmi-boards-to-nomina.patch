-	stm32mp157c-dk2-scmi.dtb \
+	stm32mp157c-ed1.dtb \
 	stm32mp157c-ed1-no-scmi.dtb \
-	stm32mp157c-ed1-scmi.dtb \
 	stm32mp157c-emsbc-argon.dtb \
+	stm32mp157c-ev1.dtb \
 	stm32mp157c-ev1-no-scmi.dtb \
-	stm32mp157c-ev1-scmi.dtb \
 	stm32mp157c-lxa-mc1.dtb \
 	stm32mp157c-lxa-tac-gen1.dtb \
 	stm32mp157c-lxa-tac-gen2.dtb \
diff --git a/arch/arm/boot/dts/st/stm32mp157a-dk1-scmi.dts b/arch/arm/boot/dts/st/stm32mp157a-dk1.dts
similarity index 92%
rename from arch/arm/boot/dts/st/stm32mp157a-dk1-scmi.dts
rename to arch/arm/boot/dts/st/stm32mp157a-dk1.dts
index 0aec1f305737..c3f18f9b5bdb 100644
--- a/arch/arm/boot/dts/st/stm32mp157a-dk1-scmi.dts
+++ b/arch/arm/boot/dts/st/stm32mp157a-dk1.dts
