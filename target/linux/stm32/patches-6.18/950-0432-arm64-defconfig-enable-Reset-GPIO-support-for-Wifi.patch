From 36ddfb882d7ee595d4813eb4798a66a379502e8f Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Fri, 12 Jun 2026 14:00:14 +0200
Subject: [PATCH] arm64: defconfig: enable Reset GPIO support for Wifi

Move the Reset GPIO in built-in instead of module to avoid
deferred error during boot sequence.

Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Change-Id: I0f5e475d6a2b90e98c0aa23e73fd7373ef7a62b2
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/578514
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/configs/fragment-02-defconfig-addons.config | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/fragment-02-defconfig-addons.config b/arch/arm64/configs/fragment-02-defconfig-addons.config
index df5a9db22dc4..38395d14177b 100644
--- a/arch/arm64/configs/fragment-02-defconfig-addons.config
+++ b/arch/arm64/configs/fragment-02-defconfig-addons.config
@@ -54,6 +54,7 @@ CONFIG_PWM_STM32_LP=m
 CONFIG_REALTEK_PHY=y
 CONFIG_REGULATOR_ARM_SCMI=y
 CONFIG_REGULATOR_WM8994=m
+CONFIG_RESET_GPIO=y
 CONFIG_RPMSG_IRQ=m
 CONFIG_RPMSG_TTY=m
 CONFIG_RPMSG_VIRTIO=m
-- 
2.53.0

