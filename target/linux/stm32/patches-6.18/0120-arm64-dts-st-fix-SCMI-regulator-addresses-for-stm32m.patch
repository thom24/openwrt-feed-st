From bee77069734429ec58219d148ebb558714c72614 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 13 Feb 2026 11:51:30 +0100
Subject: [PATCH] arm64: dts: st: fix SCMI regulator addresses for
 stm32mp257f-ev1 board

The SCMI regulators for STPMIC2 were using incorrect child node
addresses in the ST SCMI voltage domain description. Align the
regulator node unit-addresses with the actual SCMI voltage domain
indices so that DT validation and SCMI regulator lookup are consistent.

Update the following SCMI regulator nodes:
- vddcore:    regulator@11 -> regulator@b
- v1v8:       regulator@14 -> regulator@e
- v3v3:       regulator@16 -> regulator@10
- vdd_emmc:   regulator@18 -> regulator@12
- vdd3v3_usb: regulator@20 -> regulator@14
- vdd_sdcard: regulator@23 -> regulator@17

Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Id9af9f0d32588bc9de9269de67209c767b639591
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/535990
Tested-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -459,27 +459,27 @@
 		regulator-min-microvolt = <1800000>;
 		regulator-max-microvolt = <3300000>;
 	};
-	scmi_vddcore: regulator@11  {
+	scmi_vddcore: regulator@b {
 		reg = <VOLTD_SCMI_STPMIC2_BUCK2>;
 		regulator-name = "vddcore";
 	};
-	scmi_v1v8: regulator@14  {
+	scmi_v1v8: regulator@e {
 		reg = <VOLTD_SCMI_STPMIC2_BUCK5>;
 		regulator-name = "v1v8";
 	};
-	scmi_v3v3: regulator@16 {
+	scmi_v3v3: regulator@10 {
 		reg = <VOLTD_SCMI_STPMIC2_BUCK7>;
 		regulator-name = "v3v3";
 	};
-	scmi_vdd_emmc: regulator@18 {
+	scmi_vdd_emmc: regulator@12 {
 		reg = <VOLTD_SCMI_STPMIC2_LDO2>;
 		regulator-name = "vdd_emmc";
 	};
-	scmi_vdd3v3_usb: regulator@20 {
+	scmi_vdd3v3_usb: regulator@14 {
 		reg = <VOLTD_SCMI_STPMIC2_LDO4>;
 		regulator-name = "vdd3v3_usb";
 	};
-	scmi_vdd_sdcard: regulator@23 {
+	scmi_vdd_sdcard: regulator@17 {
 		reg = <VOLTD_SCMI_STPMIC2_LDO7>;
 		regulator-name = "vdd_sdcard";
 	};
