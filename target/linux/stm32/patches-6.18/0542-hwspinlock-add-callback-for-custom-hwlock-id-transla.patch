From 280dc13c01d798a02e258e5d872491a59b1e9021 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Tue, 17 Mar 2026 18:29:18 +0100
Subject: [PATCH] hwspinlock: add callback for custom hwlock id translation

The simple linear translation is not suitable for all the drivers.

Add a driver specific callback to handle custom translations.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: Ie4d5bf1f679ca83fc69a9b92a039c8d5638d9b35
---
 drivers/hwspinlock/hwspinlock_core.c | 11 +++++++++--
 include/linux/hwspinlock/provider.h  |  4 ++++
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/drivers/hwspinlock/hwspinlock_core.c b/drivers/hwspinlock/hwspinlock_core.c
index e78ec4b5cfa3..0ad5240631a9 100644
--- a/drivers/hwspinlock/hwspinlock_core.c
+++ b/drivers/hwspinlock/hwspinlock_core.c
@@ -366,17 +366,24 @@ EXPORT_SYMBOL_GPL(hwspin_lock_bust);
 
 /**
  * of_hwspin_lock_simple_xlate - translate hwlock_spec to return a lock id
+ * @bank: the hwspinlock device, which usually provides numerous hw locks
  * @hwlock_spec: hwlock specifier as found in the device tree
  *
  * This is a simple translation function, suitable for hwspinlock platform
  * drivers that only has a lock specifier length of 1.
+ * Custom translations are forwarded and handled by the driver specific
+ * callback xlate().
  *
  * Returns: a relative index of the lock within a specified bank on success,
  * or -EINVAL on invalid specifier cell count.
  */
 static inline int
-of_hwspin_lock_simple_xlate(const struct of_phandle_args *hwlock_spec)
+of_hwspin_lock_simple_xlate(const struct hwspinlock_device *bank,
+			    const struct of_phandle_args *hwlock_spec)
 {
+	if (bank->ops->xlate)
+		return bank->ops->xlate(hwlock_spec);
+
 	if (WARN_ON(hwlock_spec->args_count != 1))
 		return -EINVAL;
 
@@ -438,7 +445,7 @@ int of_hwspin_lock_get_id(struct device_node *np, int index)
 	if (ret < 0)
 		goto out;
 
-	id = of_hwspin_lock_simple_xlate(&args);
+	id = of_hwspin_lock_simple_xlate(hwlock->bank, &args);
 	if (id < 0 || id >= hwlock->bank->num_locks) {
 		ret = -EINVAL;
 		goto out;
diff --git a/include/linux/hwspinlock/provider.h b/include/linux/hwspinlock/provider.h
index 73c7b0cb6735..af4c11d0b7be 100644
--- a/include/linux/hwspinlock/provider.h
+++ b/include/linux/hwspinlock/provider.h
@@ -15,6 +15,7 @@
 struct device;
 struct hwspinlock;
 struct hwspinlock_device;
+struct of_phandle_args;
 
 /**
  * struct hwspinlock_ops - platform-specific hwspinlock handlers
@@ -27,6 +28,8 @@ struct hwspinlock_device;
  * @relax:	optional, platform-specific relax handler, called by hwspinlock
  *		core while spinning on a lock, between two successive
  *		invocations of @trylock. may _not_ sleep.
+ * @xlate:	optional, platform-specific translate hwlock_spec to return a
+ *		lock id.
  * @init_priv:	optional, callback used when registering the hwspinlock device.
  *		Its return value will be used to fill the per-lock 'priv' data.
  */
@@ -35,6 +38,7 @@ struct hwspinlock_ops {
 	void (*unlock)(struct hwspinlock *lock);
 	int (*bust)(struct hwspinlock *lock, unsigned int id);
 	void (*relax)(struct hwspinlock *lock);
+	int (*xlate)(const struct of_phandle_args *hwlock_spec);
 	void *(*init_priv)(int local_id, void *init_data);
 };
 
-- 
