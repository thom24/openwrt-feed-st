From 5372515ff3cf7b8ce3e9758e58a1c82eb34277d6 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Mon, 25 May 2026 14:35:39 +0200
Subject: [PATCH] arm64: dts: st: support ddrperfm on stm32mp257f-ev1 (FIX)

Enable the peripheral in the board file.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: Ie45a1eed35b0f7814cc75382f4dfda5388e3a6e9
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/571225
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
index 3101c33e041f..0ae50e0b16d5 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -324,11 +324,6 @@ &dbg_bus {
 	status = "okay";
 };
 
-&ddrperfm {
-	memory-channel = <&ddr_channel>;
-	status = "disabled";
-};
-
 &dcmipp {
 	status = "okay";
 	port {
@@ -339,6 +334,11 @@ dcmipp_0: endpoint {
 	};
 };
 
+&ddrperfm {
+	memory-channel = <&ddr_channel>;
+	status = "okay";
+};
+
 &dsi {
 	vdd-supply =  <&scmi_vddcore>;
 	vdda18-supply = <&scmi_v1v8>;
-- 
2.53.0

