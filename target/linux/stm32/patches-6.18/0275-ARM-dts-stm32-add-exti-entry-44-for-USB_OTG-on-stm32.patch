From 20ef1b5c0df4c9c8512f35935ff6f65cddad4693 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Mon, 17 Oct 2022 16:16:23 +0200
Subject: [PATCH] ARM: dts: stm32: add exti entry 44 for USB_OTG on stm32mp151

Add exti entry 44 used for USB_OTG wake up.
This event is mapped to GIC 98.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Signed-off-by: Alexandre Torgue <alexandre.torgue@foss.st.com>
Change-Id: I33c2237363e34b309b0d4c1aa4d528909672b6d0
---
 arch/arm/boot/dts/st/stm32mp151.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/st/stm32mp151.dtsi b/arch/arm/boot/dts/st/stm32mp151.dtsi
index e7f6e307c63c..164885d50ba4 100644
--- a/arch/arm/boot/dts/st/stm32mp151.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp151.dtsi
@@ -258,7 +258,7 @@ exti: interrupt-controller@5000d000 {
 				<0>,
 				<0>,
 				<&intc GIC_SPI 75  IRQ_TYPE_LEVEL_HIGH>,
-				<0>,
+				<&intc GIC_SPI 98  IRQ_TYPE_LEVEL_HIGH>,
 				<0>,
 				<&intc GIC_SPI 151 IRQ_TYPE_LEVEL_HIGH>,
 				<&intc GIC_SPI 93  IRQ_TYPE_LEVEL_HIGH>,
-- 
2.53.0

