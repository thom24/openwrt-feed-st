From aa48139fb5a250283875c596e13cddfaaa84aa4f Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Mon, 25 May 2026 14:16:40 +0200
Subject: [PATCH] arm64: dts: st: support ddrperfm on stm32mp215f-dk

Configure and enable DDRPERFM node on stm32mp215f-dk board.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I1ec78c34e50157de93f8046c9e1eba28d9051024
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/571231
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp215f-dk.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
index 2a01beae809b..655861189c30 100644
--- a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
@@ -312,6 +312,11 @@ dcmipp_0: endpoint {
 	};
 };
 
+&ddrperfm {
+	memory-channel = <&lpddr_channel>;
+	status = "okay";
+};
+
 &ethernet1 {
 	status = "okay";
 	pinctrl-0 = <&eth1_rmii_pins_a>;
-- 
2.53.0

