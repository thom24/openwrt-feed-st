From f3f2035666f7ed727e71b409486455b7f8b96900 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Thu, 19 Mar 2026 18:01:08 +0100
Subject: [PATCH] arm64: dts: st: add LPUART1 support on stm32mp21

The LPUART is an UART with limited power consumption and limited feature
set: no auto baud rate detection, no receiver timeout interrupt, smaller
Tx/Rx FIFO.
Add LPUART1 support on stm32mp21.

Change-Id: I1ae408f3eb297d1111fcbd4c6ad1363193266b55
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/549176
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -1000,6 +1000,20 @@
 				status = "disabled";
 			};
 
+			lpuart1: serial@46030000 {
+				compatible = "st,stm32h7-uart";
+				reg = <0x46030000 0x0 0x400>;
+				interrupts-extended = <&exti2 26 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_LPUART1>;
+				dmas = <&hpdma 134 0x20 0x10012>,
+				       <&hpdma 135 0x20 0x3021>;
+				dma-names = "rx", "tx";
+				access-controllers = <&rifsc 40>;
+				power-domains = <&d1_pd>;
+				wakeup-source;
+				status = "disabled";
+			};
+
 			i2c3: i2c@46040000 {
 				compatible = "st,stm32mp25-i2c";
 				reg = <0x46040000 0x0 0x400>;
