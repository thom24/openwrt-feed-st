From 92dadc160f9c544584847e8c4e97b3b7f9e74af1 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Fri, 25 Jul 2025 10:56:17 +0200
Subject: [PATCH] dt-bindings: mfd: st: fix misspellings of
 "STMicroelectronics"

"STMicroelectronics" company name is misspelled in the title of STMPIC1,
STMFX and STMPE bindings. Fix these misspellings.

Change-Id: I6a4a6e6fef63985acf38e525e49270931c06f499
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/569540
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 Documentation/devicetree/bindings/mfd/st,stmfx.yaml   | 2 +-
 Documentation/devicetree/bindings/mfd/st,stmpe.yaml   | 2 +-
 Documentation/devicetree/bindings/mfd/st,stpmic1.yaml | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

--- a/Documentation/devicetree/bindings/mfd/st,stmfx.yaml
+++ b/Documentation/devicetree/bindings/mfd/st,stmfx.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/mfd/st,stmfx.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: STMicroelectonics Multi-Function eXpander (STMFX)
+title: STMicroelectronics Multi-Function eXpander (STMFX)
 
 description: ST Multi-Function eXpander (STMFX) is a slave controller using I2C for
                communication with the main MCU. Its main features are GPIO expansion,
--- a/Documentation/devicetree/bindings/mfd/st,stmpe.yaml
+++ b/Documentation/devicetree/bindings/mfd/st,stmpe.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/mfd/st,stmpe.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: STMicroelectonics Port Expander (STMPE)
+title: STMicroelectronics Port Expander (STMPE)
 
 description: STMicroelectronics Port Expander (STMPE) is a series of slow
   bus controllers for various expanded peripherals such as GPIO, keypad,
--- a/Documentation/devicetree/bindings/mfd/st,stpmic1.yaml
+++ b/Documentation/devicetree/bindings/mfd/st,stpmic1.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/mfd/st,stpmic1.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: STMicroelectonics STPMIC1 Power Management IC
