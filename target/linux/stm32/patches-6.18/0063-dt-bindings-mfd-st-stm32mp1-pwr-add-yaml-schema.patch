From a690f62202995e9c146fa64f511146c938216547 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Mon, 20 Apr 2026 17:11:51 +0200
Subject: [PATCH] dt-bindings: mfd: st,stm32mp1-pwr: add yaml schema

Add a YAML schema for the STM32MP1 PWR controller binding and replace
the legacy text documentation.

Document the controller resources, wake-up source description, and
interrupt consumer format for schema validation.

Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I4cbd2003857af5d4b56451b8e05c718014b9278e
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559594
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 .../bindings/mfd/st,stm32mp1-pwr.yaml         | 80 +++++++++++++++++++
 1 file changed, 80 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mfd/st,stm32mp1-pwr.yaml

diff --git a/Documentation/devicetree/bindings/mfd/st,stm32mp1-pwr.yaml b/Documentation/devicetree/bindings/mfd/st,stm32mp1-pwr.yaml
new file mode 100644
index 000000000000..b78c8c8c5215
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/st,stm32mp1-pwr.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/st,stm32mp1-pwr.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STMicroelectronics STM32MP1 Power Management Controller
+
+description: |
+  The PWR IP is responsible for handling power-related resources such as
+  clocks, power supplies, and resets.
+
+  It provides 6 wake-up pins handled by an interrupt controller. These
+  wake-up pins can be used to wake up the SoC from the STANDBY state.
+
+maintainers:
+  - Pascal Paillet <p.paillet@foss.st.com>
+
+deprecated: true
+
+properties:
+  compatible:
+    items:
+      - const: st,stm32mp1-pwr
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: Reference to the GIC wake-up pin interrupt.
+
+  interrupt-controller: true
+
+  "#interrupt-cells":
+    const: 3
+    description: |
+      Interrupt specifier cells:
+        - cell 1: wake-up pin id from 0 to 5
+        - cell 2: IRQ trigger type
+        - cell 3: pull configuration
+          - 0: no pull
+          - 1: pull-up
+          - 2: pull-down
+
+  st,wakeup-pins:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    description: List of GPIO specifiers describing each wake-up pin.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-controller
+  - "#interrupt-cells"
+  - st,wakeup-pins
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/gpio/gpio.h>
+
+    pwr_irq: pwr@50001020 {
+      compatible = "st,stm32mp1-pwr";
+      reg = <0x50001020 0x100>;
+      interrupts = <GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>;
+      interrupt-controller;
+      #interrupt-cells = <3>;
+
+      st,wakeup-pins = <&gpioa 0 GPIO_ACTIVE_HIGH>,
+                        <&gpioa 2 GPIO_ACTIVE_HIGH>,
+                        <&gpioc 13 GPIO_ACTIVE_HIGH>,
+                        <&gpioi 8 GPIO_ACTIVE_HIGH>,
+                        <&gpioi 11 GPIO_ACTIVE_HIGH>,
+                        <&gpioc 1 GPIO_ACTIVE_HIGH>;
+      };
+...
-- 
