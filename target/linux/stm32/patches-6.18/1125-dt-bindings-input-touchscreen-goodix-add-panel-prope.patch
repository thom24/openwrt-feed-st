From 50404ffd268d7419941d6a57f613847fac78110e Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Wed, 22 Apr 2026 11:28:11 +0200
Subject: [PATCH] dt-bindings: input: touchscreen: goodix: add panel property

Add a new "panel" property to resolve the issue when checking dtbs.
This property was added due to a link between the panel reset and
the touchscreen reset. This is a hack and should not be upstream.
Not upstreamable.

Change-Id: Ia7ec079b84d29f086a7fed694228fd3dc3d3a0bb
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/560170
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 .../devicetree/bindings/input/touchscreen/goodix.yaml          | 3 +++
 1 file changed, 3 insertions(+)

--- a/Documentation/devicetree/bindings/input/touchscreen/goodix.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/goodix.yaml
@@ -57,6 +57,9 @@ properties:
   touchscreen-size-y: true
   touchscreen-swapped-x-y: true
 
+  panel:
+    description: phandle to the panel.
+
 additionalProperties: false
 
 required:
