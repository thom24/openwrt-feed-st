From 9e29a63430e2befafa53587f06910723f175413b Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Thu, 16 Apr 2026 17:28:19 +0200
Subject: [PATCH] arm64: dts: st: add USBH support in stm32mp257f-ev1 board

Add USBH support in stm32mp257f-ev1 board. There's an on-board High-Speed
USB Hub. So add it as a child of the USBH EHCI (High Speed controller) DT
node. The OHCI can be disabled, as no low or full speed traffic is
expected.

Signed-off-by: Pankaj Dev <pankaj.dev@st.com>
Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: I1fd1869b9244a7e2f984e50519d9a8a652211f1b
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559891
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -1005,3 +1005,23 @@
 	vdd33-supply = <&scmi_vdd3v3_usb>;
 	status = "okay";
 };
+
+&usbh {
+	status = "okay";
+
+	usbh_ehci: usb@482f0000 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		/* onboard HUB */
+		hub@1 {
+			compatible = "usb424,2514";
+			reg = <1>;
+			vdd-supply = <&scmi_v3v3>;
+			vdda-supply = <&scmi_v3v3>;
+		};
+	};
+
+	usbh_ohci: usb@482e0000 {
+		status = "disabled";
+	};
+};
