From 602190f0e3f978cb1abfad821712f188f7e63fb6 Mon Sep 17 00:00:00 2001
From: Patrice Chotard <patrice.chotard@foss.st.com>
Date: Fri, 12 Jun 2026 10:00:12 +0200
Subject: [PATCH] arm64: dts: st: Set spi-max-frequency to 84MHz for
 stm32mp257f-ev1

Set spi-max-frequency to 84MHz for stm32mp257f-ev1 to take benefit of
calibration algorithm which allows to communicate with SPI flashes
above 50MHz.

Change-Id: Ia6d4df0086704543c8a98a603defc21812594333
Signed-off-by: Patrice Chotard <patrice.chotard@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/578133
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
index 19baf2c1ccbc..47aa0b43b71c 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -496,7 +496,7 @@ flash0: flash@0 {
 			reg = <0>;
 			spi-rx-bus-width = <4>;
 			spi-tx-bus-width = <4>;
-			spi-max-frequency = <50000000>;
+			spi-max-frequency = <84000000>;
 		};
 	};
 };
-- 
2.53.0

