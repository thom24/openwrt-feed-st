From c0292723fc0b74e1fc137bcdad98301cc3b113c7 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Fri, 21 Aug 2026 14:41:00 +0200
Subject: [PATCH] ARM: dts: stm32: remove stm32mp15-scmi.dtsi in
 stm32mp151c-plyaqm

As stm32mp15-scmi.dtsi has now diverged and integrate more SCMI
protocols, removes this include from stm32mp151c-plyaqm device tree and
adds nodes and properties previously contained in stm32mp15-scmi.dtsi
to get this board the same level of features.

Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: Ie809a7f5e7f429a3e9c59bcc89fa371f39460914
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/601838
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm/boot/dts/st/stm32mp151c-plyaqm.dts | 69 ++++++++++++++++++++-
 1 file changed, 68 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/st/stm32mp151c-plyaqm.dts b/arch/arm/boot/dts/st/stm32mp151c-plyaqm.dts
index 658f5f4ec212..7242f40756a7 100644
--- a/arch/arm/boot/dts/st/stm32mp151c-plyaqm.dts
+++ b/arch/arm/boot/dts/st/stm32mp151c-plyaqm.dts
@@ -5,7 +5,6 @@
 #include <arm/st/stm32mp15xc.dtsi>
 #include <arm/st/stm32mp15-pinctrl.dtsi>
 #include <arm/st/stm32mp15xxad-pinctrl.dtsi>
-#include <arm/st/stm32mp15-scmi.dtsi>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/leds/common.h>
 
@@ -34,6 +33,27 @@ firmware {
 		optee {
 			compatible = "linaro,optee-tz";
 			method = "smc";
+			interrupt-parent = <&intc>;
+			interrupts = <GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_LOW)>;
+			bootph-some-ram;
+		};
+
+		scmi: scmi {
+			compatible = "linaro,scmi-optee";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			linaro,optee-channel-id = <0>;
+			bootph-some-ram;
+
+			scmi_clk: protocol@14 {
+				reg = <0x14>;
+				#clock-cells = <1>;
+			};
+
+			scmi_reset: protocol@16 {
+				reg = <0x16>;
+				#reset-cells = <1>;
+			};
 		};
 	};
 
@@ -82,12 +102,26 @@ sound {
 		dais = <&i2s1_port>;
 	};
 
+	arm_wdt: watchdog {
+		compatible = "arm,smc-wdt";
+		arm,smc-id = <0xbc000000>;
+		timeout-sec = <32>;
+		bootph-all;
+		status = "okay";
+	};
+
 	wifi_pwrseq: wifi-pwrseq {
 		compatible = "mmc-pwrseq-simple";
 		reset-gpios = <&gpioe 12 GPIO_ACTIVE_LOW>; /* WLAN_REG_ON */
 	};
 };
 
+/delete-node/ &clk_hse;
+/delete-node/ &clk_hsi;
+/delete-node/ &clk_lse;
+/delete-node/ &clk_lsi;
+/delete-node/ &clk_csi;
+
 &adc {
 	pinctrl-names = "default";
 	pinctrl-0 = <&adc1_in10_pins_a>;
@@ -143,35 +177,64 @@ ethphy0: ethernet-phy@0 {
 };
 
 &gpioa {
+	clocks = <&scmi_clk CK_SCMI_GPIOA>;
 	gpio-line-names =
 		"", "", "", "", "", "", "", "",
 		"", "", "", "", "", "HWID_PL_N", "HWID_CP", "";
 };
 
 &gpiob {
+	clocks = <&scmi_clk CK_SCMI_GPIOB>;
 	gpio-line-names =
 		"", "", "", "", "", "", "LED_LATCH", "",
 		"", "RELAY1_EN", "", "", "", "", "", "";
 };
 
 &gpioc {
+	clocks = <&scmi_clk CK_SCMI_GPIOC>;
 	gpio-line-names =
 		"", "", "", "", "", "", "", "",
 		"", "", "", "", "", "HWID_Q7", "", "";
 };
 
+&gpiod {
+	clocks = <&scmi_clk CK_SCMI_GPIOD>;
+};
+
 &gpioe {
+	clocks = <&scmi_clk CK_SCMI_GPIOE>;
 	gpio-line-names =
 		"", "", "", "", "RELAY2_EN", "", "", "",
 		"", "", "", "", "", "", "", "";
 };
 
+&gpiof {
+	clocks = <&scmi_clk CK_SCMI_GPIOF>;
+};
+
 &gpiog {
+	clocks = <&scmi_clk CK_SCMI_GPIOG>;
 	gpio-line-names =
 		"", "", "", "", "", "", "", "SW1",
 		"", "", "", "", "", "", "", "";
 };
 
+&gpioh {
+	clocks = <&scmi_clk CK_SCMI_GPIOH>;
+};
+
+&gpioi {
+	clocks = <&scmi_clk CK_SCMI_GPIOI>;
+};
+
+&gpioj {
+	clocks = <&scmi_clk CK_SCMI_GPIOJ>;
+};
+
+&gpiok {
+	clocks = <&scmi_clk CK_SCMI_GPIOK>;
+};
+
 &gpioz {
 	clocks = <&scmi_clk CK_SCMI_GPIOZ>;
 };
@@ -375,3 +438,7 @@ bluetooth {
 		interrupt-names = "host-wakeup";
 	};
 };
+
+&usart1 {
+	clocks = <&scmi_clk CK_SCMI_USART1>;
+};
-- 
2.53.0

