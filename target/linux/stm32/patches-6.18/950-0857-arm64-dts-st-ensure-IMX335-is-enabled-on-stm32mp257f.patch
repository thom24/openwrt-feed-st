From b31564c3508b1a84fb3925209431b20cc05caa62 Mon Sep 17 00:00:00 2001
From: Alain Volmat <alain.volmat@foss.st.com>
Date: Fri, 20 Feb 2026 15:05:25 +0100
Subject: [PATCH] arm64: dts: st: ensure IMX335 is enabled on stm32mp257f-ev1

Set the GPIO enable line for the IMX335 camera via a GPIO hog
in order to ensure it is well enabled.

Signed-off-by: Alain Volmat <alain.volmat@foss.st.com>
Change-Id: Ibb46d693e69b4e94e31106200ad3ee632c5da4c7
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/539595
Domain-Review: Philippe CORNU <philippe.cornu@foss.st.com>
Tested-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Hugues FRUCHET <hugues.fruchet@st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
Reviewed-by: Philippe CORNU <philippe.cornu@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 7 +++++++
 1 file changed, 7 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -325,6 +325,13 @@
 
 &gpioi {
 	bootph-all;
+	/* Enable the IMX335 power line */
+	imx335-en-hog {
+		gpio-hog;
+		gpios = <0 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "imx335_en";
+	};
 };
 
 &gpioj {
