From 1367375c020de6f120b60a7a6200b22ca961854b Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 3 Feb 2026 09:10:16 +0100
Subject: [PATCH] arm64: dts: st: update rcc support for STM32MP25

Update RCC support to manage clocks and resets on the
STM32MP25.

Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I7fd48bbded48f5b5da14004367592b2a6484569d
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/531867
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 19 +++++--------------
 arch/arm64/boot/dts/st/stm32mp255.dtsi |  2 +-
 2 files changed, 6 insertions(+), 15 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp251.dtsi b/arch/arm64/boot/dts/st/stm32mp251.dtsi
index e5675c07a1f2..8eb883b60408 100644
--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -80,23 +80,11 @@ arm_wdt: watchdog {
 	};
 
 	clocks {
-		clk_dsi_txbyte: txbyteclk {
-			#clock-cells = <0>;
-			compatible = "fixed-clock";
-			clock-frequency = <0>;
-		};
-
 		clk_rcbsec: clk-rcbsec {
 			#clock-cells = <0>;
 			compatible = "fixed-clock";
 			clock-frequency = <64000000>;
 		};
-
-		clk_flexgen_27_fixed: clk-54000000 {
-			#clock-cells = <0>;
-			compatible = "fixed-clock";
-			clock-frequency = <54000000>;
-		};
 	};
 
 	firmware {
@@ -1965,8 +1953,11 @@ rcc: clock-controller@44200000 {
 				<&scmi_clk CK_SCMI_TIMG1>,
 				<&scmi_clk CK_SCMI_TIMG2>,
 				<&scmi_clk CK_SCMI_PLL3>,
-				<&clk_dsi_txbyte>;
-				access-controllers = <&rifsc 156>;
+				<0>,
+				<&scmi_clk CK_SCMI_HSI_KER_CK>,
+				<&scmi_clk CK_SCMI_HSE_KER_CK>,
+				<&scmi_clk CK_SCMI_MSI_KER_CK>;
+			access-controllers = <&rifsc 156>;
 		};
 
 		exti1: interrupt-controller@44220000 {
diff --git a/arch/arm64/boot/dts/st/stm32mp255.dtsi b/arch/arm64/boot/dts/st/stm32mp255.dtsi
index a82a51291e47..0dc1066959e6 100644
--- a/arch/arm64/boot/dts/st/stm32mp255.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp255.dtsi
@@ -7,7 +7,7 @@
 
 &ltdc {
 	compatible = "st,stm32mp255-ltdc";
-	clocks = <&clk_flexgen_27_fixed>, <&rcc CK_BUS_LTDC>, <&syscfg>, <&lvds>;
+	clocks = <&rcc CK_KER_LTDC>, <&rcc CK_BUS_LTDC>, <&syscfg>, <&lvds>;
 	clock-names = "lcd", "bus", "ref", "lvds";
 };
 
-- 
2.53.0

