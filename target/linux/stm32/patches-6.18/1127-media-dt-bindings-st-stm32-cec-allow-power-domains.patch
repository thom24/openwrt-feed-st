From 38eabccc5daffeae9de4b8017676e552bdaf07d8 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Tue, 16 Jun 2026 10:22:35 +0200
Subject: [PATCH] media: dt-bindings: st,stm32-cec: allow power-domains

Allow the optional power-domains property in the STM32 CEC binding
schema. This fixes DT schema validation failures when CEC nodes
provide a power domain reference on STM32MP1 OSTL device trees.

Assisted-by: GitHub-Copilot:GPT-5.3-Codex [JIRA-REST-API] [GERRIT]
Change-Id: I97922347134353c8227b9d57c25632053a46a675
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/579183
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 Documentation/devicetree/bindings/media/cec/st,stm32-cec.yaml | 3 +++
 1 file changed, 3 insertions(+)

--- a/Documentation/devicetree/bindings/media/cec/st,stm32-cec.yaml
+++ b/Documentation/devicetree/bindings/media/cec/st,stm32-cec.yaml
@@ -33,6 +33,9 @@ properties:
     minItems: 1
     maxItems: 2
 
+  power-domains:
+    maxItems: 1
+
 required:
   - compatible
   - reg
