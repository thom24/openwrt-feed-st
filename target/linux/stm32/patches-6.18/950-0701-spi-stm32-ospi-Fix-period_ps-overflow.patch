From 733643705f9c6484c348a246e8bf565d17181666 Mon Sep 17 00:00:00 2001
From: Patrice Chotard <patrice.chotard@foss.st.com>
Date: Thu, 7 May 2026 09:44:14 +0200
Subject: [PATCH] spi: stm32-ospi: Fix period_ps overflow

period_ps is computed using the following formula:

period_ps = NSEC_PER_SEC / (bus_freq / 1000)

In case bus freq < 15.259 Mhz, we got period_ps > 65535 which can't be
stored in a u16. Convert period_ps from u16 to u32 to fix this issue.

Change-Id: Ia75c1b131f91ffb49b02485b5d957bd0cabfc9d2
Signed-off-by: Patrice Chotard <patrice.chotard@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/564741
Reviewed-by: Christophe KERELLO <christophe.kerello@st.com>
Domain-Review: Christophe KERELLO <christophe.kerello@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 drivers/spi/spi-stm32-ospi.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

--- a/drivers/spi/spi-stm32-ospi.c
+++ b/drivers/spi/spi-stm32-ospi.c
@@ -554,9 +554,9 @@ static const u16 dlybos_delay_ps[STM32_D
 22336, 23968, 25568, 27168, 28768, 30400, 32000, 33600, 35232, 36832, 38432, 40032
 };
 
-static u32 stm32_ospi_find_byp_cmd(u16 period_ps)
+static u32 stm32_ospi_find_byp_cmd(u32 period_ps)
 {
-	u16 half_period_ps = period_ps / 2;
+	u32 half_period_ps = period_ps / 2;
 	u8 max = STM32_DLYBOS_DELAY_NB - 1;
 	u8 i, min = 0;
 
@@ -594,7 +594,7 @@ static void stm32_ospi_dlyb_stop(struct
 }
 
 static int stm32_ospi_dlyb_init(struct stm32_common *common, bool bypass_mode,
-				u16 period_ps)
+				u32 period_ps)
 {
 	u32 sr, val, mask;
 	int ret;
@@ -632,7 +632,7 @@ static int stm32_ospi_dlyb_set_cr(struct
 {
 	bool bypass_mode = false;
 	int ret;
-	u16 period_ps;
+	u32 period_ps;
 	u8 rx_tap, tx_tap;
 
 	period_ps = FIELD_GET(DLYBOS_BYP_CMD_MASK, dlyb_cr);
@@ -1169,7 +1169,7 @@ static int stm32_ospi_dtr_calibration(st
 	struct stm32_common *common = ospi->common;
 	void __iomem *regs_base = common->regs_base;
 	u32 prescaler, bus_freq;
-	u16 period_ps = 0;
+	u32 period_ps = 0;
 	u8 window_len = 0;
 	int ret;
 	bool bypass_mode = false;
@@ -1975,7 +1975,7 @@ static int stm32_hyperbus_calibrate(stru
 	struct stm32_common *common = hyperbus->common;
 	void __iomem *regs_base = common->regs_base;
 	u32 prescaler;
-	u16 period_ps = 0;
+	u32 period_ps = 0;
 	u8 window_len = 0;
 	int ret;
 	bool bypass_mode = false;
