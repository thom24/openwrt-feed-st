From af985ff17b74d05de17d2ff4c37b3fefcca36bef Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Fri, 17 Jan 2025 12:07:46 +0100
Subject: [PATCH] usb: dwc2: gadget: enable the gadget as wakeup source

In order to better support wakeup in peripheral mode, mark the gadget as
a wakeup source, e.g. make it capable from udc_start() to udc_stop().
Typical case is a bus powered device that needs to reduce power
consumption.

User-land application can:
- monitor bus suspend state (using inotify)
  e.g. /sys/class/udc/48300000.usb/state
- enable wakeup on the gadget driver (from the host)
  echo enabled > /sys/.../48300000.usb/gadget.0/power/wakeup
- request a platform suspend, upon bus suspend request from host.
  echo mem > /sys/power/state
- upon low power exit, disable the wakeup

There may be some race between bus fast suspend/resume request,
and the platform suspend/resume sequence. So the suspend code
need to take care of it, e.g. return -EBUSY.

In dwc2_hsotg_suspend in case:
- a remote wakeup allowed device is connected,
- user instructed to enable wakeup capability,
is suitable to keep the USB link enabled, even when going to low power,
so it can resume the bus, and wakeup the HOST, or be waken up by the host.
When the HOST has suspended the bus (lx_state != DWC2_L0), replace
the DWC2_L0 check, by a check on the controller power saving flags, to
ensure the HW is in the proper mode to later resume.

Signed-off-by: Pankaj Dev <pankaj.dev@st.com>
Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: Ied80fefb44ea4bd866da9f05b9361c19550966f8
---
 drivers/usb/dwc2/gadget.c   | 25 ++++++++++++++++++++++++-
 drivers/usb/dwc2/platform.c |  4 +++-
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
index e8db3f916de9..aa69476ebcc2 100644
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -4702,6 +4702,8 @@ static int dwc2_hsotg_udc_start(struct usb_gadget *gadget,
 	gadget->sg_supported = using_desc_dma(hsotg);
 	dev_info(hsotg->dev, "bound driver %s\n", driver->driver.name);
 
+	device_set_wakeup_capable(&gadget->dev, true);
+
 	return 0;
 
 err:
@@ -4724,6 +4726,8 @@ static int dwc2_hsotg_udc_stop(struct usb_gadget *gadget)
 	if (!hsotg)
 		return -ENODEV;
 
+	device_set_wakeup_capable(&gadget->dev, false);
+
 	/* Exit clock gating when driver is stopped. */
 	if (hsotg->params.power_down == DWC2_POWER_DOWN_PARAM_NONE &&
 	    hsotg->bus_suspended && !hsotg->params.no_clock_gating) {
@@ -5246,7 +5250,13 @@ int dwc2_hsotg_suspend(struct dwc2_hsotg *hsotg)
 {
 	unsigned long flags;
 
-	if (hsotg->lx_state != DWC2_L0) {
+	if ((hsotg->remote_wakeup_allowed || device_may_wakeup(&hsotg->gadget.dev)) &&
+	    (hsotg->bus_suspended || hsotg->in_ppd || hsotg->hibernated)) {
+		/*
+		 * The bus has been suspended by the HOST, and the remote
+		 * wakeup has been enabled. So don't suspend gadget or it
+		 * will disconnect.
+		 */
 		hsotg->gadget_off_for_suspend = false;
 		return 0;
 	}
@@ -5254,6 +5264,19 @@ int dwc2_hsotg_suspend(struct dwc2_hsotg *hsotg)
 	if (hsotg->driver) {
 		int ep;
 
+		/*
+		 * Bus isn't suspended, and the user has requested to be able
+		 * to wakeup from the gadget driver. So need to refuse to suspend
+		 * or the gadget will disconnect. A typical case is a self-powered
+		 * device, that needs to go to low power, upon suspend. But a fast
+		 * bus suspend/resume may have triggered the platform suspend sequence,
+		 * by the user application (to fulfill suspend current requirement).
+		 * We reach here, with a resumed bus: so need to refuse to suspend.
+		 * This may be hit with USBCV enumeration test.
+		 */
+		if (hsotg->remote_wakeup_allowed || device_may_wakeup(&hsotg->gadget.dev))
+			return -EBUSY;
+
 		dev_info(hsotg->dev, "suspending usb gadget %s\n",
 			 hsotg->driver->driver.name);
 
diff --git a/drivers/usb/dwc2/platform.c b/drivers/usb/dwc2/platform.c
index 0afc22b06ecf..278cc1b41478 100644
--- a/drivers/usb/dwc2/platform.c
+++ b/drivers/usb/dwc2/platform.c
@@ -964,7 +964,9 @@ static int __maybe_unused dwc2_suspend(struct device *dev)
 		    dwc2->bus_suspended && !dwc2->params.no_clock_gating)
 			dwc2_gadget_exit_clock_gating(dwc2, 0);
 
-		dwc2_hsotg_suspend(dwc2);
+		ret = dwc2_hsotg_suspend(dwc2);
+		if (ret)
+			return ret;
 	}
 
 	dwc2_drd_suspend(dwc2);
-- 
2.53.0

