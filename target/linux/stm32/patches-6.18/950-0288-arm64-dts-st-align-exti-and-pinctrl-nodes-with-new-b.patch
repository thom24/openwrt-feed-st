From 2924b4dbafa43d23725ca658be140b5b27f27b19 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Mon, 29 Sep 2025 15:06:59 +0200
Subject: [PATCH] arm64: dts: st: align exti and pinctrl nodes with new
 bindings to stm32mp211

Remove the property "st,syscfg" from pinctrl and the compatible
"syscon" from EXTI.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp211.dtsi b/arch/arm64/boot/dts/st/stm32mp211.dtsi
index c64195fef020..c7901b4fd21a 100644
--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -303,7 +303,7 @@ rcc: clock-controller@44200000 {
 		};
 
 		exti1: interrupt-controller@44220000 {
-			compatible = "st,stm32mp1-exti", "syscon";
+			compatible = "st,stm32mp1-exti";
 			reg = <0x44220000 0x0 0x400>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
@@ -402,7 +402,6 @@ pinctrl: pinctrl@44240000 {
 			#address-cells = <1>;
 			#size-cells = <1>;
 			interrupt-parent = <&exti1>;
-			st,syscfg = <&exti1 0x60 0xff>;
 			interrupts-extended =
 				<&exti1  0 0>, <&exti1  1 0>, <&exti1  2 0>, <&exti1  3 0>,
 				<&exti1  4 0>, <&exti1  5 0>, <&exti1  6 0>, <&exti1  7 0>,
@@ -514,7 +513,7 @@ gpioi: gpio@442c0000 {
 		};
 
 		exti2: interrupt-controller@442d0000 {
-			compatible = "st,stm32mp1-exti", "syscon";
+			compatible = "st,stm32mp1-exti";
 			reg = <0x442d0000 0x0 0x400>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
@@ -581,7 +580,6 @@ pinctrl_z: pinctrl@46200000 {
 			#address-cells = <1>;
 			#size-cells = <1>;
 			interrupt-parent = <&exti1>;
-			st,syscfg = <&exti1 0x60 0xff>;
 			interrupts-extended =
 				<&exti1  0 0>, <&exti1  1 0>, <&exti1  2 0>, <&exti1  3 0>,
 				<&exti1  4 0>, <&exti1  5 0>, <&exti1  6 0>, <&exti1  7 0>,
-- 
2.53.0

