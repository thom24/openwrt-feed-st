From 559983dc429b42b9c94fb1bb5d92a5783bf09ae0 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Wed, 4 Feb 2026 13:58:48 +0100
Subject: [PATCH] arm64: dts: st: enable the debug bus on stm32mp2x boards

On stm32mp2x boards, enable the debug bus so we always try to probe
the debug peripherals, if the debug configuration allows it.

Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: I56b1c458a89d5c6f28e0e33efd90196d046de27d
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/473656
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/532356
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp235f-dk.dts  | 4 ++++
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts  | 4 ++++
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 4 ++++
 3 files changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
index 85a80f9be89c..5d62d39e420b 100644
--- a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
@@ -82,6 +82,10 @@ &bsec {
 	bootph-all;
 };
 
+&dbg_bus {
+	status = "okay";
+};
+
 &ethernet1 {
 	pinctrl-0 = <&eth1_rgmii_pins_b>;
 	pinctrl-1 = <&eth1_rgmii_sleep_pins_b>;
diff --git a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
index e07749d107e8..08aea34c97a3 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -82,6 +82,10 @@ &bsec {
 	bootph-all;
 };
 
+&dbg_bus {
+	status = "okay";
+};
+
 &ethernet1 {
 	pinctrl-0 = <&eth1_rgmii_pins_b>;
 	pinctrl-1 = <&eth1_rgmii_sleep_pins_b>;
diff --git a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
index 08fcd93b0654..9a55974ca782 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -176,6 +176,10 @@ csi_source: endpoint {
 	};
 };
 
+&dbg_bus {
+	status = "okay";
+};
+
 &dcmipp {
 	status = "okay";
 	port {
-- 
2.53.0

