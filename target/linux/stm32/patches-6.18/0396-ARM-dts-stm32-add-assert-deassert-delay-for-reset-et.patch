From b45946ef8ca159d7e2ee58e5d7b51e17551f7232 Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Fri, 30 Jan 2026 10:01:38 +0100
Subject: [PATCH] ARM: dts: stm32: add assert/deassert delay for reset ethernet
 on stm32mp135f-dk

To be compliant with SMSC datasheet,
add delay assert/deassert for reset PHY

Change-Id: If57e4347244de6d2055781bbaf8345459a744d8a
Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/404475
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/535365
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm/boot/dts/st/stm32mp135f-dk.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm/boot/dts/st/stm32mp135f-dk.dts b/arch/arm/boot/dts/st/stm32mp135f-dk.dts
index 620ef54f6715..ec19a258335b 100644
--- a/arch/arm/boot/dts/st/stm32mp135f-dk.dts
+++ b/arch/arm/boot/dts/st/stm32mp135f-dk.dts
@@ -245,6 +245,8 @@ phy0_eth1: ethernet-phy@0 {
 			compatible = "ethernet-phy-id0007.c131";
 			reg = <0>;
 			reset-gpios = <&mcp23017 9 GPIO_ACTIVE_LOW>;
+			reset-assert-us = <1000>;
+			reset-deassert-us = <30000>;
 			wakeup-source;
 		};
 	};
@@ -269,6 +271,8 @@ phy0_eth2: ethernet-phy@0 {
 			compatible = "ethernet-phy-id0007.c131";
 			reg = <0>;
 			reset-gpios = <&mcp23017 10 GPIO_ACTIVE_LOW>;
+			reset-assert-us = <1000>;
+			reset-deassert-us = <30000>;
 		};
 	};
 };
-- 
2.53.0

