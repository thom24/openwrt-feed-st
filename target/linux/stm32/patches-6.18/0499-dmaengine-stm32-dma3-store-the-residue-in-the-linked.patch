From 6841c0e1c147cfafe55c71589681b5222764debe Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Mon, 19 Apr 2021 18:38:30 +0200
Subject: [PATCH] dmaengine: stm32-dma3: store the residue in the linked-list
 item structure

Store the cumulative remaining byte count in each linked-list item when
building the descriptor chain. This allows residue reporting to use the
precomputed value directly instead of summing CBR1.BNDT value over all
pending hardware descriptors (hwdesc).
Also, make the residue parameter optional if the purpose of calling
stm32_dma3_chan_get_curr_hwdesc() is indeed to get current linked-list
item index.

Change-Id: I097de84f5284175aa46501356357410b31ddc096
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/580842
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 drivers/dma/stm32/stm32-dma3.c | 24 +++++++++++++++++++-----
 1 file changed, 19 insertions(+), 5 deletions(-)

diff --git a/drivers/dma/stm32/stm32-dma3.c b/drivers/dma/stm32/stm32-dma3.c
index b128e2291829..fa703294e0d8 100644
--- a/drivers/dma/stm32/stm32-dma3.c
+++ b/drivers/dma/stm32/stm32-dma3.c
@@ -274,6 +274,7 @@ struct stm32_dma3_hwdesc {
 struct stm32_dma3_lli {
 	struct stm32_dma3_hwdesc *hwdesc;
 	dma_addr_t hwdesc_addr;
+	size_t residue; /* Remaining transfer size starting at this LLI */
 };
 
 struct stm32_dma3_swdesc {
@@ -1182,10 +1183,12 @@ static int stm32_dma3_chan_get_curr_hwdesc(struct stm32_dma3_swdesc *swdesc, u32
 
 	/* As transfer is in progress, look backward from the last item */
 	for (i = swdesc->lli_size - 1; i > 0; i--) {
-		*residue += FIELD_GET(CBR1_BNDT, swdesc->lli[i].hwdesc->cbr1);
 		lli_offset = swdesc->lli[i].hwdesc_addr & CLLR_LA;
-		if (lli_offset == next_lli_offset)
+		if (lli_offset == next_lli_offset) {
+			if (residue) /* residue is requested */
+				*residue += swdesc->lli[i].residue;
 			return i - 1;
+		}
 	}
 
 	return -EINVAL;
@@ -1562,7 +1565,7 @@ static struct dma_async_tx_descriptor *stm32_dma3_prep_dma_memcpy(struct dma_cha
 {
 	struct stm32_dma3_chan *chan = to_stm32_dma3_chan(c);
 	struct stm32_dma3_swdesc *swdesc;
-	size_t next_size, offset;
+	size_t global_remaining = len, next_size, offset;
 	u32 count, i, ctr1, ctr2;
 	bool prevent_refactor = !!FIELD_GET(STM32_DMA3_DT_NOPACK, chan->dt_config.tr_conf) ||
 				!!FIELD_GET(STM32_DMA3_DT_NOREFACT, chan->dt_config.tr_conf);
@@ -1598,6 +1601,9 @@ static struct dma_async_tx_descriptor *stm32_dma3_prep_dma_memcpy(struct dma_cha
 
 		stm32_dma3_chan_prep_hwdesc(chan, swdesc, i, src + offset, dst + offset, next_size,
 					    ctr1, ctr2, next_size == remaining, false);
+
+		swdesc->lli[i].residue = global_remaining;
+		global_remaining -= next_size;
 	}
 
 	/* Enable Errors interrupts */
@@ -1624,7 +1630,7 @@ static struct dma_async_tx_descriptor *stm32_dma3_prep_slave_sg(struct dma_chan
 	struct stm32_dma3_chan *chan = to_stm32_dma3_chan(c);
 	struct stm32_dma3_swdesc *swdesc;
 	struct scatterlist *sg;
-	size_t len;
+	size_t remaining = 0, len;
 	dma_addr_t sg_addr, dev_addr, src, dst;
 	u32 i, j, count, ctr1, ctr2;
 	bool prevent_refactor = !!FIELD_GET(STM32_DMA3_DT_NOPACK, chan->dt_config.tr_conf) ||
@@ -1636,8 +1642,10 @@ static struct dma_async_tx_descriptor *stm32_dma3_prep_slave_sg(struct dma_chan
 		return NULL;
 
 	count = 0;
-	for_each_sg(sgl, sg, sg_len, i)
+	for_each_sg(sgl, sg, sg_len, i) {
 		count += stm32_dma3_get_ll_count(chan, sg_dma_len(sg), prevent_refactor);
+		remaining += sg_dma_len(sg);
+	}
 
 	swdesc = stm32_dma3_chan_desc_alloc(chan, count);
 	if (!swdesc)
@@ -1684,6 +1692,8 @@ static struct dma_async_tx_descriptor *stm32_dma3_prep_slave_sg(struct dma_chan
 			stm32_dma3_chan_prep_hwdesc(chan, swdesc, j, src, dst, chunk,
 						    ctr1, ctr2, j == (count - 1), false);
 
+			swdesc->lli[j].residue = remaining;
+			remaining -= chunk;
 			sg_addr += chunk;
 			len -= chunk;
 			j++;
@@ -1717,6 +1727,7 @@ static struct dma_async_tx_descriptor *stm32_dma3_prep_dma_cyclic(struct dma_cha
 {
 	struct stm32_dma3_chan *chan = to_stm32_dma3_chan(c);
 	struct stm32_dma3_swdesc *swdesc;
+	size_t remaining = buf_len;
 	dma_addr_t src, dst;
 	u32 count, i, ctr1, ctr2;
 	int ret;
@@ -1771,6 +1782,9 @@ static struct dma_async_tx_descriptor *stm32_dma3_prep_dma_cyclic(struct dma_cha
 
 		stm32_dma3_chan_prep_hwdesc(chan, swdesc, i, src, dst, period_len,
 					    ctr1, ctr2, i == (count - 1), true);
+
+		swdesc->lli[i].residue = remaining;
+		remaining -= period_len;
 	}
 
 	/* Enable Error interrupts */
-- 
2.53.0

