From 150ed94322b1054af68e0321208bcfa410b63b9a Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Fri, 22 May 2026 18:16:34 +0200
Subject: [PATCH] arm64: dts: st: add ddrperfm on stm32mp251 (FIX)

Fix ddrperfm on stm32mp251 using dbg_bus access controller.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I9dab8c99e6d8abd5dec145df00d192656709640f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/571221
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -3089,7 +3089,7 @@
 		ddrperfm: perf@48041000 {
 			compatible = "st,stm32mp251-ddr-pmu";
 			reg = <0x48041000 0x400>;
-			access-controllers = <&rcc 104>;
+			access-controllers = <&dbg_bus 2>;
 			status = "disabled";
 		};
 
