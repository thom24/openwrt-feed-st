From 26b565a9fe11faaebbf6a950a2cad7ec7004a6e2 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Fri, 3 Apr 2026 10:56:47 +0200
Subject: [PATCH] arm64: configs: Enable panel lvds & simple in
 fragment-02-defconfig-addons.config

Enable CONFIG_DRM_PANEL_LVDS & CONFIG_DRM_PANEL_SIMPLE in
fragment-02-defconfig-addons.config.

Change-Id: I7c6334e4fbf224762ab3aa281d1673f4ddef8c5b
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/553887
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/configs/fragment-02-defconfig-addons.config | 2 ++
 1 file changed, 2 insertions(+)

--- a/arch/arm64/configs/fragment-02-defconfig-addons.config
+++ b/arch/arm64/configs/fragment-02-defconfig-addons.config
@@ -11,7 +11,9 @@ CONFIG_CRYPTO_DEV_STM32_CRYP=m
 CONFIG_CRYPTO_DEV_STM32_HASH=m
 CONFIG_DEVFREQ_GOV_USERSPACE=m
 CONFIG_DRM=y
+CONFIG_DRM_PANEL_LVDS=m
 CONFIG_DRM_PANEL_RAYDIUM_RM68200=m
+CONFIG_DRM_PANEL_SIMPLE=m
 CONFIG_DRM_SIMPLEDRM=y
 CONFIG_DRM_STM=m
 CONFIG_DRM_STM_DSI=m
