From d4bcbb9ce7341e28e216322475e718ce535af5c1 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Mon, 20 Apr 2026 09:59:31 +0200
Subject: [PATCH] arm64: dts: st: add DSI TxByteClk to RCC parent clocks for
 STM32MP235

Compared to STM32MP231, STM32MP235 has one additional RCC parent clock:
the DSI TxByteClk.

Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I462485b7895c0df23d7d76e27cf6d2987da7a168
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559059
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp235.dtsi | 87 ++++++++++++++++++++++++++
 1 file changed, 87 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp235.dtsi b/arch/arm64/boot/dts/st/stm32mp235.dtsi
index 32af61b0d23a..c7a60c5eb955 100644
--- a/arch/arm64/boot/dts/st/stm32mp235.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp235.dtsi
@@ -11,6 +11,93 @@ &ltdc {
 	clock-names = "lcd", "bus", "ref", "lvds";
 };
 
+&rcc {
