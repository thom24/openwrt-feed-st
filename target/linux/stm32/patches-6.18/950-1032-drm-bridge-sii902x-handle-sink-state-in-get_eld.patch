From 890cf8d170f12c223b43ff1aa6540b7fc5f37388 Mon Sep 17 00:00:00 2001
From: Olivier Moysan <olivier.moysan@foss.st.com>
Date: Thu, 3 Sep 2026 11:29:19 +0200
Subject: [PATCH] drm/bridge: sii902x: handle sink state in get_eld

Check the DRM connector status to determine whether an HDMI sink is
connected before returning its ELD. Return -EOPNOTSUPP for a
disconnected sink so the HDMI codec can reject playback without
triggering repeated ASoC error messages.

When a sink is connected but the ELD has not been populated yet, read
the EDID from get_eld() under the mode configuration lock and update the
connector. This covers audio startup before the display subsystem has
probed the connector and avoids spurious "HDMI: Unknown ELD version 0"
messages.

Signed-off-by: Olivier Moysan <olivier.moysan@foss.st.com>
Assisted-by: GitHub-Copilot:Claude:4.8-opus
Change-Id: Ib90c0082ef3172a9e6cdc0d61f9cc788751262f8
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/605877
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
---
 drivers/gpu/drm/bridge/sii902x.c | 34 ++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

--- a/drivers/gpu/drm/bridge/sii902x.c
+++ b/drivers/gpu/drm/bridge/sii902x.c
@@ -804,6 +804,40 @@ static int sii902x_audio_get_eld(struct
 				 uint8_t *buf, size_t len)
 {
 	struct sii902x *sii902x = dev_get_drvdata(dev);
+	enum drm_connector_status status = sii902x->connector.status;
+
+	if (status == connector_status_unknown)
+		status = sii902x_detect(sii902x);
+
+	if (status == connector_status_disconnected)
+		return -ENODEV;
+
+	/*
+	 * If the bridge is attached but the ELD is still empty (EDID not yet
+	 * read by the display subsystem), read it now.
+	 *
+	 * An EDID read failure returns NULL, so get_eld() may succeed with an
+	 * empty ELD. The HDMI codec accepts an empty ELD and uses default audio
+	 * constraints, allowing the audio sink to open.
+	 *
+	 * ELD byte 0 holds the version field meaning the ELD has not been populated yet.
+	 *
+	 * Serialise against the display probe path (sii902x_get_modes) by
+	 * taking mode_config.mutex.
+	 */
+	if (sii902x->connector.dev) {
+		mutex_lock(&sii902x->connector.dev->mode_config.mutex);
+		if (sii902x->connector.eld[0] == 0) {
+			const struct drm_edid *drm_edid;
+
+			drm_edid = sii902x_edid_read(sii902x, &sii902x->connector);
+			if (drm_edid) {
+				drm_edid_connector_update(&sii902x->connector, drm_edid);
+				drm_edid_free(drm_edid);
+			}
+		}
+		mutex_unlock(&sii902x->connector.dev->mode_config.mutex);
+	}
 
 	mutex_lock(&sii902x->mutex);
 
