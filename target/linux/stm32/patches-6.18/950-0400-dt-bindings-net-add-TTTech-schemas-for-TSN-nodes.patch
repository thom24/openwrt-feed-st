From ad3591204183aede66a8b32edc9113c2a2e7985d Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Tue, 16 Jun 2026 12:09:05 +0200
Subject: [PATCH] dt-bindings: net: add TTTech schemas for TSN nodes

Add TTTech DT schema entries for compatibles used in STM32MP257
TSN switch hierarchy:
- st,stm32-deip
- ttt,deip-sw
- ttt,acm-4.0

Assisted-by: GitHub-Copilot:GPT-5.3-Codex
Change-Id: Ie207698736bcbf4d11ed4d324779e665dcdb61d2
Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/579226
---
 .../bindings/net/st,stm32-deip.yaml           | 58 +++++++++++++++++
 .../devicetree/bindings/net/ttt,acm-4.0.yaml  | 63 +++++++++++++++++++
 .../devicetree/bindings/net/ttt,deip-sw.yaml  | 56 +++++++++++++++++
 MAINTAINERS                                   |  7 +++
 4 files changed, 184 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/st,stm32-deip.yaml
 create mode 100644 Documentation/devicetree/bindings/net/ttt,acm-4.0.yaml
 create mode 100644 Documentation/devicetree/bindings/net/ttt,deip-sw.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/net/st,stm32-deip.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/st,stm32-deip.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STMicroelectronics STM32 DEIP TSN switch wrapper
+
+maintainers:
+  - Christophe Roullier <christophe.roullier@foss.st.com>
+
+description: |
+  This file documents platform glue layer for the STM32MP25 TSN switch wrapper node used with
+  external TTTech modules.
+
+select:
+  properties:
+    compatible:
+      contains:
+        const: st,stm32-deip
+  required:
+    - compatible
+
+properties:
+  compatible:
+    const: st,stm32-deip
+
+additionalProperties: true
+
+examples:
+  - |
+    / {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        rcc: clock-controller {
+            #clock-cells = <1>;
+        };
+
+        syscfg: syscon@44230000 {
+            compatible = "syscon";
+            reg = <0x44230000 0x1000>;
+        };
+
+        ttt_sw@4c000000 {
+            #address-cells = <1>;
+            #size-cells = <1>;
+            compatible = "st,stm32-deip";
+            clock-names = "ethsw-bus-clk", "ethsw-clk", "ethsw-ref-clk",
+                          "ethswacmcfg-bus-clk", "ethswacmmsg-bus-clk";
+            clocks = <&rcc 97>, <&rcc 322>, <&rcc 323>, <&rcc 341>, <&rcc 342>;
+            st,syscon = <&syscfg 0x3800>;
+            ranges = <0x4c000000 0x4c000000 0x2000000>,
+                     <0x4b000000 0x4b000000 0xc0000>;
+        };
+    };
+
+...
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/ttt,acm-4.0.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/ttt,acm-4.0.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: TTTech ACM (ACceleration Module)
+
+maintainers:
+  - Christophe Roullier <christophe.roullier@foss.st.com>
+
+description: |
+  This file documents schema for TTTech ACM node referenced by STM32MP25
+  device trees.
+
+select:
+  properties:
+    compatible:
+      contains:
+        const: ttt,acm-4.0
+  required:
+    - compatible
+
+properties:
+  compatible:
+    const: ttt,acm-4.0
+
+additionalProperties: true
+
+examples:
+  - |
+    / {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        ttt_sw@4c000000 {
+            #address-cells = <1>;
+            #size-cells = <1>;
+            compatible = "st,stm32-deip";
+            ranges = <0x4b000000 0x4b000000 0xc0000>;
+            status = "disabled";
+
+            deip_sw0: deip-sw {
+                compatible = "ttt,deip-sw";
+            };
+
+            acm@4b000000 {
+                compatible = "ttt,acm-4.0";
+                reg = <0x4b000000 0x00400>,
+                      <0x4b010000 0x10000>,
+                      <0x4b030000 0x10000>,
+                      <0x4b050000 0x10000>,
+                      <0x4b060000 0x20000>,
+                      <0x4b080000 0x40000>;
+                reg-names = "CommonRegister", "Bypass1", "Bypass0", "Redundancy",
+                            "Scheduler", "Messagebuffer";
+                buffers = <32>;
+                ptp_worker = <&deip_sw0>;
+            };
+        };
+    };
+
+...
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/ttt,deip-sw.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/ttt,deip-sw.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: TTTech DEIP switch node
+
+maintainers:
+  - Christophe Roullier <christophe.roullier@foss.st.com>
+
+description: |
+  This file documents schema for TTTech DEIP switch node referenced by STM32MP25
+  device trees.
+
+select:
+  properties:
+    compatible:
+      contains:
+        const: ttt,deip-sw
+  required:
+    - compatible
+
+properties:
+  compatible:
+    const: ttt,deip-sw
+
+additionalProperties: true
+
+examples:
+  - |
+    / {
+    #address-cells = <1>;
+    #size-cells = <1>;
+
+      intc: interrupt-controller {
+         interrupt-controller;
+         #interrupt-cells = <3>;
+      };
+
+      ttt_sw@4c000000 {
+         #address-cells = <1>;
+         #size-cells = <1>;
+         compatible = "st,stm32-deip";
+         ranges = <0x4c000000 0x4c000000 0x2000000>;
+
+         deip_sw0: deip-sw@4c000000 {
+           compatible = "ttt,deip-sw";
+           reg = <0x4c000000 0x2000000>;
+           interrupt-parent = <&intc>;
+           interrupts = <0 250 4>;
+         };
+      };
+    };
+
+...
