From 0cd25c57292fe5e295a0b15cf5a6314c466b7873 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Thu, 23 Jan 2025 10:51:04 +0100
Subject: [PATCH] mailbox: stm32-ippc: don't suspend the IPI IRQ during standby

The SCMI resources are based on IPCC mailbox and are used during
suspend/resume phase so the associated IRQ are required.

Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I540bb7b51bf1ee0f757f2bb2b1c30efcea2f56c1
---
 drivers/mailbox/stm32-ipcc.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/mailbox/stm32-ipcc.c b/drivers/mailbox/stm32-ipcc.c
index ef9e04f08619..d23c2a22b6e6 100644
--- a/drivers/mailbox/stm32-ipcc.c
+++ b/drivers/mailbox/stm32-ipcc.c
@@ -375,7 +375,8 @@ static int stm32_ipcc_probe(struct platform_device *pdev)
 		}
 
 		ret = devm_request_threaded_irq(dev, ipcc->irqs[i], NULL,
-						irq_thread[i], IRQF_ONESHOT,
+						irq_thread[i],
+						IRQF_ONESHOT | IRQF_NO_SUSPEND,
 						dev_name(dev), ipcc);
 		if (ret) {
 			dev_err(dev, "failed to request irq %lu (%d)\n", i, ret);
@@ -499,6 +500,9 @@ static int stm32_ipcc_suspend(struct device *dev)
 	ipcc->xmr = readl_relaxed(ipcc->reg_proc + IPCC_XMR);
 	ipcc->xcr = readl_relaxed(ipcc->reg_proc + IPCC_XCR);
 
+	if (device_may_wakeup(dev))
+		return enable_irq_wake(ipcc->irqs[IPCC_IRQ_RX]);
+
 	return 0;
 }
 
@@ -509,6 +513,9 @@ static int stm32_ipcc_resume(struct device *dev)
 	writel_relaxed(ipcc->xmr, ipcc->reg_proc + IPCC_XMR);
 	writel_relaxed(ipcc->xcr, ipcc->reg_proc + IPCC_XCR);
 
+	if (device_may_wakeup(dev))
+		return disable_irq_wake(ipcc->irqs[IPCC_IRQ_RX]);
+
 	return 0;
 }
 #endif
