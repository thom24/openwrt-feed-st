From 2e4f749d7ec4614aee53a112f345e7b0464033f1 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Fri, 19 Jun 2026 15:38:23 +0200
Subject: [PATCH] arm64: defconfig: enable the userspace devfreq governor

Enable the devfreq governor "userspace" (CONFIG_DEVFREQ_GOV_USERSPACE)
used by GPU device on STM32MP2 platform.

Change-Id: I9a56d3f9f7b78d3669d17607df5b719ef7502a0b
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/580561
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Philippe CORNU <philippe.cornu@foss.st.com>
---
 arch/arm64/configs/fragment-02-defconfig-addons.config | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/fragment-02-defconfig-addons.config b/arch/arm64/configs/fragment-02-defconfig-addons.config
index 08ca801164b1..c6b82b113558 100644
--- a/arch/arm64/configs/fragment-02-defconfig-addons.config
+++ b/arch/arm64/configs/fragment-02-defconfig-addons.config
@@ -6,6 +6,7 @@ CONFIG_CLK_STM32MP2_CA35SS=m
 CONFIG_CORESIGHT_SOURCE_ETM4X=m
 CONFIG_CPUFREQ_DT=m
 CONFIG_CPU_IDLE_GOV_TEO=y
+CONFIG_DEVFREQ_GOV_USERSPACE=m
 CONFIG_DRM=y
 CONFIG_DRM_PANEL_RAYDIUM_RM68200=m
 CONFIG_DRM_SIMPLEDRM=y
-- 
2.53.0

