From 2ff800bf04d80242d5f553a3569ed59ba7dbec0b Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Wed, 21 Oct 2026 09:43:15 +0200
Subject: [PATCH] ARM: dts: stm32: disable IWDG1 on STM32MP15 boards

Disable the iwdg1 watchdog since it is managed through arm,smc_wdt because
it is secure.

Change-Id: I36b221919e55dbd4ef605147f0022cf39703651d
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/575612
Reviewed-by: Antonio Maria BORNEO <antonio.borneo@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
---
 arch/arm/boot/dts/st/stm32mp157a-dk1.dts | 5 +++++
 arch/arm/boot/dts/st/stm32mp157c-dk2.dts | 5 +++++
 arch/arm/boot/dts/st/stm32mp157c-ed1.dts | 5 +++++
 arch/arm/boot/dts/st/stm32mp157c-ev1.dts | 5 +++++
 arch/arm/boot/dts/st/stm32mp157d-dk1.dts | 5 +++++
 arch/arm/boot/dts/st/stm32mp157f-dk2.dts | 5 +++++
 6 files changed, 30 insertions(+)

diff --git a/arch/arm/boot/dts/st/stm32mp157a-dk1.dts b/arch/arm/boot/dts/st/stm32mp157a-dk1.dts
index c3f18f9b5bdb..03dc11d5feca 100644
--- a/arch/arm/boot/dts/st/stm32mp157a-dk1.dts
+++ b/arch/arm/boot/dts/st/stm32mp157a-dk1.dts
@@ -47,6 +47,11 @@ &i2c4 {
 	resets = <&scmi_reset RST_SCMI_I2C4>;
 };
 
+&iwdg1 {
+	/* IWDG1 is secure and managed through arm_wdt */
+	status = "disabled";
+};
+
 &iwdg2 {
 	clocks = <&rcc IWDG2>, <&scmi_clk CK_SCMI_LSI>;
 };
