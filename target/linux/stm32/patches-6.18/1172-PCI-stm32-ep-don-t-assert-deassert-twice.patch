From e09b6645d74e0a9105eefe4cab174b6b1aeff7a0 Mon Sep 17 00:00:00 2001
From: Christian Bruel <christian.bruel@foss.st.com>
Date: Mon, 11 May 2026 13:48:01 +0200
Subject: [PATCH] PCI: stm32-ep: don't assert/deassert twice

Avoid consecutive calls to stm32_pcie_perst_deassert() without a
matching assert, as this may reset the PCIe registers.

A level-triggered PERST# IRQ may fire twice despite the IRQF_ONESHOT
flag. As a pinctrl gpio workaround, guard against duplicate assert/deassert
sequences.

Change-Id: I97f227f5cf8565dddfcadf00f49de04498a47dea
Signed-off-by: Christian Bruel <christian.bruel@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/588293
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 drivers/pci/controller/dwc/pcie-stm32-ep.c | 29 ++++++++++++++++------
 1 file changed, 22 insertions(+), 7 deletions(-)

--- a/drivers/pci/controller/dwc/pcie-stm32-ep.c
+++ b/drivers/pci/controller/dwc/pcie-stm32-ep.c
@@ -26,6 +26,7 @@ struct stm32_pcie {
 	struct clk *clk;
 	struct gpio_desc *perst_gpio;
 	unsigned int perst_irq;
+	int last_perst;
 };
 
 static void stm32_pcie_ep_init(struct dw_pcie_ep *ep)
@@ -182,16 +183,29 @@ static irqreturn_t stm32_pcie_ep_perst_i
 {
 	struct stm32_pcie *stm32_pcie = data;
 	struct dw_pcie *pci = &stm32_pcie->pci;
-	u32 perst;
+	int perst;
 
 	perst = gpiod_get_value(stm32_pcie->perst_gpio);
-	if (perst)
-		stm32_pcie_perst_assert(pci);
-	else
-		stm32_pcie_perst_deassert(pci);
+	if (perst < 0) {
+		dev_err(pci->dev, "Failed read PERST gpio: %d\n", perst);
+		return IRQ_NONE;
+	}
 
-	irq_set_irq_type(gpiod_to_irq(stm32_pcie->perst_gpio),
-			 (perst ? IRQF_TRIGGER_HIGH : IRQF_TRIGGER_LOW));
+	if (perst != stm32_pcie->last_perst) {
+		if (perst)
+			stm32_pcie_perst_assert(pci);
+		else
+			stm32_pcie_perst_deassert(pci);
+
+		irq_set_irq_type(gpiod_to_irq(stm32_pcie->perst_gpio),
+				 (perst ? IRQF_TRIGGER_HIGH : IRQF_TRIGGER_LOW));
+
+		stm32_pcie->last_perst = perst;
+	} else if (perst) {
+		dev_dbg(pci->dev, "PERST already asserted !\n");
+	} else {
+		dev_dbg(pci->dev, "PERST already de-asserted !\n");
+	}
 
 	return IRQ_HANDLED;
 }
@@ -285,6 +299,7 @@ static int stm32_pcie_probe(struct platf
 	}
 
 	stm32_pcie->perst_irq = gpiod_to_irq(stm32_pcie->perst_gpio);
+	stm32_pcie->last_perst = -EINVAL;
 
 	/* Will be enabled in start_link when device is initialized. */
 	irq_set_status_flags(stm32_pcie->perst_irq, IRQ_NOAUTOEN);
