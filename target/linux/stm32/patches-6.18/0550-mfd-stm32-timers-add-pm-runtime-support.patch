From 383c89b2d012b1cb3813c1415d213843835de1a6 Mon Sep 17 00:00:00 2001
From: Olivier Moysan <olivier.moysan@foss.st.com>
Date: Tue, 27 Jan 2026 09:36:24 +0100
Subject: [PATCH] mfd: stm32-timers: add pm runtime support

Add pm runtime support to timers MFD driver.

Change-Id: I29363a2ba5d5527487fe1cf97fb3cb909f757869
Signed-off-by: Olivier Moysan <olivier.moysan@foss.st.com>
---
 drivers/mfd/stm32-timers.c | 5 +++++
 1 file changed, 5 insertions(+)

--- a/drivers/mfd/stm32-timers.c
+++ b/drivers/mfd/stm32-timers.c
@@ -10,6 +10,7 @@
 #include <linux/module.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
 #include <linux/property.h>
 #include <linux/reset.h>
 
@@ -320,6 +321,10 @@ static int stm32_timers_probe(struct pla
 	if (ret)
 		return ret;
 
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
 	ret = stm32_timers_dma_probe(dev, ddata);
 	if (ret) {
 		stm32_timers_dma_remove(dev, ddata);
