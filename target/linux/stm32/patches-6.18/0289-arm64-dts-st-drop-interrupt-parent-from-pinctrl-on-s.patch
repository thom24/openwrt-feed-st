From d2bccc7dd2a5335d7e2c25d778768b000a147c62 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Mon, 29 Sep 2025 15:16:29 +0200
Subject: [PATCH] arm64: dts: st: drop interrupt parent from pinctrl on
 stm32mp211

By using the property 'interrupts-extended', there is no need to
specify the interrupt parent.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 2 --
 1 file changed, 2 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp211.dtsi b/arch/arm64/boot/dts/st/stm32mp211.dtsi
index c7901b4fd21a..86066ce1dd3f 100644
--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -401,7 +401,6 @@ pinctrl: pinctrl@44240000 {
 			ranges = <0 0x44240000 0x80400>;
 			#address-cells = <1>;
 			#size-cells = <1>;
-			interrupt-parent = <&exti1>;
 			interrupts-extended =
 				<&exti1  0 0>, <&exti1  1 0>, <&exti1  2 0>, <&exti1  3 0>,
 				<&exti1  4 0>, <&exti1  5 0>, <&exti1  6 0>, <&exti1  7 0>,
@@ -579,7 +578,6 @@ pinctrl_z: pinctrl@46200000 {
 			ranges = <0 0x46200000 0x400>;
 			#address-cells = <1>;
 			#size-cells = <1>;
-			interrupt-parent = <&exti1>;
 			interrupts-extended =
 				<&exti1  0 0>, <&exti1  1 0>, <&exti1  2 0>, <&exti1  3 0>,
 				<&exti1  4 0>, <&exti1  5 0>, <&exti1  6 0>, <&exti1  7 0>,
-- 
2.53.0

