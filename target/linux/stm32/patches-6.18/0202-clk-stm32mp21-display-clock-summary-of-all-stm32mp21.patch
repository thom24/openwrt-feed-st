+
+static unsigned long cs_stm32_get_rate_by_name(struct clk_stm32_clock_data *data,
+					       struct clk_summary *c,
+					       unsigned long parent_rate)
+{
+	struct clk *clk = __clk_lookup(c->name);
+
+	if (clk)
+		return clk_get_rate(clk);
+
+	return 0;
