From 5f09ecfb7be2aa1af0d8a876d86a758011958d65 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Thu, 10 Aug 2023 16:06:12 +0200
Subject: [PATCH] dt-bindings: i3c: Document the STM32 I3C controller

STM32 I3C supports both controller and target role, SDR-only, and
implements all the feature required by the MIPI I3C v1.1 specification.

It requires at least a register mapping, a clock and an interrupt.

Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: I6f6592b851f90441fca8d8e01b6eca3b1ac559fe
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/545230
Tested-by: Alain VOLMAT <alain.volmat@st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 .../devicetree/bindings/i3c/st,stm32-i3c.yaml | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/i3c/st,stm32-i3c.yaml

diff --git a/Documentation/devicetree/bindings/i3c/st,stm32-i3c.yaml b/Documentation/devicetree/bindings/i3c/st,stm32-i3c.yaml
new file mode 100644
index 000000000000..b7c37f7fa154
--- /dev/null
+++ b/Documentation/devicetree/bindings/i3c/st,stm32-i3c.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/i3c/st,stm32-i3c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STM32 I3C controller
+
+maintainers:
+  - Amelie Delaunay <amelie.delaunay@foss.st.com>
+
+allOf:
+  - $ref: i3c.yaml#
+
+properties:
+  compatible:
+    const: st,stm32mp25-i3c
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  access-controllers:
+    minItems: 1
+    maxItems: 2
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/st,stm32mp25-rcc.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/st,stm32mp25-rcc.h>
+    i3c@40190000 {
+      #address-cells = <3>;
+      #size-cells = <0>;
+      compatible = "st,stm32mp25-i3c";
+      reg = <0x40190000 0x400>;
+      interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
+      clocks = <&rcc CK_KER_I3C1>;
+      resets = <&rcc I3C4_R>;
+      status = "disabled";
+    };
-- 
