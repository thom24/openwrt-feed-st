From 3f438c831400da191ee4cfc742b901beda26ac75 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Tue, 23 Jun 2026 16:22:49 +0200
Subject: [PATCH] dmaengine: stm32-dma3: honor client residue reporting
 preference

stm32-dma3 currently computes burst-level residue by synchronizing with
the running DMA channel to obtain up-to-date progress information.

That provides fine-grained residue updates, but on some audio paths the
required synchronization is too disruptive: it increases latency in the
pointer reporting path and can trigger underruns or overruns on
peripherals with shallow FIFOs.

Add a lower-overhead residue reporting path based on the currently
active linked-list segment, and use it when the DMA client requests
segment-level residue reporting through dma_slave_config.

This keeps the existing burst-level behavior as the default for stm32-dma3,
while allowing latency-sensitive clients to opt into coarser residue
updates that avoid synchronizing the channel during tx_status().

This is primarily intended for audio DMA, where segment/period-level
pointer movement is acceptable as long as the PCM interface advertises
batched hardware pointer updates to userspace.

Change-Id: I9597f62ccac0b2c18d8eb4e0d6118de95e8c0811
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/582120
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 drivers/dma/stm32/stm32-dma3.c | 37 +++++++++++++++++++++++++++++-----
 1 file changed, 32 insertions(+), 5 deletions(-)

diff --git a/drivers/dma/stm32/stm32-dma3.c b/drivers/dma/stm32/stm32-dma3.c
index fa703294e0d8..cab8f4aceefd 100644
--- a/drivers/dma/stm32/stm32-dma3.c
+++ b/drivers/dma/stm32/stm32-dma3.c
@@ -1194,9 +1194,28 @@ static int stm32_dma3_chan_get_curr_hwdesc(struct stm32_dma3_swdesc *swdesc, u32
 	return -EINVAL;
 }
 
-static void stm32_dma3_chan_set_residue(struct stm32_dma3_chan *chan,
-					struct stm32_dma3_swdesc *swdesc,
-					struct dma_tx_state *txstate)
+static void stm32_dma3_chan_set_segment_residue(struct stm32_dma3_chan *chan,
+						struct stm32_dma3_swdesc *swdesc,
+						struct dma_tx_state *txstate)
+{
+	struct stm32_dma3_ddata *ddata = to_stm32_dma3_ddata(chan);
+	u32 cllr = readl_relaxed(ddata->base + STM32_DMA3_CLLR(chan->id));
+	int curr_lli;
+
+	/* Only the current descriptor index matters for segment-granularity residue */
+	curr_lli = stm32_dma3_chan_get_curr_hwdesc(swdesc, cllr, NULL);
+	if (curr_lli < 0) {
+		dev_err(chan2dev(chan), "Can't get current hwdesc\n");
+		return;
+	}
+
+	/* Set residue as remaining transfer size starting at current LLI */
+	dma_set_residue(txstate, swdesc->lli[curr_lli].residue);
+}
+
+static void stm32_dma3_chan_set_burst_residue(struct stm32_dma3_chan *chan,
+					      struct stm32_dma3_swdesc *swdesc,
+					      struct dma_tx_state *txstate)
 {
 	struct stm32_dma3_ddata *ddata = to_stm32_dma3_ddata(chan);
 	struct device *dev = chan2dev(chan);
@@ -1924,8 +1943,16 @@ static enum dma_status stm32_dma3_tx_status(struct dma_chan *c, dma_cookie_t coo
 		swdesc = chan->swdesc;
 
 	/* Get residue/in_flight_bytes only if a transfer is currently running (swdesc != NULL) */
-	if (swdesc)
-		stm32_dma3_chan_set_residue(chan, swdesc, txstate);
+	if (swdesc) {
+		/*
+		 * Keep legacy burst-level residue reporting unless the client
+		 * explicitly requests segment granularity.
+		 */
+		if (chan->dma_config.residue_granularity == DMA_RESIDUE_GRANULARITY_SEGMENT)
+			stm32_dma3_chan_set_segment_residue(chan, swdesc, txstate);
+		else
+			stm32_dma3_chan_set_burst_residue(chan, swdesc, txstate);
+	}
 
 	spin_unlock_irqrestore(&chan->vchan.lock, flags);
 
-- 
2.53.0

