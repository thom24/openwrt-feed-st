From d29188652aecb38a2abbdcd0771af6fac211a8ea Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Fri, 15 May 2026 16:57:03 +0200
Subject: [PATCH] pinctrl: stm32-hdp: Add support for stm32mp231

The ST reference manual RM0457 is shared between the devices
stm32mp23x and stm32mp25x. In current revision 5, the manual does
not report any differences between the two devices for what
concerns the HDP pin muxing, even if it's evident that some of the
signals have no sense for stm32mp23x, e.g. PCIe signals present
while the interface is not available.

Introduce the compatible 'st,stm32mp231-hdp' allowing the use of
the same pin functions as for compatible 'st,stm32mp251-hdp'.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: Iad309c8217a68056e553a2a2ab5bf0c3cc5d26f6
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/568321
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 drivers/pinctrl/stm32/pinctrl-stm32-hdp.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/pinctrl/stm32/pinctrl-stm32-hdp.c b/drivers/pinctrl/stm32/pinctrl-stm32-hdp.c
index cce477e86ef9..3b75e0805c06 100644
--- a/drivers/pinctrl/stm32/pinctrl-stm32-hdp.c
+++ b/drivers/pinctrl/stm32/pinctrl-stm32-hdp.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Copyright (C) STMicroelectronics 2025 - All Rights Reserved
+ * Copyright (C) STMicroelectronics 2025-2026 - All Rights Reserved
  * Author: Clément Le Goffic <clement.legoffic@foss.st.com> for STMicroelectronics.
  */
 #include <linux/bits.h>
@@ -597,6 +597,10 @@ static const struct of_device_id stm32_hdp_of_match[] = {
 		.compatible = "st,stm32mp151-hdp",
 		.data = &func_name_mp15,
 	},
+	{
+		.compatible = "st,stm32mp231-hdp",
+		.data = &func_name_mp25,
+	},
 	{
 		.compatible = "st,stm32mp251-hdp",
 		.data = &func_name_mp25,
