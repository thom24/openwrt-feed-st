From ca7e1948e2954670222aefeb172036ece684a262 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 11 Jun 2026 10:58:45 +0200
Subject: [PATCH] ARM: dts: stm32: default disable RNG on STM32MP15x boards

Default disables the rng1 node as this device is secured for STM32MP15x
boards, therefore managed by OP-TEE.

Change-Id: I9492b3eeaa338e071bf7286d1df80a604653b953
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/577668
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm/boot/dts/st/stm32mp157c-ed1-no-scmi.dts | 4 ----
 arch/arm/boot/dts/st/stm32mp157d-ed1.dts         | 1 -
 arch/arm/boot/dts/st/stm32mp157f-ed1.dts         | 1 -
 arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi        | 4 ----
 4 files changed, 10 deletions(-)

diff --git a/arch/arm/boot/dts/st/stm32mp157c-ed1-no-scmi.dts b/arch/arm/boot/dts/st/stm32mp157c-ed1-no-scmi.dts
index cc3bd6c513b4..4c8add531249 100644
--- a/arch/arm/boot/dts/st/stm32mp157c-ed1-no-scmi.dts
+++ b/arch/arm/boot/dts/st/stm32mp157c-ed1-no-scmi.dts
@@ -498,10 +498,6 @@ &rcc {
 	bootph-all;
 };
 
-&rng1 {
-	status = "okay";
-};
-
 &rtc {
 	status = "okay";
 };
diff --git a/arch/arm/boot/dts/st/stm32mp157d-ed1.dts b/arch/arm/boot/dts/st/stm32mp157d-ed1.dts
index c01e99f827c0..612899b64d1a 100644
--- a/arch/arm/boot/dts/st/stm32mp157d-ed1.dts
+++ b/arch/arm/boot/dts/st/stm32mp157d-ed1.dts
@@ -532,7 +532,6 @@ &rcc {
 &rng1 {
 	clocks = <&scmi_clk CK_SCMI_RNG1>;
 	resets = <&scmi_reset RST_SCMI_RNG1>;
-	status = "okay";
 };
 
 &rtc {
diff --git a/arch/arm/boot/dts/st/stm32mp157f-ed1.dts b/arch/arm/boot/dts/st/stm32mp157f-ed1.dts
index e9bda619b010..654309983ead 100644
--- a/arch/arm/boot/dts/st/stm32mp157f-ed1.dts
+++ b/arch/arm/boot/dts/st/stm32mp157f-ed1.dts
@@ -538,7 +538,6 @@ &rcc {
 &rng1 {
 	clocks = <&scmi_clk CK_SCMI_RNG1>;
 	resets = <&scmi_reset RST_SCMI_RNG1>;
-	status = "okay";
 };
 
 &rtc {
diff --git a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
index 7b77bed0ec08..9db35dd19895 100644
--- a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
@@ -648,10 +648,6 @@ &rcc {
 	bootph-all;
 };
 
-&rng1 {
-	status = "okay";
-};
-
 &rtc {
 	status = "okay";
 };
-- 
2.53.0

