From 381f10db29149de241604fef6e876c2f9b6a230a Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 8 Apr 2026 16:57:08 +0200
Subject: [PATCH] arm64: dts: st: use lptimer3 as tick broadcast source on
 stm32mp215f-dk

During the low power modes the generic ARM timer is deactivated, so the
the tick broadcast need to be used in low power mode,
base on LPTIMER3 which is clocked by LSE on STMicroelectronics boards.

Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: Ie1c2fd03bcca3434c2edc8d6c8e3c84467d9c6a6
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/554829
Domain-Review: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Reviewed-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
Reviewed-by: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp215f-dk.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
index b566790ffe08..9e5bd42713ed 100644
--- a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
@@ -409,6 +409,14 @@ &ipcc1 {
 	status = "okay";
 };
 
+/* use LPTIMER with tick broadcast for suspend mode */
+&lptimer3 {
+	status = "okay";
+	timer {
+		status = "okay";
+	};
+};
+
 &ltdc {
 	bootph-some-ram;
 	pinctrl-names = "default", "sleep";
-- 
2.53.0

