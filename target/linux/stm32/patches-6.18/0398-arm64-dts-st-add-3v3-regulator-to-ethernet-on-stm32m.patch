From 582606f334d095de0a9e04665209a8ea6bd61049 Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Wed, 25 Feb 2026 09:41:23 +0100
Subject: [PATCH] arm64: dts: st: add 3v3 regulator to ethernet on
 stm32mp257f-dk

The Ethernet PHY is supplied by 3v3 PMIC regulator, add it to Ethernet
node.

Change-Id: I3b2128bfb3e42cbc3048f3768b8d870c4d3930e7
Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/540401
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts | 1 +
 1 file changed, 1 insertion(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -145,6 +145,7 @@
 	pinctrl-names = "default", "sleep";
 	phy-handle = <&phy1_eth1>;
 	phy-mode = "rgmii-id";
+	phy-supply = <&scmi_v3v3>;
 	status = "okay";
 
 	mdio {
