From 2637d8dcc4b95e49c488b59c387c51ba695c3f69 Mon Sep 17 00:00:00 2001
From: Olivier Moysan <olivier.moysan@foss.st.com>
Date: Tue, 25 Aug 2026 16:19:16 +0200
Subject: [PATCH] remoteproc: rproc_srm_core: drop dangling fw_devlink links of
 SRM sub-nodes

The SRM sub-nodes ("rproc-srm-dev") describe peripherals delegated to the
coprocessor. Some reference resources shared with the main processor
(e.g. a regulator via a *-supply property, such as vref-supply = <&vdda>
on the M4 ADC/DAC nodes). These sub-nodes are only populated as platform
devices when the coprocessor is started, so until then they have no
struct device. fw_devlink then anchors their unresolved supplier links to
the already-probed SRM core device (m4_system_resources) and, when the
shared supplier (the STPMIC1 regulators) shows up, emits spurious:

  rproc-srm-core 10000000.m4:m4_system_resources: Failed to create device
  link (0x180) with supplier 5c002000.i2c:stpmic@33:regulators for
  /ahb/m4@10000000/m4_system_resources/dac@40017000

The SRM manages these resources itself at runtime (on coprocessor
start/stop, driven by rpmsg), so fw_devlink probe-ordering is not needed
here. Purge the dangling fwnode links at probe. The DT *-supply
properties are untouched, so the resources are still acquired normally
once the sub-devices are populated.

Change-Id: I0a025e0bbfe0e6b7ccef56e5a352a7235f9b07b1
Assisted-by: GitHub-Copilot:Claude:4.6-Sonnet
Signed-off-by: Olivier Moysan <olivier.moysan@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/602723
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 drivers/remoteproc/rproc_srm_core.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/remoteproc/rproc_srm_core.c b/drivers/remoteproc/rproc_srm_core.c
index 3aeba5b8a2b5..1935914b6b85 100644
--- a/drivers/remoteproc/rproc_srm_core.c
+++ b/drivers/remoteproc/rproc_srm_core.c
@@ -5,8 +5,10 @@
  */
 
 #include <linux/component.h>
+#include <linux/fwnode.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/of_platform.h>
 #include <linux/remoteproc.h>
@@ -232,6 +234,23 @@ static void rproc_srm_core_unprepare(struct rproc_subdev *subdev)
 	devm_of_platform_depopulate(dev);
 }
 
+/*
+ * SRM sub-nodes are populated as platform devices only when the coprocessor
+ * starts, so fw_devlink cannot resolve their supplier links at boot and
+ * emits spurious "device link" errors. Drop those dangling fwnode links.
+ */
+static void rproc_srm_core_purge_fwnode_links(struct device *dev)
+{
+	struct device_node *child;
+
+	/* Links already picked up on the SRM core node itself. */
+	fwnode_links_purge(of_fwnode_handle(dev->of_node));
+
+	/* Links still attached to the not-yet-populated sub-nodes. */
+	for_each_child_of_node_scoped(dev->of_node, child)
+		fwnode_links_purge(of_fwnode_handle(child));
+}
+
 static int rproc_srm_core_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -246,6 +265,8 @@ static int rproc_srm_core_probe(struct platform_device *pdev)
 	rproc_srm_core->dev = dev;
 	BLOCKING_INIT_NOTIFIER_HEAD(&rproc_srm_core->notifier);
 
+	rproc_srm_core_purge_fwnode_links(dev);
+
 	/* Register rproc subdevice with (un)prepare ops */
 	rproc_srm_core->subdev.prepare = rproc_srm_core_prepare;
 	rproc_srm_core->subdev.unprepare = rproc_srm_core_unprepare;
-- 
