From 343977f850dbe4cea7878c8f1ab057abb3073de0 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 13 Feb 2026 11:54:57 +0100
Subject: [PATCH] arm64: dts: st: fix SCMI regulator addresses for
 stm32mp257f-dk board

The SCMI regulators for STPMIC2 were using incorrect child node
addresses in the ST SCMI voltage domain description. Align the
regulator node unit-addresses with the actual SCMI voltage domain
indices so that DT validation and SCMI regulator lookup are consistent.

Update the following SCMI regulator nodes:
- vdd_sdcard: regulator@23 -> regulator@17

Change-Id: I8101c2d7a4d47bffc1eb1b6d7d68d96dd0170155
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/535991
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -189,7 +189,7 @@
 		regulator-min-microvolt = <1800000>;
 		regulator-max-microvolt = <3300000>;
 	};
-	scmi_vdd_sdcard: regulator@23 {
+	scmi_vdd_sdcard: regulator@17 {
 		reg = <VOLTD_SCMI_STPMIC2_LDO7>;
 		regulator-name = "vdd_sdcard";
 	};
