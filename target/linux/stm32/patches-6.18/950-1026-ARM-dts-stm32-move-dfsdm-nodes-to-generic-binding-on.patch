From 4e114ed05ab84225cdaaff8d786d8121a4d1035c Mon Sep 17 00:00:00 2001
From: Olivier Moysan <olivier.moysan@foss.st.com>
Date: Mon, 27 Apr 2026 15:02:17 +0200
Subject: [PATCH] ARM: dts: stm32: move dfsdm nodes to generic binding on
 stm32mp157x-ev1

Replace the legacy channel binding by the generic channel binding in
DFSDM nodes stm32mp157x-ev1 device trees.

Change-Id: Ia7adbc3d2d104304fe23e4bbdfa1e5d5a6ce5285
Signed-off-by: Olivier Moysan <olivier.moysan@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/561694
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 .../boot/dts/st/stm32mp157c-ev1-no-scmi.dts   | 56 +++++++++++++------
 arch/arm/boot/dts/st/stm32mp157d-ev1.dts      | 56 +++++++++++++------
 arch/arm/boot/dts/st/stm32mp157f-ev1.dts      | 56 +++++++++++++------
 3 files changed, 114 insertions(+), 54 deletions(-)

--- a/arch/arm/boot/dts/st/stm32mp157c-ev1-no-scmi.dts
+++ b/arch/arm/boot/dts/st/stm32mp157c-ev1-no-scmi.dts
@@ -213,13 +213,18 @@
 
 	dfsdm0: filter@0 {
 		compatible = "st,stm32-dfsdm-dmic";
-		st,adc-channels = <3>;
-		st,adc-channel-names = "dmic_u1";
-		st,adc-channel-types = "SPI_R";
-		st,adc-channel-clk-src = "CLKOUT";
 		st,filter-order = <3>;
+		#address-cells = <1>;
+		#size-cells = <0>;
 		status = "okay";
 
+		channel@3 {
+			reg = <3>;
+			label = "dmic_u1";
+			st,adc-channel-type = "SPI_R";
+			st,adc-channel-clk-src = "CLKOUT";
+		};
+
 		asoc_pdm0: dfsdm-dai {
 			compatible = "st,stm32h7-dfsdm-dai";
 			#sound-dai-cells = <0>;
@@ -236,14 +241,19 @@
 
 	dfsdm1: filter@1 {
 		compatible = "st,stm32-dfsdm-dmic";
-		st,adc-channels = <0>;
-		st,adc-channel-names = "dmic_u2";
-		st,adc-channel-types = "SPI_F";
-		st,adc-channel-clk-src = "CLKOUT";
 		st,filter-order = <3>;
-		st,adc-alt-channel = <1>;
+		#address-cells = <1>;
+		#size-cells = <0>;
 		status = "okay";
 
+		channel@0 {
+			reg = <0>;
+			label = "dmic_u2";
+			st,adc-channel-type = "SPI_F";
+			st,adc-channel-clk-src = "CLKOUT";
+			st,adc-alt-channel;
+		};
+
 		asoc_pdm1: dfsdm-dai {
 			compatible = "st,stm32h7-dfsdm-dai";
 			#sound-dai-cells = <0>;
@@ -260,14 +270,19 @@
 
 	dfsdm2: filter@2 {
 		compatible = "st,stm32-dfsdm-dmic";
-		st,adc-channels = <2>;
