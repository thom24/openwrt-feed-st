@@ -241,6 +241,7 @@
 		i2s1_endpoint: endpoint {
 			dai-format = "i2s";
 			mclk-fs = <256>;
+			system-clock-direction-out;
 			remote-endpoint = <&codec_endpoint>;
 		};
 	};
