From 30a5df1244e9856bf22e3c8a29416c2ff434a515 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Fri, 23 Jan 2026 11:39:05 +0100
Subject: [PATCH] ARM: dts: stm32: enable the debug bus on stm32mp1x boards

On stm32mp1x boards, enable the debug bus so we always try to probe
the debug peripherals, if their status and the debug configuration
allow it.

Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: Ifa54c4ee692dc27d9e42e88de6a4cfd0d44306a7
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/530868
Domain-Review: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm/boot/dts/st/stm32mp135f-dk.dts          | 4 ++++
 arch/arm/boot/dts/st/stm32mp157c-ed1-no-scmi.dts | 4 ++++
 arch/arm/boot/dts/st/stm32mp157d-ed1.dts         | 4 ++++
 arch/arm/boot/dts/st/stm32mp157f-ed1.dts         | 4 ++++
 arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi        | 4 ++++
 5 files changed, 20 insertions(+)

--- a/arch/arm/boot/dts/st/stm32mp135f-dk.dts
+++ b/arch/arm/boot/dts/st/stm32mp135f-dk.dts
@@ -185,6 +185,10 @@
 	status = "okay";
 };
 
+&dbg_bus {
+	status = "okay";
+};
+
 &dcmipp {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&dcmipp_pins_a>;
--- a/arch/arm/boot/dts/st/stm32mp157c-ed1-no-scmi.dts
+++ b/arch/arm/boot/dts/st/stm32mp157c-ed1-no-scmi.dts
@@ -185,6 +185,10 @@
 	};
 };
 
+&dbg_bus {
+	status = "okay";
+};
+
 &dts {
 	status = "okay";
 };
--- a/arch/arm/boot/dts/st/stm32mp157d-ed1.dts
+++ b/arch/arm/boot/dts/st/stm32mp157d-ed1.dts
@@ -175,6 +175,10 @@
 	};
 };
 
+&dbg_bus {
+	status = "okay";
+};
+
 &dsi {
 	clocks = <&rcc DSI>, <&scmi_clk CK_SCMI_HSE>, <&rcc DSI_PX>;
 };
--- a/arch/arm/boot/dts/st/stm32mp157f-ed1.dts
+++ b/arch/arm/boot/dts/st/stm32mp157f-ed1.dts
@@ -181,6 +181,10 @@
 	};
 };
 
+&dbg_bus {
+	status = "okay";
+};
+
 &dsi {
 	clocks = <&rcc DSI>, <&scmi_clk CK_SCMI_HSE>, <&rcc DSI_PX>;
 };
--- a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
@@ -172,6 +172,10 @@
 	status = "okay";
 };
 
+&dbg_bus {
+	status = "okay";
+};
+
 &dts {
 	status = "okay";
 };
