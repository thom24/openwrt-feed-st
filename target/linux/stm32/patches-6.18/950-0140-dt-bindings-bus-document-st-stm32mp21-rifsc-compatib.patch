From b4abd12258ccd2eca7cb2e189afee7010d26a918 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Mon, 17 Feb 2025 15:21:25 +0100
Subject: [PATCH] dt-bindings: bus: document st,stm32mp21-rifsc compatible

Add st,stm32mp21-rifsc compatible to the list of possible compatibles
for the RIFSC.

Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: I69385cec94d09271b28e8e8853bc2a97b0407a28
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/437677
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 .../bindings/bus/st,stm32mp25-rifsc.yaml      | 52 ++++++++++++++++---
 1 file changed, 46 insertions(+), 6 deletions(-)

diff --git a/Documentation/devicetree/bindings/bus/st,stm32mp25-rifsc.yaml b/Documentation/devicetree/bindings/bus/st,stm32mp25-rifsc.yaml
index 0711daafca9d..01d43258fcdd 100644
--- a/Documentation/devicetree/bindings/bus/st,stm32mp25-rifsc.yaml
+++ b/Documentation/devicetree/bindings/bus/st,stm32mp25-rifsc.yaml
@@ -33,14 +33,18 @@ select:
   properties:
     compatible:
       contains:
-        const: st,stm32mp25-rifsc
+        enum:
+          - st,stm32mp21-rifsc
+          - st,stm32mp25-rifsc
   required:
     - compatible
 
 properties:
   compatible:
     items:
-      - const: st,stm32mp25-rifsc
+      - enum:
+          - st,stm32mp21-rifsc
+          - st,stm32mp25-rifsc
       - const: simple-bus
 
   reg:
@@ -50,7 +54,7 @@ properties:
     const: 1
 
   "#size-cells":
-    const: 1
+    enum: [1, 2]
 
   ranges: true
 
@@ -74,6 +78,21 @@ patternProperties:
     required:
       - access-controllers
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: st,stm32mp21-rifsc
+    then:
+      properties:
+        "#size-cells":
+          const: 2
+    else:
+      properties:
+        "#size-cells":
+          const: 1
+
 required:
   - compatible
   - reg
@@ -92,7 +111,7 @@ examples:
 
     #include <dt-bindings/interrupt-controller/arm-gic.h>
 
-    rifsc: bus@42080000 {
+    rifsc0: bus@42080000 {
         compatible = "st,stm32mp25-rifsc", "simple-bus";
         reg = <0x42080000 0x1000>;
         #address-cells = <1>;
@@ -100,11 +119,32 @@ examples:
         #access-controller-cells = <1>;
         ranges;
 
-        usart2: serial@400e0000 {
+        serial@400e0000 {
               compatible = "st,stm32h7-uart";
               reg = <0x400e0000 0x400>;
               interrupts = <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
               clocks = <&ck_flexgen_08>;
-              access-controllers = <&rifsc 32>;
+              access-controllers = <&rifsc0 32>;
+        };
+    };
+  - |
+    soc@0 {
+        ranges = <0x0 0x0 0x0 0x80000000>;
+        #address-cells = <1>;
+        #size-cells = <2>;
+        rifsc1: bus@42080000 {
+            compatible = "st,stm32mp21-rifsc", "simple-bus";
+            reg = <0x42080000 0x0 0x1000>;
+            #address-cells = <1>;
+            #size-cells = <2>;
+            #access-controller-cells = <1>;
+            ranges;
+            serial@400e0000 {
+                compatible = "st,stm32h7-uart";
+                reg = <0x400e0000 0x0 0x400>;
+                interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
+                clocks = <&ck_flexgen_08>;
+                access-controllers = <&rifsc1 32>;
+            };
         };
     };
-- 
2.53.0

