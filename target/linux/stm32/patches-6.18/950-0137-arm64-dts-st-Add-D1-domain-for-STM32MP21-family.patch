From 77fdc53c5624b1c94ee53d2b45ffd756aded8d77 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Mon, 16 Feb 2026 11:41:35 +0100
Subject: [PATCH] arm64: dts: st: Add D1 domain for STM32MP21 family

Add a new power domain D1 domain to manage device assigned to CA35
and working only in Run1, managed by CLUSTER_PD and CpuIdle,
but without limitation for wake-up for S2IDLE, managed by EXTI1
and RET_PD.

Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Ibc243544a13186cabedd574e63a3a1f881f9fcad
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/434118
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/536981
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 7 +++++++
 1 file changed, 7 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -140,6 +140,12 @@
 		};
 	};
 
+	d1_pd: power-domain-d1 {
+		compatible = "st,stm32mp-pm-domain";
+		#power-domain-cells = <0>;
+		power-domains = <&cluster_pd>;
+	};
+
 	psci: psci {
 		compatible = "arm,psci-1.0";
 		method = "smc";
@@ -192,6 +198,7 @@
 				reg = <0x400e0000 0x0 0x400>;
 				interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
 				clocks = <&ck_flexgen_08>;
+				power-domains = <&d1_pd>;
 				status = "disabled";
 			};
 		};
