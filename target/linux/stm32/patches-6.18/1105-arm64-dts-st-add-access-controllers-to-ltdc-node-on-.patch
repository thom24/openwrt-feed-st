From d45751e876f1f83907a35b7ba9e2149e95b711d7 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Fri, 28 Jun 2024 11:14:40 +0200
Subject: [PATCH] arm64: dts: st: add access controllers to ltdc node on
 stm32mp251

The display controller has several register areas/handles various
resources that represent several RIFSC entries.
Access for all of these resources must be checked when the RIFSC
bus is populated.

Change-Id: I8ff6c70f67d6ca06265c0ec021a14caf0c3fe66f
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/552088
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp251.dtsi b/arch/arm64/boot/dts/st/stm32mp251.dtsi
index 44aba181e670..122e7f647004 100644
--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -2129,8 +2129,22 @@ ltdc: display-controller@48010000 {
 				clock-names = "lcd", "bus";
 				resets = <&rcc LTDC_R>;
 				power-domains = <&d1_pd>;
-				access-controllers = <&rifsc 80>;
 				status = "disabled";
+
+				access-controllers = <&rifsc 80>;
+				access-controller-names = "cmn";
+				l1l2 {
+					access-controllers = <&rifsc 119>;
+					access-controller-names = "l1l2";
+				};
+				l3 {
+					access-controllers = <&rifsc 120>;
+					access-controller-names = "l3";
+				};
+				rot {
+					access-controllers = <&rifsc 121>;
+					access-controller-names = "rot";
+				};
 			};
 
 			csi: csi@48020000 {
-- 
2.53.0

