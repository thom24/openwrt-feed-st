From f1487428374735fb4a0d27d5d95391dc00027d8d Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Wed, 15 Jan 2025 15:11:39 +0100
Subject: [PATCH] usb: dwc2: hcd: only allow to turn off the PHY when in host
 mode

When in device mode, the hcd API shouldn't allow to turn off the PHY.
It is now handled in a similar manner in gadget driver.

When there are wakeup enabled descendants, but the controller hasn't
been enabled to wakeup, the PHY gets switched off, and the enabled
descendants are ignored. So it won't be able to wakeup.
Change the default behavior in case there are wakeup enabled descendants,
keep the PHY active.

Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: If48d476f014c7b4f2bb02156046a44b97c0d1f96
---
 drivers/usb/dwc2/hcd.c | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/drivers/usb/dwc2/hcd.c b/drivers/usb/dwc2/hcd.c
index 04cc115d628b..e6a24ecc21d9 100644
--- a/drivers/usb/dwc2/hcd.c
+++ b/drivers/usb/dwc2/hcd.c
@@ -5756,17 +5756,19 @@ int dwc2_host_exit_hibernation(struct dwc2_hsotg *hsotg, int rem_wakeup,
 
 bool dwc2_host_can_poweroff_phy(struct dwc2_hsotg *dwc2)
 {
-	struct usb_device *root_hub = dwc2_hsotg_to_hcd(dwc2)->self.root_hub;
+	struct usb_device *root_hub;
 
-	/* If the controller isn't allowed to wakeup then we can power off. */
-	if (!device_may_wakeup(dwc2->dev))
-		return true;
+	/* host driver don't need the PHY, as in device mode */
+	if (dwc2_is_device_mode(dwc2) || dwc2->dr_mode == USB_DR_MODE_PERIPHERAL)
+		return false;
+
+	root_hub = dwc2_hsotg_to_hcd(dwc2)->self.root_hub;
 
 	/*
-	 * We don't want to power off the PHY if something under the
-	 * root hub has wakeup enabled.
+	 * If the controller is allowed to wakeup or if something under the root hub has wakeup
+	 * enabled, then we don't want to power off the PHY.
 	 */
-	if (usb_wakeup_enabled_descendants(root_hub))
+	if (device_may_wakeup(dwc2->dev) || usb_wakeup_enabled_descendants(root_hub))
 		return false;
 
 	/* No reason to keep the PHY powered, so allow poweroff */
-- 
