From 4cd1bc3b4bbf54a1188fa747da4035f116b5d252 Mon Sep 17 00:00:00 2001
From: Christian Bruel <christian.bruel@foss.st.com>
Date: Mon, 20 Jul 2026 11:49:43 +0200
Subject: [PATCH] dt-bindings: pci: Replace the PCIe root complex msi-parent
 property with msi-map

The STM32MP25 uses AER and PME events through platform interrupt lines

Align the STM32MP25 PCIe node with the generic Synopsys DesignWare PCIe
binding, which requires an msi-map property when no dedicated "msi"
interrupt is provided.

Thus use msi-map to describe MSI routing through the GICv2m MSI domain for
downstream PCIe Requester IDs, rather than as a general MSI parent for
the root complex itself.

Signed-off-by: Christian Bruel <christian.bruel@foss.st.com>
Change-Id: Ic9cc8e1aa95c51065d509f88bc533d5e51c2d561
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/590107
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
---
 .../devicetree/bindings/pci/st,stm32-pcie-host.yaml          | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/st,stm32-pcie-host.yaml b/Documentation/devicetree/bindings/pci/st,stm32-pcie-host.yaml
index 443bfe2cdc98..2ff6267715b9 100644
--- a/Documentation/devicetree/bindings/pci/st,stm32-pcie-host.yaml
+++ b/Documentation/devicetree/bindings/pci/st,stm32-pcie-host.yaml
@@ -30,9 +30,6 @@ properties:
       - const: dbi
       - const: config
 
-  msi-parent:
-    maxItems: 1
-
 patternProperties:
   '^pcie@[0-2],0$':
     type: object
@@ -95,7 +92,7 @@ examples:
         dma-ranges = <0x42000000 0x0 0x80000000 0x80000000 0x0 0x80000000>;
         clocks = <&rcc CK_BUS_PCIE>;
         resets = <&rcc PCIE_R>;
-        msi-parent = <&v2m0>;
+        msi-map = <0x0 &v2m0 0x0 0x10000>;
         access-controllers = <&rifsc 68>;
         power-domains = <&CLUSTER_PD>;
 
-- 
