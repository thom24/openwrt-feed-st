From 04fa803fdbdc6b4acc2c99b460b008f36a380578 Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Thu, 16 Apr 2026 15:52:25 +0200
Subject: [PATCH] arm64: dts: st: add usb2phy support on stm32mp231

Add USB2PHY support on stm32mp231:
- usb2phy1 is dedicated to the usb 2.0 host controller
- usb2phy2 is dedicated to the usb dwc3 Dual-Role Controller,
supporting Low/Full/High-Speed

The USB2PHY is a clock provider. It provides clocks (e.g. 48MHz) to
the controllers, through RCC:
_______________      ____________________      ______________________
| USB2PHY PLL | ---> | RCC clock gating | ---> | EHCI/OHCI , or DWC3 |
---------------      --------------------      ----------------------
Add the necessary #clock-cells, so the clock can be requested in the
controller nodes. Distinguish OHCI and PLL clocks on stm32mp231, by
using one cell clock bindings. The OHCI clock must be enabled
specifically during resume from low power.

Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: I3078dfc74fbad9ef012ad1af44c2a71fd1a82463
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559879
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -241,6 +241,28 @@
 		arm,no-tick-in-suspend;
 	};
 
+	usb2_phy1: usb2-phy1 {
+		compatible      = "st,stm32mp25-usb2phy";
+		#phy-cells      = <0>;
+		#clock-cells    = <1>;
+		st,syscfg       = <&syscfg 0x2400>;
+		clocks          = <&rcc CK_KER_USB2PHY1>, <&rcc CK_KER_USB2PHY1STP>;
+		clock-names     = "core", "stp";
+		resets          = <&rcc USB2PHY1_R>;
+		status          = "disabled";
+	};
+
+	usb2_phy2: usb2-phy2 {
+		compatible      = "st,stm32mp25-usb2phy";
+		#phy-cells      = <0>;
+		#clock-cells    = <1>;
+		st,syscfg       = <&syscfg 0x2800>;
+		clocks          = <&rcc CK_KER_USB2PHY2EN>;
+		clock-names     = "core";
+		resets          = <&rcc USB2PHY2_R>;
+		status          = "disabled";
+	};
+
 	soc@0 {
 		compatible = "simple-bus";
 		ranges = <0x0 0x0 0x0 0x80000000>;
