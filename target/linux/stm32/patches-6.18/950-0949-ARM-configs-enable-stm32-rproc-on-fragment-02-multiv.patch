From fed5754d073a3eb71e83f0b36d0e015061b86388 Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Wed, 31 Jan 2024 15:26:06 +0100
Subject: [PATCH] ARM: configs: enable stm32 rproc on
 fragment-02-multiv7_addons

Enable STM32 remoteproc.

Change-Id: Ibb4ed25beb3ff71505c3aed9cef9f40cda0a298f
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/552535
Reviewed-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
Tested-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm/configs/fragment-02-multiv7_addons.config | 2 ++
 1 file changed, 2 insertions(+)

--- a/arch/arm/configs/fragment-02-multiv7_addons.config
+++ b/arch/arm/configs/fragment-02-multiv7_addons.config
@@ -63,6 +63,7 @@ CONFIG_REGULATOR_STM32_PWR=y
 CONFIG_REGULATOR_STM32_VREFBUF=m
 CONFIG_REGULATOR_STPMIC1=y
 CONFIG_REGULATOR_WM8994=m
+CONFIG_REMOTEPROC=y
 CONFIG_RPMSG_TTY=m
 CONFIG_RPMSG_VIRTIO=y
 CONFIG_SAMPLES=y
@@ -81,6 +82,7 @@ CONFIG_STM32_FMC2_EBI=y
 CONFIG_STM32_IPCC=y
 CONFIG_STM32_RPROC=y
 CONFIG_STM32_TIMER_CNT=m
+CONFIG_TEE_REMOTEPROC=y
 CONFIG_TOUCHSCREEN_GOODIX=m
 CONFIG_USB_HIDDEV=y
 CONFIG_USB_EHCI_HCD_PLATFORM=y
