From 3ccf678fd59d7f1adcb156ef2d88297c042ce738 Mon Sep 17 00:00:00 2001
From: Christian Bruel <christian.bruel@foss.st.com>
Date: Wed, 8 Jul 2026 17:15:40 +0200
Subject: [PATCH] arm64: dts: st: enable ucpd on stm32mp235f-dk

Add ucpd node to connect typec remote endpoint to ucpd driver instead of
rpmsg connector to the m33 firmware.
Only support peripheral mode in high speed.

The board is self-powered, it shall be indicated in the DT.
It also resolve initial condition: legacy Type-A->Type-C cable
plugged upon boot isn't detected otherwise.

Signed-off-by: Christian Bruel <christian.bruel@foss.st.com>
Change-Id: I622d52de44eae5b7840df72bb4d732d2807d4690
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/586896
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp235f-dk.dts | 56 +++++++++--------------
 1 file changed, 21 insertions(+), 35 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
index 86a3d8817fe9..941d4e7f2d07 100644
--- a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
@@ -595,41 +595,6 @@ &m33_rproc {
 	status = "okay";
 };
 
-&mlahb {
-	intc_rpmsg: interrupt-controller@1 {
-		compatible = "rpmsg,intc";
-		reg = <1 0>;
-		#interrupt-cells = <1>;
-		interrupt-controller;
-	};
-
-	i2c_rpmsg: i2c@2 {
-		compatible = "rpmsg,i2c-controller";
-		reg = <2 0>;
-		rpmsg,dev-id = "rpmsg_i2c";
-		#address-cells = <1>;
-		#size-cells = <0>;
-		status = "okay";
-
-		typec@35 {
-			compatible = "st,stm32mp25-typec";
-			reg = <0x35>;
-			interrupts-extended = <&intc_rpmsg 0>;
-			status = "okay";
-			connector {
-				compatible = "usb-c-connector";
-				label = "USB-C";
-
-				port {
-					typec_ep: endpoint {
-						remote-endpoint = <&dwc3_ep>;
-					};
-				};
-			};
-		};
-	};
-};
-
 &optee {
 	bootph-all;
 };
@@ -790,6 +755,26 @@ pwm3: pwm {
 	};
 };
 
+&ucpd {
+	st,tcpp = <&tcpp>;
+	status = "okay";
+
+	connector {
+		compatible = "usb-c-connector";
+		label = "USB-C";
+		data-role = "device";
+		power-role = "sink";
+		typec-power-opmode = "default";
+		pd-disable;
+		self-powered;
+		port {
+			typec_ep: endpoint {
+				remote-endpoint = <&dwc3_ep>;
+			};
+		};
+	};
+};
+
 /* Bluetooth */
 &usart1 {
 	pinctrl-names = "default", "sleep", "idle";
@@ -854,6 +839,7 @@ &usb3dr {
 	status = "okay";
 
 	dwc3: usb@48300000 {
+		maximum-speed = "high-speed";
 		usb-role-switch;
 		port {
 			dwc3_ep: endpoint {
-- 
2.53.0

