From ebea518da0696f5d0bcdb3905eeb6121f7b88258 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Tue, 29 Jul 2025 10:45:26 +0200
Subject: [PATCH] arm64: dts: st: add I3C4 support on stm32mp257f-dk

I3C4 is available on GPIO expansion connector of stm32mp257f-dk board,
using the EXP_GPIO22 and EXP_GPIO23, respectively PZ0 and PZ1 configured
by i3c4 pins_b pinctrl.

Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: I69d30a131f7a4c6aee9a906ad69a6e21a6f799d0
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/545083
Tested-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -251,6 +251,14 @@
 	/delete-property/dma-names;
 };
 
+&i3c4 {
+	pinctrl-names = "default", "init", "sleep";
+	pinctrl-0 = <&i3c4_pins_b>;
+	pinctrl-1 = <&i3c4_init_pins_b>;
+	pinctrl-2 = <&i3c4_sleep_pins_b>;
+	status = "disabled";
+};
+
 &ipcc1 {
 	status = "okay";
 };
