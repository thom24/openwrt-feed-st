From 67fe2569f68c7428b8af0b8585ad039a0aae0bff Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Tue, 17 Feb 2026 08:25:25 +0100
Subject: [PATCH] arm64: dts: st: add SCMI Power Domain support in STM32MP23
 and STM32MP25

Add protocol 17 in SCMI node, to send power-domains change state
through SCMI protocol.

Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I36f1e24771c5593291d33b19bd7eb65636ea61c5
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/373466
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/537244
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 5 +++++
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp231.dtsi b/arch/arm64/boot/dts/st/stm32mp231.dtsi
index 408566e9cca6..18736a9978b7 100644
--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -106,6 +106,11 @@ scmi: scmi {
 			#size-cells = <0>;
 			linaro,optee-channel-id = <0>;
 
+			scmi_devpd: protocol@11 {
+				reg = <0x11>;
+				#power-domain-cells = <1>;
+			};
+
 			scmi_clk: protocol@14 {
 				reg = <0x14>;
 				#clock-cells = <1>;
diff --git a/arch/arm64/boot/dts/st/stm32mp251.dtsi b/arch/arm64/boot/dts/st/stm32mp251.dtsi
index 870ce0dc6cbb..94402e36a7e7 100644
--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -115,6 +115,11 @@ scmi: scmi {
 			#size-cells = <0>;
 			linaro,optee-channel-id = <0>;
 
+			scmi_devpd: protocol@11 {
+				reg = <0x11>;
+				#power-domain-cells = <1>;
+			};
+
 			scmi_clk: protocol@14 {
 				reg = <0x14>;
 				#clock-cells = <1>;
-- 
2.53.0

