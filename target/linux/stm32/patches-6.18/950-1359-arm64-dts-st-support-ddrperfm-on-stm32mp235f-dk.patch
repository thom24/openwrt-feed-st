From dbf95a6aa6c0fba4e015c580d077ed4ca70bed8f Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Mon, 25 May 2026 11:34:35 +0200
Subject: [PATCH] arm64: dts: st: support ddrperfm on stm32mp235f-dk

Configure and enable DDRPERFM node on stm32mp235f-dk board.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I925c267a35184df6295cf7cb530c37c4d92d8724
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/571232
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp235f-dk.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
index d91f61c69f8c..b8c9e745ec6e 100644
--- a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
@@ -294,6 +294,11 @@ dcmipp_0: endpoint {
 	};
 };
 
+&ddrperfm {
+	memory-channel = <&lpddr_channel>;
+	status = "okay";
+};
+
 &dsi {
 	vdd-supply =  <&scmi_vddcore>;
 	vdda18-supply = <&scmi_v1v8>;
-- 
2.53.0

