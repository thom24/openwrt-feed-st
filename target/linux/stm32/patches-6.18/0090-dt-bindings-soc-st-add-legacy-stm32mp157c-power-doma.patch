From 134214f34e9d5443c61880578c84dbd956f130b1 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Wed, 10 Jun 2026 13:32:41 +0200
Subject: [PATCH] dt-bindings: soc: st: add legacy stm32mp157c power-domain
 schema

Add a dedicated binding schema for the legacy STM32MP1 hierarchical
power-domain provider using compatible st,stm32mp157c-pd.

Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I06d66a5a68f4d7e295f4f04186cb5525ec7bfecc
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/577324
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 .../bindings/soc/st/stm32mp157c-pd.yaml       | 90 +++++++++++++++++++
 1 file changed, 90 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/st/stm32mp157c-pd.yaml

diff --git a/Documentation/devicetree/bindings/soc/st/stm32mp157c-pd.yaml b/Documentation/devicetree/bindings/soc/st/stm32mp157c-pd.yaml
new file mode 100644
index 000000000000..d754256e5e13
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/st/stm32mp157c-pd.yaml
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/st/stm32mp157c-pd.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STM32MP1 power domain based on proprietary SMC
+
+maintainers:
+  - Patrick Delaunay <patrick.delaunay@foss.st.com>
+
+deprecated: true
+
+description: |
+  STM32MP1 hierarchical power domain provider and based on proprietary SMC.
+
+  This binding is used for backward compatibility. New platforms should use
+  hierarchy of PSCI power domains and sub-domain with compatible
+  'st,stm32mp-pm-domain'.
+
+properties:
+  compatible:
+    const: st,stm32mp157c-pd
+
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 0
+
+$defs:
+  subdomain:
+    type: object
+    properties:
+      reg:
+        maxItems: 1
+
+      '#power-domain-cells':
+        const: 0
+
+      '#address-cells':
+        const: 1
+
+      '#size-cells':
+        const: 0
+
+      label: true
+
+    required:
+      - reg
+      - '#power-domain-cells'
+
+    patternProperties:
+      '^.*-power-domain@[0-9a-f]+$':
+        $ref: '#/$defs/subdomain'
+
+    additionalProperties: false
+
+required:
+  - compatible
+  - '#address-cells'
+  - '#size-cells'
+
+patternProperties:
+  '^.*-power-domain@[0-9a-f]+$':
+    $ref: '#/$defs/subdomain'
+
+additionalProperties: false
+
+examples:
+  - |
+    pm_domain {
+      #address-cells = <1>;
+      #size-cells = <0>;
+      compatible = "st,stm32mp157c-pd";
+
+      pd_core_ret: core-ret-power-domain@1 {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        reg = <1>;
+        #power-domain-cells = <0>;
+        label = "CORE-RETENTION";
+
+        pd_core: core-power-domain@2 {
+          reg = <2>;
+          #power-domain-cells = <0>;
+          label = "CORE";
+        };
+      };
+    };
-- 
2.53.0

