From e7d9675efe6eff3c8f0597995cd2152d381ed444 Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Mon, 9 Feb 2026 09:30:52 +0100
Subject: [PATCH] dt-bindings: i2c: Document the RPMsg I2C controller

Document the RPMsg I2C controller bindings.

Change-Id: I1385b4c6122a582a4e119cefc3c96168030253fe
Signed-off-by: Maxime MERE <maxime.mere@st.com>
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
---
 .../devicetree/bindings/i2c/i2c-rpmsg.yaml    | 55 +++++++++++++++++++
 .../devicetree/bindings/vendor-prefixes.yaml  |  2 +
 2 files changed, 57 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/i2c/i2c-rpmsg.yaml

diff --git a/Documentation/devicetree/bindings/i2c/i2c-rpmsg.yaml b/Documentation/devicetree/bindings/i2c/i2c-rpmsg.yaml
new file mode 100644
index 000000000000..ccdbcce6d037
--- /dev/null
+++ b/Documentation/devicetree/bindings/i2c/i2c-rpmsg.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+# Copyright (c) 2023 STMicroelectronics.
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/i2c/i2c-rpmsg.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: RPMsg I2C Adapter
+
+maintainers:
+  - Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
+
+allOf:
+  - $ref: /schemas/i2c/i2c-controller.yaml#
+
+description:
+  RPMsg I2C adapter for I2C protocol support over RPMsg
+
+properties:
+  compatible:
+    const: rpmsg,i2c-controller
+
+  reg:
+    maxItems: 1
+    description:
+      Bus address/size tuple used by the parent bus for child node addressing.
+
+  rpmsg,dev-id:
+    description:
+      Id name of the rpmsg_i2c device instance
+    $ref: /schemas/types.yaml#/definitions/string
+
+required:
+  - compatible
+  - reg
+  - rpmsg,dev-id
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    rpmsg_i2c: i2c@0 {
+        compatible = "rpmsg,i2c-controller";
+        reg = <0 0>;
+        rpmsg,dev-id = "rpmsg_i2c";
+        status = "okay";
+
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        light-sensor@20 {
+            compatible = "dynaimage,al3320a";
+            reg = <0x20>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
index a9cf85fd6fbe..1a23295013d4 100644
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -1367,6 +1367,8 @@ patternProperties:
     description: Shenzhen Roofull Technology Co, Ltd
   "^roseapplepi,.*":
     description: RoseapplePi.org
+  "^rpmsg,.*":
+    description: remote processor messaging Device Specification
   "^rve,.*":
     description: Recharge Véhicule Électrique (RVE) inc.
   "^saef,.*":
-- 
