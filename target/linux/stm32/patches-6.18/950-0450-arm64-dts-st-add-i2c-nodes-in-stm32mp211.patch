From 9c07c772228197903a491a6077ef4de754293b40 Mon Sep 17 00:00:00 2001
From: Alain Volmat <alain.volmat@foss.st.com>
Date: Mon, 16 Feb 2026 12:39:06 +0100
Subject: [PATCH] arm64: dts: st: add i2c nodes in stm32mp211

Describe all 3 i2c nodes available in stm32mp211.

Signed-off-by: Alain Volmat <alain.volmat@foss.st.com>
Change-Id: I6639af061cb6ba572266a74ab7efbdc1a9783b15
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/536952
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Alain VOLMAT <alain.volmat@st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 48 ++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp211.dtsi b/arch/arm64/boot/dts/st/stm32mp211.dtsi
index a63cd846a4c7..6519f12dcfda 100644
--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -203,6 +203,38 @@ usart2: serial@400e0000 {
 				status = "disabled";
 			};
 
+			i2c1: i2c@40170000 {
+				compatible = "st,stm32mp25-i2c";
+				reg = <0x40170000 0x0 0x400>;
+				interrupt-names = "event";
+				interrupts-extended = <&exti1 21 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_I2C1>;
+				resets = <&rcc I2C1_R>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				access-controllers = <&rifsc 41>;
+				i2c-analog-filter;
+				wakeup-source;
+				power-domains = <&d1_pd>;
+				status = "disabled";
+			};
+
+			i2c2: i2c@40180000 {
+				compatible = "st,stm32mp25-i2c";
+				reg = <0x40180000 0x0 0x400>;
+				interrupt-names = "event";
+				interrupts-extended = <&exti1 22 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_I2C2>;
+				resets = <&rcc I2C2_R>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				access-controllers = <&rifsc 42>;
+				i2c-analog-filter;
+				wakeup-source;
+				power-domains = <&d1_pd>;
+				status = "disabled";
+			};
+
 			iwdg1: watchdog@44010000 {
 				compatible = "st,stm32mp1-iwdg";
 				reg = <0x44010000 0x0 0x400>;
@@ -223,6 +255,22 @@ iwdg2: watchdog@44020000 {
 				status = "disabled";
 			};
 
+			i2c3: i2c@46040000 {
+				compatible = "st,stm32mp25-i2c";
+				reg = <0x46040000 0x0 0x400>;
+				interrupt-names = "event";
+				interrupts-extended = <&exti1 23 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_I2C3>;
+				resets = <&rcc I2C3_R>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				access-controllers = <&rifsc 43>;
+				i2c-analog-filter;
+				wakeup-source;
+				power-domains = <&d1_pd>;
+				status = "disabled";
+			};
+
 			sdmmc1: mmc@48220000 {
 				compatible = "st,stm32mp25-sdmmc2", "arm,pl18x", "arm,primecell";
 				reg = <0x48220000 0x0 0x400>, <0x44230400 0x0 0x8>;
-- 
2.53.0

