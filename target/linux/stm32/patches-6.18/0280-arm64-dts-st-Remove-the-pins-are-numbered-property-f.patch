From b0eeabd6e510535161ab55cdd7757080706baab4 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Mon, 29 Sep 2025 13:25:24 +0200
Subject: [PATCH] arm64: dts: st: Remove the pins-are-numbered property from
 stm32mp231

Remove the deprecated property "pins-are-numbered" from pinctrl and
pinctrl_z nodes of stm32mp231 soc to ensure to be conform with the
upstream series of the link below.

Link: https://lore.kernel.org/all/20221129023401.278780-1-bero@baylibre.com/
Fixes: e9b03ef21386 ("arm64: dts: st: introduce stm32mp23 SoCs family")
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 2 --
 1 file changed, 2 deletions(-)

--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -1081,7 +1081,6 @@
 			#size-cells = <1>;
 			interrupt-parent = <&exti1>;
 			st,syscfg = <&exti1 0x60 0xff>;
-			pins-are-numbered;
 
 			gpioa: gpio@44240000 {
 				reg = <0x0 0x400>;
@@ -1200,7 +1199,6 @@
 			#size-cells = <1>;
 			interrupt-parent = <&exti1>;
 			st,syscfg = <&exti1 0x60 0xff>;
-			pins-are-numbered;
 
 			gpioz: gpio@46200000 {
 				reg = <0 0x400>;
