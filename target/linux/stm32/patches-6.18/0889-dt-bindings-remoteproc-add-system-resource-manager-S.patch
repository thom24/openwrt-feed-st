From 9800a194179f82dd69da84827b22a8b3508b62eb Mon Sep 17 00:00:00 2001
From: Olivier Moysan <olivier.moysan@foss.st.com>
Date: Fri, 18 Oct 2019 16:23:23 +0200
Subject: [PATCH] dt-bindings: remoteproc: add system resource manager (SRM)

Document the remoteproc SRM (System Resource Manager) core node
that handles resources allocated to remote processors and SRM
managed device subnodes.

Change-Id: I5f13d1724b586f61f57795399ce0015dafde8ba6
Signed-off-by: Olivier Moysan <olivier.moysan@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/571819
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 .../bindings/remoteproc/rproc-srm.yaml        | 97 +++++++++++++++++++
 .../bindings/remoteproc/st,stm32-rproc.yaml   |  8 ++
 2 files changed, 105 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/remoteproc/rproc-srm.yaml

diff --git a/Documentation/devicetree/bindings/remoteproc/rproc-srm.yaml b/Documentation/devicetree/bindings/remoteproc/rproc-srm.yaml
new file mode 100644
index 000000000000..f63afdb15079
--- /dev/null
+++ b/Documentation/devicetree/bindings/remoteproc/rproc-srm.yaml
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/remoteproc/rproc-srm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Remoteproc System Resource Manager
+
+maintainers:
+  - Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
+
+description: |
+  The remoteproc SRM (System Resource Manager) handles resources allocated
+  to remote processors.
+  This makes it possible to reserve some system resources for a peripheral
+  assigned to a coprocessor.
+
+properties:
+  compatible:
+    const: rproc-srm-core
+
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 1
+
+$defs:
+  rproc-srm-dev:
+    type: object
+    description:
+      Peripheral resource node managed by SRM for the remote processor.
+    properties:
+      compatible:
+        const: rproc-srm-dev
+
+      reg:
+        maxItems: 1
+
+      clocks: true
+
+      clock-names: true
+
+      pinctrl-0: true
+
+      pinctrl-names:
+        items:
+          - const: default
+
+      interrupts: true
+
+      interrupt-parent: true
+
+      interrupt-names: true
+
+    patternProperties:
+      "^[a-zA-Z0-9-]+-supply$":
+        $ref: /schemas/types.yaml#/definitions/phandle
+
+    required:
+      - compatible
+
+    additionalProperties: true
+
+required:
+  - compatible
+
+additionalProperties:
+  $ref: "#/$defs/rproc-srm-dev"
+
+examples:
+  - |
+    m4_rproc {
+      m4_system_resources {
+        #address-cells = <1>;
+        #size-cells = <1>;
+        status = "okay";
+
+        button {
+          compatible = "rproc-srm-dev";
+          interrupt-parent = <&gpioa>;
+          interrupts = <14 2>;
+          interrupt-names = "irq";
+          status = "okay";
+        };
+
+        sai4: sai@50027000 {
+          compatible = "rproc-srm-dev";
+          reg = <0x50027000 0x4>;
+          clocks = <&rcc 0>;
+          clock-names = "sai_ck";
+          status = "disabled";
+        };
+      };
+    };
+
+...
diff --git a/Documentation/devicetree/bindings/remoteproc/st,stm32-rproc.yaml b/Documentation/devicetree/bindings/remoteproc/st,stm32-rproc.yaml
index 6a1e6872d49b..aa63899c1406 100644
--- a/Documentation/devicetree/bindings/remoteproc/st,stm32-rproc.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/st,stm32-rproc.yaml
@@ -184,6 +184,13 @@ properties:
     description:
       SRAM only. Preserves power during a suspend/resume cycle.
 
+  m4_system_resources:
+    $ref: /schemas/remoteproc/rproc-srm.yaml#
+    description:
+      Child node used to declare system resources managed through the
+      remoteproc system resource manager.
+    minItems: 1
+
 required:
   - compatible
   - reg
@@ -245,6 +252,7 @@ allOf:
       properties:
         reg:
           minItems: 1
+        m4_system_resources: false
 
 additionalProperties: false
 
-- 
2.53.0

