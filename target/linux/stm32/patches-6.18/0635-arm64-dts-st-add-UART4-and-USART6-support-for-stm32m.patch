From 5abdcc290e17332f885826feaa72ecc65604c39d Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Tue, 10 Mar 2026 17:49:58 +0100
Subject: [PATCH] arm64: dts: st: add UART4 and USART6 support for
 stm32mp215f-dk board

Add UART4 and USART6 nodes and aliases for stm32mp215f-dk board.
UART4 and USART6 are on the GPIO connector.

Change-Id: I763cabf05f4335876e5065607638747598228cb3
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/545349
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp215f-dk.dts | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
index 0f11180accaa..5fbee278b6b8 100644
--- a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
@@ -21,6 +21,8 @@ / {
 	aliases {
 		ethernet0 = &ethernet1;
 		serial0 = &usart2;
+		serial1 = &usart6;
+		serial2 = &uart4;
 	};
 
 	chosen {
@@ -326,6 +328,16 @@ &syscfg {
 	bootph-all;
 };
 
+&uart4 {
+	pinctrl-names = "default", "idle", "sleep";
+	pinctrl-0 = <&uart4_pins_a>;
+	pinctrl-1 = <&uart4_idle_pins_a>;
+	pinctrl-2 = <&uart4_sleep_pins_a>;
+	/delete-property/dmas;
+	/delete-property/dma-names;
+	status = "disabled";
+};
+
 &usart2 {
 	bootph-all;
 	pinctrl-names = "default", "idle", "sleep";
@@ -346,3 +358,12 @@ pins2 {
 		bootph-all;
 	};
 };
+
+&usart6 {
+	pinctrl-names = "default", "idle", "sleep";
+	pinctrl-0 = <&usart6_pins_a>;
+	pinctrl-1 = <&usart6_idle_pins_a>;
+	pinctrl-2 = <&usart6_sleep_pins_a>;
+	uart-has-rtscts;
+	status = "disabled";
+};
-- 
2.53.0

