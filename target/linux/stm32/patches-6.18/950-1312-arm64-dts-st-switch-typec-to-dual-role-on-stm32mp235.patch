From a6bd437473abb3cdaa5d70431e9d91a5fac48c75 Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Wed, 12 Aug 2026 11:01:50 +0200
Subject: [PATCH] arm64: dts: st: switch typec to dual role on stm32mp235f-dk

Switch USB Type-C connector to dual role mode now that the tcpp and
ucpd drivers supports it. IRQs may report Vbus change on TCPP when
in LP mode on both edges, so change to both edges.
When acting as a source, the board can deliver up to 1.5A.

Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: I81bec55a9cda6b4527e33ac8ab196957ac96c0e1
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/598895
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp235f-dk.dts | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

--- a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
@@ -396,7 +396,7 @@
 		reg = <0x34>;
 		enable-gpios = <&gpioa 3 GPIO_ACTIVE_HIGH>;
 		interrupt-parent = <&gpiog>;
-		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
+		interrupts = <1 IRQ_TYPE_EDGE_BOTH>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&tcpp_flgn_pins_a>;
 		status = "okay";
@@ -762,9 +762,10 @@
 	connector {
 		compatible = "usb-c-connector";
 		label = "USB-C";
-		data-role = "device";
-		power-role = "sink";
-		typec-power-opmode = "default";
+		data-role = "dual";
+		power-role = "dual";
+		try-power-role = "sink";
+		typec-power-opmode = "1.5A";
 		pd-disable;
 		self-powered;
 		port {
