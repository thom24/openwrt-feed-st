From 141f1e1ee98dbc3c3aa876717034724e919f880e Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Wed, 13 May 2026 17:36:29 +0200
Subject: [PATCH] arm64: dts: st: add USB3DR support for stm32mp235f-dk board

Add usb3dr node for USB3-DWC3 support for stm32mp235f-dk board.
Enable usb-role-switch on stm32mp235f-dk, to support dual role USB2
with power delivery on Type-C connector.

Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: I31a226cfe2323a59667a29b05d0ced0353218351
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/568990
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp235f-dk.dts | 30 +++++++++++++++++++++++
 1 file changed, 30 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
@@ -588,6 +588,23 @@
 		#address-cells = <1>;
 		#size-cells = <0>;
 		status = "okay";
+
+		typec@35 {
+			compatible = "st,stm32mp25-typec";
+			reg = <0x35>;
+			interrupts-extended = <&intc_rpmsg 0>;
+			status = "okay";
+			connector {
+				compatible = "usb-c-connector";
+				label = "USB-C";
+
+				port {
+					typec_ep: endpoint {
+						remote-endpoint = <&dwc3_ep>;
+					};
+				};
+			};
+		};
 	};
 };
 
@@ -811,6 +828,19 @@
 	status = "okay";
 };
 
+&usb3dr {
+	status = "okay";
+
+	dwc3: usb@48300000 {
+		usb-role-switch;
+		port {
+			dwc3_ep: endpoint {
+				remote-endpoint = <&typec_ep>;
+			};
+		};
+	};
+};
+
 &usbh {
 	status = "okay";
 
