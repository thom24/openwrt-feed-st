From 801171e56796286a21993d75fd434d6e1d56670e Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Jan 2025 15:32:12 +0100
Subject: [PATCH] tee: optee: fix uninitialized variables in
 optee_invoke_func_helper

Correct LLVM warnings found with -Wsometimes-uninitialized on variables
'offs' and 'shm'.

variable 'offs' is used uninitialized whenever 'if' condition is true
initialize the variable 'offs' to silence this warning
variable 'shm' is used uninitialized whenever 'if' condition is true
remove the 'if' if its condition is always false

Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Change-Id: I688796f4ab196f36691aaa812ca54cf91a63b721
---
 drivers/tee/optee/call.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

--- a/drivers/tee/optee/call.c
+++ b/drivers/tee/optee/call.c
@@ -531,10 +531,10 @@ int optee_invoke_func_helper(struct tee_
 	struct optee_call_extra call_extra;
 	struct optee_shm_arg_entry *entry;
 	struct optee_session *sess;
-	struct tee_shm *shm;
+	struct tee_shm *shm = NULL;
 	bool system_thread;
 	u32 session_id;
-	u_int offs;
+	u_int offs = 0;
 	int rc;
 
 	if (tee_ocall_in_progress(ocall_arg))
