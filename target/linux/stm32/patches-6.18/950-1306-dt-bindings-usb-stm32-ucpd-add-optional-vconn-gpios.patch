From c925a886b946348419d79ef88e9619575d67af7c Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Tue, 11 Aug 2026 11:09:42 +0200
Subject: [PATCH] dt-bindings: usb: stm32 ucpd: add optional vconn gpios

Add optional gpios to drive external gates to supply Vconn on CC1
or CC2 line. To support USB3 devices, Vconn shall be able to provide
up to 1W. Additional gates driven through GPIOs can be used to drive
Vconn, in addition to TCPP02/3.

Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: I2cac6b7dc368462d3faa651f27a54b7dd35abab4
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/598894
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
---
 .../devicetree/bindings/usb/st,stm32-ucpd.yaml      | 13 +++++++++++++
 1 file changed, 13 insertions(+)

--- a/Documentation/devicetree/bindings/usb/st,stm32-ucpd.yaml
+++ b/Documentation/devicetree/bindings/usb/st,stm32-ucpd.yaml
@@ -63,6 +63,15 @@ properties:
   ucpd-supply:
     description: phandle to the UCPD regulator supply.
 
+  vconn-cc1-gpios:
+    description: Vconn on CC1 gate enable GPIO.
+
+  vconn-cc2-gpios:
+    description: Vconn on CC2 gate enable GPIO.
+
+  vconn-supply:
+    description: phandle to the regulator supplying Vconn gates.
+
   connector:
     type: object
     $ref: ../connector/usb-connector.yaml#
@@ -86,6 +95,7 @@ additionalProperties: false
 examples:
   - |
     #include <dt-bindings/clock/st,stm32mp25-rcc.h>
+    #include <dt-bindings/gpio/gpio.h>
     #include <dt-bindings/interrupt-controller/arm-gic.h>
     #include <dt-bindings/reset/st,stm32mp25-rcc.h>
 
@@ -101,6 +111,9 @@ examples:
         access-controllers = <&rifsc 69>;
         power-domains = <&d1_pd>;
         ucpd-supply = <&scmi_vdd33ucpd>;
+        vconn-cc1-gpios = <&gpiof 5 GPIO_ACTIVE_HIGH>;
+        vconn-cc2-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
+        vconn-supply = <&vconn>;
         st,tcpp = <&tcpp03>;
 
         connector {
