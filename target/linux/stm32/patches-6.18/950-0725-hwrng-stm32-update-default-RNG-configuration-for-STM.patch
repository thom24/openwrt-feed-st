From 2150b48a08f8ea761a2e6672f7f6749b17bfdbd7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Fri, 31 Jan 2025 11:44:50 +0100
Subject: [PATCH] hwrng: stm32 - update default RNG configuration for STM32MP25
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Use the configuration used for the NIST certification.

Change-Id: I4f2c8ddfd013ba5eb5aa533002fbd35fe27d7145
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/433397
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 drivers/char/hw_random/stm32-rng.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

--- a/drivers/char/hw_random/stm32-rng.c
+++ b/drivers/char/hw_random/stm32-rng.c
@@ -514,9 +514,9 @@ static const struct stm32_rng_data stm32
 	.max_clock_rate = 48000000,
 	.nb_clock = 2,
 	.cr_config1_mask = GENMASK(27, 20),
-	.cr = 0x00F00D00,
-	.nscr = 0x2B5BB,
-	.htcr = 0x969D,
+	.cr = 0x08F01E00,
+	.nscr = 0x2E649,
+	.htcr = 0x6688,
 };
 
 static const struct stm32_rng_data stm32mp21_rng_data = {
