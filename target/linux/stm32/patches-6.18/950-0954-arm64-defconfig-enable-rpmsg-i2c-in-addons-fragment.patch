From 3f4d7ac12892d8c7eff6673f2e9a0acc899d025d Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Fri, 2 Dec 2022 17:18:27 +0100
Subject: [PATCH] arm64: defconfig: enable rpmsg-i2c in addons fragment

Add the support of the I2C adapter over rpmsg.

Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: If9c751eaea98245854fd32f085d5aa749df304f4
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/552541
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Tested-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
---
 arch/arm64/configs/fragment-02-defconfig-addons.config | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/fragment-02-defconfig-addons.config b/arch/arm64/configs/fragment-02-defconfig-addons.config
index f382f92cc03f..27c7cb8a4e65 100644
--- a/arch/arm64/configs/fragment-02-defconfig-addons.config
+++ b/arch/arm64/configs/fragment-02-defconfig-addons.config
@@ -19,6 +19,7 @@ CONFIG_DWMAC_GENERIC=y
 CONFIG_DWMAC_STM32=y
 CONFIG_DYNAMIC_DEBUG=y
 CONFIG_GENERIC_IRQ_DEBUGFS=y
+CONFIG_I2C_RPMSG=m
 CONFIG_I2C_STM32F7=m
 CONFIG_I3C=y
 CONFIG_IGC=m
-- 
