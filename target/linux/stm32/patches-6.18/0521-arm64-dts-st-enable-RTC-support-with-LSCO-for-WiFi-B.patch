From 59495e5a62e116f0d0afd8e2b1141ef5e2f2f2e5 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Wed, 18 Feb 2026 15:24:45 +0100
Subject: [PATCH] arm64: dts: st: enable RTC support with LSCO for WiFi/BT on
 stm32mp257f-dk

Enables the support of RTC on stm32mp257f-dk board and declare RTC as LSCO
clock provider for Wifi/BT on this board.
WiFi/BT module LPO_32 pin is wired to RTC OUT2_RMP pin.
Add rtc_lsco_pins_a to the pinctrl property of the RTC node because RTC
pinctrl has strict mode enabled. WiFi and Bluetooth drivers cannot both
request it, as their probe order is not guaranteed to ensure LSCO is
available during each probe.

Change-Id: I7f5e4d5549d063e9727ded93feb3c3ec9f66c46e
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/538137
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Antonio Maria BORNEO <antonio.borneo@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
index 26ba43d0592a..d74d06123b52 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -74,6 +74,8 @@ memory@80000000 {
 	wifi_pwrseq: wifi-pwrseq {
 		compatible = "mmc-pwrseq-simple";
 		reset-gpios = <&gpiog 8 GPIO_ACTIVE_LOW>;
+		clocks = <&rtc>;
+		clock-names = "ext_clock";
 	};
 };
 
@@ -276,6 +278,18 @@ &rifsc {
 	bootph-all;
 };
 
+&rtc {
+	#clock-cells = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&rtc_rsvd_pins_a &rtc_lsco_pins_a>;
+	status = "okay";
+
+	rtc_lsco_pins_a: rtc-lsco-0 {
+		pins = "out2_rmp";
+		function = "lsco";
+	};
+};
+
 &scmi {
 	bootph-all;
 };
-- 
