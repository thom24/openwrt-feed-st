From 516680c6b7409d1bc93d398a7f8025cb6d76529b Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Mon, 1 Jun 2026 14:22:08 +0200
Subject: [PATCH] ARM: dts: stm32: load mac address from NVMEM for STM32MP15
 DK2 boards

It is useful to read the OTP value with NVMEM if the MAC address
is not provided in the device tree by the BootLoader

Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Change-Id: I8cdf073e0c58f79c1b0e51e50b23128ed1d16ef7
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559356
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
index e8804b967d43..63c22d398cf4 100644
--- a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
@@ -9,6 +9,7 @@
 
 / {
 	aliases {
+		ethernet0 = &ethernet0;
 		serial0 = &uart4;
 		serial1 = &usart3;
 		serial2 = &uart7;
@@ -224,6 +225,8 @@ &ethernet0 {
 	phy-mode = "rgmii-id";
 	max-speed = <1000>;
 	phy-handle = <&phy0>;
+	nvmem-cells = <&ethernet_mac_address>;
+	nvmem-cell-names = "mac-address";
 
 	mdio {
 		#address-cells = <1>;
-- 
2.53.0

