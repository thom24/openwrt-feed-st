From e62ba824b5fe837909729316aaaf676b017ef66a Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 9 Jan 2024 16:58:40 +0100
Subject: [PATCH] arm64: dts: st: add wake-up button on stm32mp25 boards

Adds wake-up button, that comes from OPTEE interrupt number ZERO.

Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I10b522b90640518c311b4a78c1933d51db53f48b
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/350297
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/368872
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/552078
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/553531
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Tested-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts  | 8 ++++++++
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 8 ++++++++
 2 files changed, 16 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -43,6 +43,14 @@
 			gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>;
 			status = "disabled";
 		};
+
+		button-wake-up {
+			label = "wake-up";
+			linux,code = <KEY_WAKEUP>;
+			interrupts-extended = <&optee 0>;
+			wakeup-source;
+			status = "okay";
+		};
 	};
 
 	gpio-leds {
--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -59,6 +59,14 @@
 			gpios = <&gpiog 8 GPIO_ACTIVE_HIGH>;
 			status = "disabled";
 		};
+
+		button-wake-up {
+			label = "wake-up";
+			linux,code = <KEY_WAKEUP>;
+			interrupts-extended = <&optee 0>;
+			wakeup-source;
+			status = "okay";
+		};
 	};
 
 	imx335_2v9: regulator-2v9 {
