From cb65a30c0daf4478c907da9eebd1022e944716ae Mon Sep 17 00:00:00 2001
From: Patrice Chotard <patrice.chotard@foss.st.com>
Date: Thu, 16 Nov 2023 17:51:04 +0100
Subject: [PATCH] arm64: dts: st: add USB3DR support for stm32mp257f-dk board

Add usb3dr node for USB3-DWC3 support for stm32mp257f-dk board
Add the required node(s) for USB3-DWC3 Superspeed support : COMBOPHY
Add combo-phy handle in USB3DR node (turn on SSC)
Enable usb-role-switch on stm32mp257f-dk, to support dual role USB2
with power delivery on Type-C connector.
There's a dependency on the type-c connector controller, to enable
and manage the super speed switch (orientation).

Signed-off-by: Olivier BIDEAU <olivier.bideau@st.com>
Signed-off-by: Patrice Chotard <patrice.chotard@foss.st.com>
Signed-off-by: Pankaj Dev <pankaj.dev@st.com>
Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: Iabdcf799214622a78a43209532a4ce1e5301ce15
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/568991
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts | 37 +++++++++++++++++++++++
 1 file changed, 37 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -224,6 +224,11 @@
 	bootph-all;
 };
 
+&combophy {
+	st,ssc-on;
+	status = "okay";
+};
+
 &cryp1 {
 	status = "okay";
 };
@@ -737,6 +742,23 @@
 		#address-cells = <1>;
 		#size-cells = <0>;
 		status = "okay";
+
+		typec@35 {
+			compatible = "st,stm32mp25-typec";
+			reg = <0x35>;
+			interrupts-extended = <&intc_rpmsg 0>;
+			status = "okay";
+			connector {
+				compatible = "usb-c-connector";
+				label = "USB-C";
+
+				port {
+					typec_ep: endpoint {
+						remote-endpoint = <&dwc3_ep>;
+					};
+				};
+			};
+		};
 	};
 };
 
@@ -967,6 +989,21 @@
 	status = "okay";
 };
 
+&usb3dr {
+	status = "okay";
+
+	dwc3: usb@48300000 {
+		phys = <&usb2_phy2>, <&combophy PHY_TYPE_USB3>;
+		phy-names = "usb2-phy", "usb3-phy";
+		usb-role-switch;
+		port {
+			dwc3_ep: endpoint {
+				remote-endpoint = <&typec_ep>;
+			};
+		};
+	};
+};
+
 &usbh {
 	status = "okay";
 
