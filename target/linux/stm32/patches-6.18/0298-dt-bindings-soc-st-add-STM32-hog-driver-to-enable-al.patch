 1 file changed, 68 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/st/st,stm32-hog.yaml

diff --git a/Documentation/devicetree/bindings/soc/st/st,stm32-hog.yaml b/Documentation/devicetree/bindings/soc/st/st,stm32-hog.yaml
