From 8aa5520b836ff95b3bb2dbfaec8cace1abab9864 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Tue, 24 Feb 2026 15:30:28 +0100
Subject: [PATCH] arm64: dts: st: add memory-region in HPDMA nodes on
 stm32mp215f-dk board

Linked-List Items (LLI) can be allocated in internal RAM defined under
the reserved-memory node.
Force Linked-list Allocated Port (LAP) to second port (AHB).

Change-Id: Ia62ae655e1f09de0d1d51a7b73e6aacb42c49741
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/540273
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp215f-dk.dts | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
@@ -175,6 +175,21 @@
 	bootph-all;
 };
 
+&hpdma {
+	memory-region = <&hpdma1_lli>;
+	lli-bus-interface = <1>;
+};
+
+&hpdma2 {
+	memory-region = <&hpdma2_lli>;
+	lli-bus-interface = <1>;
+};
+
+&hpdma3 {
+	memory-region = <&hpdma3_lli>;
+	lli-bus-interface = <1>;
+};
+
 &i2c2 {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&i2c2_pins_a>;
