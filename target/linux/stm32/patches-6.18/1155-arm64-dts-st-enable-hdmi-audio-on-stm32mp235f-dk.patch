From 334188fbce861a755c26fbf4064264035b402146 Mon Sep 17 00:00:00 2001
From: Olivier Moysan <olivier.moysan@foss.st.com>
Date: Mon, 29 Jun 2026 16:48:45 +0200
Subject: [PATCH] arm64: dts: st: enable hdmi audio on stm32mp235f-dk

Add HDMI audio support on STM32mp235F-DK board.

Signed-off-by: Olivier Moysan <olivier.moysan@foss.st.com>
Change-Id: Ia6b31066825f16403687a257abdb34e218fec053
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/583104
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp235f-dk.dts | 29 +++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
index f3eaa6a84f1d..52f443d9ea5e 100644
--- a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
@@ -151,6 +151,13 @@ panel_lvds_backlight: panel-lvds-backlight {
 		status = "okay";
 	};
 
+	sound {
+		compatible = "audio-graph-card";
+		label = "STM32MP23-DK";
+		dais = <&i2s2_port>;
+		status = "okay";
+	};
+
 	wifi_pwrseq: wifi-pwrseq {
 		compatible = "mmc-pwrseq-simple";
 		reset-gpios = <&gpiog 8 GPIO_ACTIVE_LOW>;
@@ -441,6 +448,13 @@ adv7535_out: endpoint {
 					remote-endpoint = <&hdmi_connector_in>;
 				};
 			};
+
+			port@2 {
+				reg = <2>;
+				adv7535_tx_endpoint: endpoint {
+					remote-endpoint = <&i2s2_endpoint>;
+				};
+			};
 		};
 	};
 
@@ -467,6 +481,21 @@ &i2c8 {
 	/delete-property/dma-names;
 };
 
+&i2s2 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&i2s2_pins_b>;
+	pinctrl-1 = <&i2s2_sleep_pins_b>;
+	status = "okay";
+
+	i2s2_port: port {
+		i2s2_endpoint: endpoint {
+			remote-endpoint = <&adv7535_tx_endpoint>;
+			dai-format = "i2s";
+			mclk-fs = <256>;
+		};
+	};
+};
+
 &i3c4 {
 	pinctrl-names = "default", "init", "sleep";
 	pinctrl-0 = <&i3c4_pins_b>;
-- 
2.53.0

