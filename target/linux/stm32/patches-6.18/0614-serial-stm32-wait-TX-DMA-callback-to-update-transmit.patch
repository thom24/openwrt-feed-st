From 11c01b59282057f82a3772068a7e1f0e26f3aa13 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Tue, 14 Oct 2025 15:29:36 +0200
Subject: [PATCH] serial: stm32: wait TX DMA callback to update transmit buffer
 offset

Ensure the transmit buffer is advanced only after the DMA transfer is truly
complete, not when it starts. This guarantees the TTY layer waits for the
DMA transfer to finish before closing the port, preventing data loss.
Keep track of bytes transferred by DMA in stm32port->tx_dma_bytes. Use this
in the TX DMA callback to update transfer buffer offset with
uart_xmit_advance(), and wake up the write workqueue with
uart_write_wakeup() to notify the TTY layer of the actual number of bytes
sent by DMA.

Change-Id: I23de46c57c1e054eba3509484404b5e1269872e0
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/499684
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Valentin CARON <valentin.caron@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
---
 drivers/tty/serial/stm32-usart.c | 14 +++++++++++---
 drivers/tty/serial/stm32-usart.h |  1 +
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/tty/serial/stm32-usart.c b/drivers/tty/serial/stm32-usart.c
index ffa6914714bd..9843fa1b2d23 100644
--- a/drivers/tty/serial/stm32-usart.c
+++ b/drivers/tty/serial/stm32-usart.c
@@ -818,15 +818,24 @@ static void stm32_usart_tx_dma_complete(void *arg)
 {
 	struct uart_port *port = arg;
 	struct stm32_port *stm32port = to_stm32_port(port);
+	struct tty_port *tport = &port->state->port;
 	unsigned long flags;
 
 	stm32_usart_tx_dma_terminate(stm32port);
 
 	pm_runtime_get(port->dev);
 
-	/* Let's see if we have pending data to send */
 	uart_port_lock_irqsave(port, &flags);
+
+	/* Update TX status */
+	uart_xmit_advance(port, stm32port->tx_dma_bytes);
+	stm32port->tx_dma_bytes = 0;
+	if (kfifo_len(&tport->xmit_fifo) < WAKEUP_CHARS)
+		uart_write_wakeup(port);
+
+	/* Let's see if we have pending data to send */
 	stm32_usart_transmit_chars(port);
+
 	uart_port_unlock_irqrestore(port, flags);
 
 	pm_runtime_put_autosuspend(port->dev);
@@ -940,6 +949,7 @@ static void stm32_usart_transmit_chars_dma(struct uart_port *port)
 	 * if the callback of the previous is not yet called.
 	 */
 	stm32port->tx_dma_busy = true;
+	stm32port->tx_dma_bytes = count;
 
 	desc->callback = stm32_usart_tx_dma_complete;
 	desc->callback_param = port;
@@ -956,8 +966,6 @@ static void stm32_usart_transmit_chars_dma(struct uart_port *port)
 	/* Issue pending DMA TX requests */
 	dma_async_issue_pending(stm32port->tx_ch);
 
-	uart_xmit_advance(port, count);
-
 	return;
 
 fallback_err:
diff --git a/drivers/tty/serial/stm32-usart.h b/drivers/tty/serial/stm32-usart.h
index 083e8163214b..fa89c515de9a 100644
--- a/drivers/tty/serial/stm32-usart.h
+++ b/drivers/tty/serial/stm32-usart.h
@@ -236,6 +236,7 @@ struct stm32_port {
 	u32 cr1_irq;		 /* USART_CR1_RXNEIE or RTOIE */
 	u32 cr3_irq;		 /* USART_CR3_RXFTIE */
 	int last_res;
+	unsigned int tx_dma_bytes;
 	bool tx_dma_busy;	 /* dma tx transaction in progress */
 	bool rx_dma_busy;	 /* dma rx transaction in progress */
 	bool throttled;		 /* port throttled            */
-- 
