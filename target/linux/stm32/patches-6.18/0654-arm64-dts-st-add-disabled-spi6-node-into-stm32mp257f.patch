From 748f57c28aae6b3effaccf92b5d5c583892901da Mon Sep 17 00:00:00 2001
From: Alain Volmat <alain.volmat@foss.st.com>
Date: Wed, 22 May 2024 21:47:06 +0200
Subject: [PATCH] arm64: dts: st: add disabled spi6 node into stm32mp257f-dk

Add a disabled spi6 node for the spi6 instance available via
the GPIO expansion connector on the stm32mp257f-dk board.

Signed-off-by: Alain Volmat <alain.volmat@foss.st.com>
Change-Id: Ia50cb11a8b8c30b25cd67de2f2dc38c160918b51
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/537883
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Tested-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
index c1263a2521f6..5d42b2052e92 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -401,6 +401,13 @@ brcmf: wifi@1 {
 	};
 };
 
+&spi6 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&spi6_pins_a>;
+	pinctrl-1 = <&spi6_sleep_pins_a>;
+	status = "disabled";
+};
+
 &syscfg {
 	bootph-all;
 };
-- 
2.53.0

