From 58600e2ba4ab1ecb4bb319804204690a1f1154d8 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Tue, 16 Nov 2021 17:04:33 +0100
Subject: [PATCH] ARM: dts: stm32: add simple-framebuffer on stm32mp157 DK2
 boards

Add node to support the simple-frambuffer. By default, the node must be
disabled.

Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Change-Id: I355d59f55ea526c21ba2eb819cc03ff4c809525b
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/570672
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm/boot/dts/st/stm32mp157c-dk2-no-scmi.dts | 9 +++++++++
 arch/arm/boot/dts/st/stm32mp157f-dk2.dts         | 9 +++++++++
 2 files changed, 18 insertions(+)

--- a/arch/arm/boot/dts/st/stm32mp157c-dk2-no-scmi.dts
+++ b/arch/arm/boot/dts/st/stm32mp157c-dk2-no-scmi.dts
@@ -22,7 +22,16 @@
 	};
 
 	chosen {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
 		stdout-path = "serial0:115200n8";
+
+		framebuffer {
+			compatible = "simple-framebuffer";
+			clocks = <&rcc LTDC_PX>, <&rcc DSI>, <&rcc DSI_PX>;
+			status = "disabled";
+		};
 	};
 
 	wifi_pwrseq: wifi-pwrseq {
--- a/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
+++ b/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
@@ -23,7 +23,16 @@
 	};
 
 	chosen {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
 		stdout-path = "serial0:115200n8";
+
+		framebuffer {
+			compatible = "simple-framebuffer";
+			clocks = <&rcc LTDC_PX>, <&rcc DSI>, <&rcc DSI_PX>;
+			status = "disabled";
+		};
 	};
 
 	reserved-memory {
