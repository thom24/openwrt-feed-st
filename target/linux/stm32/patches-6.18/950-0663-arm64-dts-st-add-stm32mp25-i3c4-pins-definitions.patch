From 3c658c1963074fb6ed5ebae59310d74cceeb9457 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Thu, 10 Aug 2023 16:23:53 +0200
Subject: [PATCH] arm64: dts: st: add stm32mp25 i3c4 pins definitions

STM32 I3C requires 3 states of pinctrl: init, default and sleep.
Init state is needed when enabling the controller, to avoid generating an
unexpected frame (I3C-211213 erratum).

Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: I04a8eca12772db2d0574b8b21ee0d41d2ae0ddf4
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/545081
Tested-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp25-pinctrl.dtsi | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp25-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp25-pinctrl.dtsi
@@ -838,6 +838,41 @@
 	};
 
 	/omit-if-no-ref/
+	i3c4_pins_a: i3c4-0 {
+		pins {
+			pinmux = <STM32_PINMUX('Z', 4, AF11)>, /* I3C4_SCL */
+				 <STM32_PINMUX('Z', 3, AF11)>; /* I3C4_SDA */
+			drive-push-pull;
+			bias-disable;
+			slew-rate = <3>;
+		};
+	};
+
+	/omit-if-no-ref/
+	i3c4_init_pins_a: i3c4-init-0 {
+		pins1 {
+			pinmux = <STM32_PINMUX('Z', 4, AF11)>; /* I3C4_SCL */
+			drive-push-pull;
+			bias-disable;
+			slew-rate = <1>;
+		};
+		pins2 {
+			pinmux = <STM32_PINMUX('Z', 3, AF11)>; /* I3C4_SDA */
+			drive-push-pull;
+			bias-pull-up;
+			slew-rate = <1>;
+		};
+	};
+
+	/omit-if-no-ref/
+	i3c4_sleep_pins_a: i3c4-sleep-0 {
+		pins {
+			pinmux = <STM32_PINMUX('Z', 4, ANALOG)>, /* I3C4_SCL */
+				 <STM32_PINMUX('Z', 3, ANALOG)>; /* I3C4_SDA */
+		};
+	};
+
+	/omit-if-no-ref/
 	lpuart1_pins_a: lpuart1-0 {
 		pins1 {
 			pinmux = <STM32_PINMUX('Z', 7, AF6)>, /* LPUART1_TX */
