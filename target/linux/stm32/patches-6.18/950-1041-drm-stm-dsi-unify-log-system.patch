 				       unsigned long *parent_rate)
 {
 	struct dw_mipi_dsi_stm *dsi = clk_to_dw_mipi_dsi_stm(hw);
+	struct device *dev = dsi->dev;
 	unsigned int idf, ndiv, odf, pll_in_khz, pll_out_khz;
