-	DRM_DEBUG_DRIVER("\n");
+	dev_dbg(dev, "\n");
 
 	pll_in_khz = (unsigned int)(*parent_rate / 1000);
 
@@ -721,7 +733,7 @@ static long dw_mipi_dsi_phy_141_clk_round_rate(struct clk_hw *hw, unsigned long
 	ret = dsi_phy_141_pll_get_params(dsi, pll_in_khz, rate / 1000,
