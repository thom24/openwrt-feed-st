From 1afc4896a53191caa8ab40c8f09aec3d72ade599 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Thu, 9 Jul 2026 14:55:26 +0200
Subject: [PATCH] net: phy realtek: implement .disable_autonomous_eee for
 RTL8211E

Use the new .disable_autonomous_eee callback so PHY-mode EEE is disabled
when the MAC indicates EEE support via phy_support_eee().
This preserves PHY-autonomous EEE for MACs that do not support EEE,
while still disabling it when the MAC managed LPI.

Change-Id: I6f017e8e43d845a97df78628887fb8a868b29ecf
Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/591247
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 drivers/net/phy/realtek/realtek_main.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/net/phy/realtek/realtek_main.c b/drivers/net/phy/realtek/realtek_main.c
index 927eff2824d0..6fceb77334c2 100644
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -998,6 +998,16 @@ static int rtl8211e_led_hw_control_set(struct phy_device *phydev, u8 index,
 	return ret;
 }
 
+static int rtl8211e_disable_autonomous_eee(struct phy_device *phydev)
+{
+	/* Keep RTL8211E from advertising EEE to avoid RXC stop windows during
+	 * early MAC initialization on platforms that are sensitive to it.
+	 */
+	phy_disable_eee(phydev);
+
+	return 0;
+}
+
 static int rtl8211e_config_init(struct phy_device *phydev)
 {
 	u16 val;
@@ -1815,6 +1825,7 @@ static struct phy_driver realtek_drvs[] = {
 		.led_hw_is_supported = rtl8211x_led_hw_is_supported,
 		.led_hw_control_get = rtl8211e_led_hw_control_get,
 		.led_hw_control_set = rtl8211e_led_hw_control_set,
+		.disable_autonomous_eee = rtl8211e_disable_autonomous_eee,
 	}, {
 		PHY_ID_MATCH_EXACT(0x001cc916),
 		.name		= "RTL8211F Gigabit Ethernet",
-- 
2.53.0

