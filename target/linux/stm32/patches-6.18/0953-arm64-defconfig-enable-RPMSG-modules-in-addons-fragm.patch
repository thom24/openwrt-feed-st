From 63b7773c875ffa37ea41fd81a7b445000fd39bdc Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Wed, 21 Apr 2021 13:24:44 +0200
Subject: [PATCH] arm64: defconfig: enable RPMSG modules in addons fragment

This patch adds in the rpmsg drivers used by STM32MP SOCs.

Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: I5b52a3ea7a55acbc231fdc27e14a14bc01d1fa87
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/552540
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
Tested-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/configs/fragment-02-defconfig-addons.config | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/configs/fragment-02-defconfig-addons.config b/arch/arm64/configs/fragment-02-defconfig-addons.config
index 1af4b47f26b2..f382f92cc03f 100644
--- a/arch/arm64/configs/fragment-02-defconfig-addons.config
+++ b/arch/arm64/configs/fragment-02-defconfig-addons.config
@@ -58,6 +58,8 @@ CONFIG_REGULATOR_ARM_SCMI=y
 CONFIG_REGULATOR_WM8994=m
 CONFIG_REMOTEPROC=y
 CONFIG_RESET_GPIO=y
+CONFIG_RPMSG_CHAR=m
+CONFIG_RPMSG_CTRL=m
 CONFIG_RPMSG_IRQ=m
 CONFIG_RPMSG_TTY=m
 CONFIG_RPMSG_VIRTIO=m
-- 
2.53.0

