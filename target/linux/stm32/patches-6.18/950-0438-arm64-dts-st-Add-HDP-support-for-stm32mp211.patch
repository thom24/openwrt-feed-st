From 53d168412c9d2cbcb9bf51f1611b6914cf2cc861 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Fri, 15 May 2026 17:03:21 +0200
Subject: [PATCH] arm64: dts: st: Add HDP support for stm32mp211

Add the node of the HDP peripheral.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I6a683ca0a933716491c6d2d7fbd38838a138e1dd
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/568324
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp211.dtsi b/arch/arm64/boot/dts/st/stm32mp211.dtsi
index cefe47cca86d..a63cd846a4c7 100644
--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -317,6 +317,14 @@ risab5: risab@42130000 {
 			st,mem-map = <0x0a040000 0x20000>;
 		};
 
+		hdp: pinctrl@44090000 {
+			compatible = "st,stm32mp211-hdp";
+			reg = <0x44090000 0x0 0x400>;
+			clocks = <&rcc CK_BUS_HDP>;
+			access-controllers = <&dbg_bus 1>, <&rifsc 57>;
+			status = "disabled";
+		};
+
 		rcc: clock-controller@44200000 {
 			compatible = "st,stm32mp21-rcc";
 			reg = <0x44200000 0x0 0x10000>;
-- 
2.53.0

