From c2b6cb48e37352fd4cea90e6d1cd02e6ec72d3f7 Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Thu, 16 Apr 2026 15:49:10 +0200
Subject: [PATCH] ARM: dts: stm32: add WoL support within stm32mp151.dtsi

Add wakeup-source property and exti to manage WoL (Wake On LAN)

Change-Id: Ia12165fe000629461499ecb57176ce65469a1ba4
Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559350
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm/boot/dts/st/stm32mp151.dtsi | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/st/stm32mp151.dtsi b/arch/arm/boot/dts/st/stm32mp151.dtsi
index 41850a76c228..a0c9a186416d 100644
--- a/arch/arm/boot/dts/st/stm32mp151.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp151.dtsi
@@ -2141,8 +2141,10 @@ ethernet0: ethernet@5800a000 {
 				compatible = "st,stm32mp1-dwmac", "snps,dwmac-4.20a";
 				reg = <0x5800a000 0x2000>;
 				reg-names = "stmmaceth";
-				interrupts-extended = <&intc GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
-				interrupt-names = "macirq";
+				interrupts-extended = <&intc GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>,
+						      <&exti 70 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "macirq",
+						  "eth_wake_irq";
 				clock-names = "stmmaceth",
 					      "mac-clk-tx",
 					      "mac-clk-rx",
@@ -2160,6 +2162,7 @@ ethernet0: ethernet@5800a000 {
 				snps,pbl = <2>;
 				snps,axi-config = <&stmmac_axi_config_0>;
 				snps,tso;
+				wakeup-source;
 				access-controllers = <&etzpc 94>;
 				status = "disabled";
 
-- 
2.53.0

