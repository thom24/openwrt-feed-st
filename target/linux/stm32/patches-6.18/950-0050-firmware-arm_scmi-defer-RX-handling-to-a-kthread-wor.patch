From 65530b7c2be8ada775f9616afaadeb63059c6061 Mon Sep 17 00:00:00 2001
From: Christophe Kerello <christophe.kerello@foss.st.com>
Date: Fri, 26 Jun 2026 09:35:52 +0200
Subject: [PATCH] firmware: arm_scmi: defer RX handling to a kthread work item

With mailbox controllers that acknowledge the RX channel to the remote
only *after* the rx_callback returns (e.g. STM32 IPCC in its "interrupt
context" mode, which writes IPCC_XSCR after calling
mbox_chan_received_data()), handling the response synchronously inside
the controller IRQ-thread context opens a race:

  CPU0 (mbox IRQ thread)            CPU1 (SCMI requester)
  -----------------------          ---------------------
  rx_callback()
    scmi_handle_response()
      fetch_response()
      complete(&xfer->done)  -----> wakes up
                                    mark_txdone() / unlock
                                    do_xfer() N+1
                                    send_message() N+1
                             <----- remote receives N+1
                                    remote tries to reply but its
                                    TX channel is still occupied
  <ack RX channel here>             (XSCR not written yet) -> stuck
                                    -> SCMI timeout

The requester is woken (and can issue the next request) before the
controller has acknowledged the RX channel, so the remote cannot post
its next response and the transaction times out.

Defer the actual message handling - which ends up calling complete() -
out of the controller IRQ-thread context by queueing it on the high
priority (kthread) workqueue. A softirq (BH) workqueue must not be used
here: a BH work item is drained from softirq processing, including from
irq_exit(), so an unrelated interrupt landing on the same CPU between
the queue_work() call and the IPCC_XSCR write could run the deferred
handling - and thus complete() - through that nested irq_exit(), still
before the RX channel is acked, reopening the very race.

A kthread worker instead cannot run until it is scheduled and is never
drained from irq_exit(); as the controller IRQ thread runs at RT
priority it is not preempted by the SCHED_NORMAL highpri worker, so it
returns from its handler (and acknowledges the RX channel) before the
requester is woken. system_highpri_wq is per-CPU, so the worker runs on
the queueing CPU and cannot race the ack from another core, keeping the
guarantee valid on SMP as well.

The message stays in shared memory until handled: the SCMI channel
ownership (channel_status), cleared by the worker, prevents the remote
from overwriting it before the next request is sent, which is itself
gated behind the deferred completion.

Change-Id: Ie6221059018b749ca967fbee9ba0d65cd2e9232a
Signed-off-by: Christophe Kerello <christophe.kerello@foss.st.com>
Assisted-by: GitHub-Copilot:Claude-Opus-4.8
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/582623
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/588755
Reviewed-by: Christophe KERELLO <christophe.kerello@st.com>
Tested-by: Christophe KERELLO <christophe.kerello@st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 .../firmware/arm_scmi/transports/mailbox.c    | 26 +++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/drivers/firmware/arm_scmi/transports/mailbox.c b/drivers/firmware/arm_scmi/transports/mailbox.c
index ae0f67e6cc45..5545785a6684 100644
--- a/drivers/firmware/arm_scmi/transports/mailbox.c
+++ b/drivers/firmware/arm_scmi/transports/mailbox.c
@@ -13,6 +13,7 @@
 #include <linux/of_address.h>
 #include <linux/platform_device.h>
 #include <linux/slab.h>
+#include <linux/workqueue.h>
 
 #include "../common.h"
 
@@ -27,6 +28,8 @@
  * @shmem: Transmit/Receive shared memory area
  * @chan_lock: Lock that prevents multiple xfers from being queued
  * @io_ops: Transport specific I/O operations
+ * @rx_work: Work used to defer RX message handling out of the mailbox
+ *	     controller IRQ-thread context (see rx_callback())
  */
 struct scmi_mailbox {
 	struct mbox_client cl;
@@ -37,9 +40,11 @@ struct scmi_mailbox {
 	struct scmi_shared_mem __iomem *shmem;
 	struct mutex chan_lock;
 	struct scmi_shmem_io_ops *io_ops;
+	struct work_struct rx_work;
 };
 
 #define client_to_scmi_mailbox(c) container_of(c, struct scmi_mailbox, cl)
+#define work_to_scmi_mailbox(w) container_of(w, struct scmi_mailbox, rx_work)
 
 static struct scmi_transport_core_operations *core;
 
@@ -51,6 +56,14 @@ static void tx_prepare(struct mbox_client *cl, void *m)
 				smbox->io_ops->toio);
 }
 
+static void rx_work_fn(struct work_struct *work)
+{
+	struct scmi_mailbox *smbox = work_to_scmi_mailbox(work);
+
+	core->rx_callback(smbox->cinfo,
+			  core->shmem->read_header(smbox->shmem), NULL);
+}
+
 static void rx_callback(struct mbox_client *cl, void *m)
 {
 	struct scmi_mailbox *smbox = client_to_scmi_mailbox(cl);
@@ -73,8 +86,14 @@ static void rx_callback(struct mbox_client *cl, void *m)
 		return;
 	}
 
-	core->rx_callback(smbox->cinfo,
-		      core->shmem->read_header(smbox->shmem), NULL);
+	/*
+	 * Defer the handling (which calls complete()) out of the controller
+	 * IRQ-thread context: some controllers ack the RX channel to the
+	 * remote only after this callback returns, so waking the requester
+	 * inline would let it send the next request before the remote's TX
+	 * channel is freed. The message stays in shmem until handled.
+	 */
+	queue_work(system_highpri_wq, &smbox->rx_work);
 }
 
 static bool mailbox_chan_available(struct device_node *of_node, int idx)
@@ -211,6 +230,8 @@ static int mailbox_chan_setup(struct scmi_chan_info *cinfo, struct device *dev,
 	cl->tx_block = false;
 	cl->knows_txdone = tx;
 
+	INIT_WORK(&smbox->rx_work, rx_work_fn);
+
 	smbox->chan = mbox_request_channel(cl, tx ? 0 : p2a_chan);
 	if (IS_ERR(smbox->chan)) {
 		ret = PTR_ERR(smbox->chan);
@@ -254,6 +275,7 @@ static int mailbox_chan_free(int id, void *p, void *data)
 	struct scmi_mailbox *smbox = cinfo->transport_info;
 
 	if (smbox && !IS_ERR(smbox->chan)) {
+		cancel_work_sync(&smbox->rx_work);
 		mbox_free_channel(smbox->chan);
 		mbox_free_channel(smbox->chan_receiver);
 		mbox_free_channel(smbox->chan_platform_receiver);
-- 
