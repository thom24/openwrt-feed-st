From 6d8629104284d1be614cb19690c228edf1db1989 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Thu, 6 Nov 2025 11:16:43 +0100
Subject: [PATCH] arm64: dts: st: add a35ss_syscfg node to SoC files

Add the node a35ss_syscfg in all the SoC file stm32mp2xx.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I9787cc09f524905ae698a47d5f237e132d9acd96
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/541200
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 6 ++++++
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 6 ++++++
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 6 ++++++
 3 files changed, 18 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -891,6 +891,12 @@
 			};
 		};
 
+		a35ss_syscfg: syscon@48800000  {
+			compatible = "st,stm32mp25-a35ss-syscfg";
+			reg = <0x48800000 0x0 0x4000>;
+			status = "disabled";
+		};
+
 		intc: interrupt-controller@4ac10000 {
 			compatible = "arm,gic-400";
 			reg = <0x4ac10000 0x0 0x1000>,
--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -1475,6 +1475,12 @@
 				<&intc GIC_SPI 213 IRQ_TYPE_LEVEL_HIGH>;	/* EXTI_70 */
 		};
 
+		a35ss_syscfg: syscon@48800000  {
+			compatible = "st,stm32mp25-a35ss-syscfg";
+			reg = <0x48800000 0x4000>;
+			status = "disabled";
+		};
+
 		dbg_bus: bus@4a000000 {
 			compatible = "st,stm32mp231-dbg-bus";
 			#address-cells = <1>;
--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -2496,6 +2496,12 @@
 			status = "disabled";
 		};
 
+		a35ss_syscfg: syscon@48800000  {
+			compatible = "st,stm32mp25-a35ss-syscfg";
+			reg = <0x48800000 0x4000>;
+			status = "disabled";
+		};
+
 		dbg_bus: bus@4a000000 {
 			compatible = "st,stm32mp251-dbg-bus";
 			#address-cells = <1>;
