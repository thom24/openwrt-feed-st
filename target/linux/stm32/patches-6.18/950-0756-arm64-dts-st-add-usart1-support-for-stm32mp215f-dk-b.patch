From 70d74a3bad864bf340dd31a93dad4810665d80a2 Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Tue, 10 Mar 2026 09:56:19 +0100
Subject: [PATCH] arm64: dts: st: add usart1 support for stm32mp215f-dk board

Add USART1 for stm32mp215f-dk board.
USART1 is used for Bluetooth. (under M2 connector)

Change-Id: I6b3c63ea68284ba04653afd9bf4c677786afa69c
Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/546178
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp215f-dk.dts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
index 8c7bcb9b0827..181d2db67925 100644
--- a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
@@ -23,6 +23,7 @@ aliases {
 		serial0 = &usart2;
 		serial1 = &usart6;
 		serial2 = &uart4;
+		serial3 = &usart1;
 	};
 
 	chosen {
@@ -365,6 +366,16 @@ &uart4 {
 	status = "disabled";
 };
 
+/* Bluetooth */
+&usart1 {
+	pinctrl-names = "default", "sleep", "idle";
+	pinctrl-0 = <&usart1_pins_a>;
+	pinctrl-1 = <&usart1_sleep_pins_a>;
+	pinctrl-2 = <&usart1_idle_pins_a>;
+	uart-has-rtscts;
+	status = "disabled";
+};
+
 &usart2 {
 	bootph-all;
 	pinctrl-names = "default", "idle", "sleep";
-- 
2.53.0

