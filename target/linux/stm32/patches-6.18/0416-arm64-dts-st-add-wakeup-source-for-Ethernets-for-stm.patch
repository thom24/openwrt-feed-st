From 95fadff64537845cf59ae3fbfc66297129b36528 Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Mon, 20 Apr 2026 11:32:44 +0200
Subject: [PATCH] arm64: dts: st: add wakeup source for Ethernets for stm32mp23

When the "wakeup-source" flag is found, Ethernet marks
the device as wakeup capable and enables the wakeup by
default. (with WoL event)

Change-Id: Ice93058fcc5b156291e6e85f61cc87690422bacd
Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559353
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 7 +++++--
 arch/arm64/boot/dts/st/stm32mp233.dtsi | 7 +++++--
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp231.dtsi b/arch/arm64/boot/dts/st/stm32mp231.dtsi
index 9adac63d54c0..ab4d8da57f2a 100644
--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -854,8 +854,10 @@ ethernet1: ethernet@482c0000 {
 				compatible = "st,stm32mp25-dwmac", "snps,dwmac-5.20";
 				reg = <0x482c0000 0x4000>;
 				reg-names = "stmmaceth";
-				interrupts-extended = <&intc GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>;
-				interrupt-names = "macirq";
+				interrupts-extended = <&intc GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>,
+						      <&exti1 68 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "macirq",
+						  "eth_wake_irq";
 				clock-names = "stmmaceth",
 					      "mac-clk-tx",
 					      "mac-clk-rx",
@@ -879,6 +881,7 @@ ethernet1: ethernet@482c0000 {
 				st,syscon = <&syscfg 0x3000>;
 				access-controllers = <&rifsc 60>;
 				power-domains = <&d1_pd>;
+				wakeup-source;
 				status = "disabled";
 
 				mtl_rx_setup_1: rx-queues-config {
diff --git a/arch/arm64/boot/dts/st/stm32mp233.dtsi b/arch/arm64/boot/dts/st/stm32mp233.dtsi
index 2f83f1abf6f2..9fe6d266cf9b 100644
--- a/arch/arm64/boot/dts/st/stm32mp233.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp233.dtsi
@@ -100,8 +100,10 @@ ethernet2: ethernet@482d0000 {
 		compatible = "st,stm32mp25-dwmac", "snps,dwmac-5.20";
 		reg = <0x482d0000 0x4000>;
 		reg-names = "stmmaceth";
-		interrupts-extended = <&intc GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>;
-		interrupt-names = "macirq";
+		interrupts-extended = <&intc GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>,
+				      <&exti1 70 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "macirq",
+				  "eth_wake_irq";
 		clock-names = "stmmaceth",
 			      "mac-clk-tx",
 			      "mac-clk-rx",
@@ -125,6 +127,7 @@ ethernet2: ethernet@482d0000 {
 		st,syscon = <&syscfg 0x3400>;
 		access-controllers = <&rifsc 61>;
 		power-domains = <&d1_pd>;
+		wakeup-source;
 		status = "disabled";
 
 		mtl_rx_setup_2: rx-queues-config {
-- 
2.53.0

