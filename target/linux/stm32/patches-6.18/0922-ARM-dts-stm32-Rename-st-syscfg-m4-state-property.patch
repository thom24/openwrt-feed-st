From ed7fd6b2eda28d506cfa7683bfa0318643482528 Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Wed, 20 May 2026 09:31:20 +0200
Subject: [PATCH] ARM: dts: stm32: Rename st,syscfg-m4-state property

Rename the property to reuse it for the stm32mp2. the new name is
"st,syscfg-cm-state".

Change-Id: Iccf8f0781347ab2c5225f32dbc31d7e12ce3c5e6
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/569573
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Tested-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
---
 arch/arm/boot/dts/st/stm32mp151.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/arch/arm/boot/dts/st/stm32mp151.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp151.dtsi
@@ -2404,7 +2404,7 @@
 			st,syscfg-holdboot = <&rcc 0x10C 0x1>;
 			st,syscfg-pdds = <&pwr_mcu 0x0 0x1>;
 			st,syscfg-rsc-tbl = <&tamp 0x144 0xFFFFFFFF>;
-			st,syscfg-m4-state = <&tamp 0x148 0xFFFFFFFF>;
+			st,syscfg-cm-state = <&tamp 0x148 0xFFFFFFFF>;
 			status = "disabled";
 		};
 	};
