From 97bc5f971ba62528b458a054b7e9d5f3d9a71537 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Sat, 6 May 2023 18:46:22 +0200
Subject: [PATCH] kbuild: add external device tree build to dtbs target

Add possibility to build device trees defined into the extra folder placed
either inside current device tree sources depending on architecture:
- arch/arm64/boot/dts/st/external-dt/linux for arm64
- arch/arm/boot/dts/st/external-dt/linux for arm
or into a path specified with KBUILD_EXTDTS in build command.

This "external-dt/linux" folder can be added to kernel device tree sources
using the following git submodule command:
- for arm:
git submodule add ssh://${USER}@gerrit.st.com:29418/mpu/oe/st/dt-stm32mp \
 arch/arm/boot/dts/st/dt-stm32mp
- for arm64:
git submodule add ssh://${USER}@gerrit.st.com:29418/mpu/oe/st/dt-stm32mp \
 arch/arm64/boot/dts/st/dt-stm32mp

Or it can be cloned outside kernel sources using the following command:
git clone ssh://${USER}@gerrit.st.com:29418/mpu/oe/st/dt-stm32mp
Then you will have to add KBUILD_EXTDTS=<path_to_dt-stm32mp>/linux to your
build command line.

Then, you can run:
> internal DT
(arm)   make st/stm32mp157f-dk2.dtb
(arm64) make st/stm32mp257f-ev1.dtb
> external DT inside DT source tree
(arm)   make st/stm32mp157f-dk2-ostl.dtb
(arm64) make st/stm32mp257f-ev1-ca35tdcid-ostl.dtb
> external DT outside kernel tree
(arm)   make st/stm32mp157f-dk2-ostl.dtb KBUILD_EXTDTS=<path_to_dt-stm32mp>/stm32mp1/linux
(arm64) make st/stm32mp257f-ev1-ca35tdcid-ostl.dtb KBUILD_EXTDTS=<path_to_dt-stm32mp>/stm32mp2/a35-td/linux

To build all dtbs, whatever $(SRCARCH), use:
make dtbs [KBUILD_EXTDTS=<External device tree directory>/linux]

Change-Id: I3d07c08ae01ac4ee4d2b9dd358cf5b905c5d661d
Signed-off-by: Alexandre Torgue <alexandre.torgue@foss.st.com>
Signed-off-by: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/529764
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 Makefile | 39 ++++++++++++++++++++++++++++++++++++---
 1 file changed, 36 insertions(+), 3 deletions(-)

diff --git a/Makefile b/Makefile
index 9c16001ccdcd..ac263928f0f3 100644
--- a/Makefile
+++ b/Makefile
@@ -1488,17 +1488,50 @@ ifneq ($(wildcard $(srctree)/arch/$(SRCARCH)/boot/dts/),)
 dtstree := arch/$(SRCARCH)/boot/dts
 endif
 
-ifneq ($(dtstree),)
+ifdef CONFIG_ARCH_STM32
+ifeq ("$(SRCARCH)", "arm")
+export TARGET_ARM32=y
+else ifeq ("$(SRCARCH)", "arm64")
+export TARGET_ARM64=y
+endif
+
+stdtstree := $(dtstree)/st
+
+# Default path for external device trees
+ifeq ($(TARGET_ARM64),y)
+KBUILD_EXTDTS ?= $(realpath $(srctree))/$(stdtstree)/dt-stm32mp/stm32mp2/*/linux
+else
+KBUILD_EXTDTS ?= $(realpath $(srctree))/$(stdtstree)/dt-stm32mp/stm32mp1/linux/
+endif
+
+ifneq ($(wildcard $(KBUILD_EXTDTS)),)
+export DTS_INCLUDE := -I $(srctree)/$(stdtstree)
+endif
+endif #ARCH_STM32
+
+KBUILD_EXTDTB := $(or $(and $(wildcard $(KBUILD_EXTDTS)), 1), 0)
+
+ifneq ($(stdtstree),)
 
 %.dtb: dtbs_prepare
-	$(Q)$(MAKE) $(build)=$(dtstree) $(dtstree)/$@
+	$(Q)$(MAKE) $(build)=$(stdtstree) $(dtstree)/$@ || ( \
+	test ! -e $(dtstree)/$@ -a $(KBUILD_EXTDTB) -eq 1  && ( \
+		for extdts in $(KBUILD_EXTDTS); do \
+			echo "Looking for $(patsubst st/%.dtb,%.dtb,$@) into $$extdts"; \
+			$(MAKE) $(build)=$(stdtstree) src=$$extdts $(dtstree)/$@; \
+		done || /bin/false) || /bin/false)
 
 %.dtbo: dtbs_prepare
 	$(Q)$(MAKE) $(build)=$(dtstree) $(dtstree)/$@
 
 PHONY += dtbs dtbs_prepare dtbs_install dtbs_check
 dtbs: dtbs_prepare
-	$(Q)$(MAKE) $(build)=$(dtstree) need-dtbslist=1
+	$(Q)$(MAKE) $(build)=$(stdtstree) need-dtbslist=1
+	$(Q)test $(KBUILD_EXTDTB) -eq 0 || ( \
+		for extdts in $(KBUILD_EXTDTS); do \
+			echo "Looking for device trees into $$extdts"; \
+			$(MAKE) $(build)=$(stdtstree) src=$$extdts; \
+		done || /bin/false)
 
 # include/config/kernel.release is actually needed when installing DTBs because
 # INSTALL_DTBS_PATH contains $(KERNELRELEASE). However, we do not want to make
