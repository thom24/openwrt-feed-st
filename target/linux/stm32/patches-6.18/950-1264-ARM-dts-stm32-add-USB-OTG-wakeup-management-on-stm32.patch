From b62304749dabe2371088c9b3526376cb9f14ab16 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Wed, 7 Jul 2021 15:43:57 +0200
Subject: [PATCH] ARM: dts: stm32: add USB OTG wakeup management on stm32mp131

USB OTG can be used to wakeup from stop mode on stm32mp131.
Add wakeup-source property and use EXTI #44 interrupt instead of GIC.

Change-Id: I2a1afd29c1b12aaf179eb44c3b333cb69f77bbac
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/572751
Tested-by: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
Reviewed-by: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
---
 arch/arm/boot/dts/st/stm32mp131.dtsi | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/st/stm32mp131.dtsi b/arch/arm/boot/dts/st/stm32mp131.dtsi
index 143ebb80a8f3..97014d2311d2 100644
--- a/arch/arm/boot/dts/st/stm32mp131.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp131.dtsi
@@ -1398,13 +1398,14 @@ usbotg_hs: usb@49000000 {
 				clock-names = "otg";
 				resets = <&rcc USBO_R>;
 				reset-names = "dwc2";
-				interrupts = <GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>;
+				interrupts-extended = <&exti 44 IRQ_TYPE_LEVEL_HIGH>;
 				g-rx-fifo-size = <512>;
 				g-np-tx-fifo-size = <32>;
 				g-tx-fifo-size = <256 16 16 16 16 16 16 16>;
 				dr_mode = "otg";
 				otg-rev = <0x200>;
 				usb33d-supply = <&scmi_usb33>;
+				wakeup-source;
 				access-controllers = <&etzpc 34>;
 				status = "disabled";
 			};
-- 
