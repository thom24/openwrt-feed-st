From 1c7c6b42d459de32f7f6e39a293c34c067e3ba55 Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@foss.st.com>
Date: Fri, 30 Jan 2026 10:06:55 +0100
Subject: [PATCH] ARM: dts: stm32: refactor WoL for stm32mp135f-dk

Refactor the WoL support for the Ethernet1 node by using the "st,phy-wol"
property instead of the "wakeup-source" property that's not supported
by the PHY node.

Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Signed-off-by: Christophe Roullier <christophe.roullier@foss.st.com>
Change-Id: Idabaeb89d4caf0a9c407d050f7012b4f3548774b
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/474378
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Christophe ROULLIER <christophe.roullier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Tested-by: Christophe ROULLIER <christophe.roullier@foss.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Domain-Review: Christophe ROULLIER <christophe.roullier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/535366
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm/boot/dts/st/stm32mp135f-dk.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/arch/arm/boot/dts/st/stm32mp135f-dk.dts
+++ b/arch/arm/boot/dts/st/stm32mp135f-dk.dts
@@ -235,6 +235,7 @@
 	phy-mode = "rmii";
 	max-speed = <100>;
 	phy-handle = <&phy0_eth1>;
+	st,phy-wol;
 
 	mdio {
 		#address-cells = <1>;
@@ -247,7 +248,6 @@
 			reset-gpios = <&mcp23017 9 GPIO_ACTIVE_LOW>;
 			reset-assert-us = <1000>;
 			reset-deassert-us = <30000>;
-			wakeup-source;
 		};
 	};
 };
