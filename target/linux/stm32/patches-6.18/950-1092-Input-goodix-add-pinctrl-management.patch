From ce66732718658ba6ddd68d8fca8dee10be472e38 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Thu, 2 Oct 2025 17:11:07 +0200
Subject: [PATCH] Input: goodix - add pinctrl management

Temporary patch allowing pinctrl management during suspend/resume.

Change-Id: I8059ec353a9a7a26b2a1b7d2f704478f588b897f
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/495799
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 drivers/input/touchscreen/goodix.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/input/touchscreen/goodix.c b/drivers/input/touchscreen/goodix.c
index 1b43e92e55d7..d67eac13c8ea 100644
--- a/drivers/input/touchscreen/goodix.c
+++ b/drivers/input/touchscreen/goodix.c
@@ -19,6 +19,7 @@
 #include <drm/drm_mipi_dsi.h>
 #include <linux/irq.h>
 #include <linux/interrupt.h>
+#include <linux/pinctrl/consumer.h>
 #include <linux/platform_data/x86/soc.h>
 #include <linux/slab.h>
 #include <linux/acpi.h>
@@ -1465,6 +1466,10 @@ static int goodix_suspend(struct device *dev)
 	/* We need gpio pins to suspend/resume */
 	if (ts->irq_pin_access_method == IRQ_PIN_ACCESS_NONE) {
 		goodix_disable_irq(ts);
+
+		/* Set to sleep state the pinctrl */
+		pinctrl_pm_select_sleep_state(dev);
+
 		return 0;
 	}
 
@@ -1509,6 +1514,10 @@ static int goodix_resume(struct device *dev)
 
 	if (ts->irq_pin_access_method == IRQ_PIN_ACCESS_NONE) {
 		goodix_enable_irq(ts);
+
+		/* Set to default state the pinctrl */
+		pinctrl_pm_select_default_state(dev);
+
 		return 0;
 	}
 
-- 
2.53.0

