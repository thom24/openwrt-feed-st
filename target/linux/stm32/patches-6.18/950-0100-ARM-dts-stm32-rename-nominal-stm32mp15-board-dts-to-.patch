From 4bb28f7295a44446a0287e87ec5aec2a0bd5c740 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Tue, 22 Sep 2026 14:18:31 +0200
Subject: [PATCH] ARM: dts: stm32: rename nominal stm32mp15 board dts to
 -no-scmi

Rename the legacy non-SCMI stm32mp157a/c board DTS files by
appending a -no-scmi suffix to clearly distinguish them from the
SCMI-enabled variants:
  stm32mp157a-dk1   -> stm32mp157a-dk1-no-scmi
  stm32mp157c-dk2   -> stm32mp157c-dk2-no-scmi
  stm32mp157c-ed1   -> stm32mp157c-ed1-no-scmi
  stm32mp157c-ev1   -> stm32mp157c-ev1-no-scmi
Update the Makefile and DT bindings documentation accordingly.

Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: If7ebb1ac7b24466432e0152160141572e2df3c47
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/593154
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 Documentation/devicetree/bindings/arm/stm32/stm32.yaml | 10 +++++-----
 arch/arm/boot/dts/st/Makefile                          |  8 ++++----
 ...stm32mp157a-dk1.dts => stm32mp157a-dk1-no-scmi.dts} |  4 ++--
 arch/arm/boot/dts/st/stm32mp157a-dk1-scmi.dts          |  2 +-
 ...stm32mp157c-dk2.dts => stm32mp157c-dk2-no-scmi.dts} |  4 ++--
 arch/arm/boot/dts/st/stm32mp157c-dk2-scmi.dts          |  2 +-
 ...stm32mp157c-ed1.dts => stm32mp157c-ed1-no-scmi.dts} |  4 ++--
 arch/arm/boot/dts/st/stm32mp157c-ed1-scmi.dts          |  2 +-
 ...stm32mp157c-ev1.dts => stm32mp157c-ev1-no-scmi.dts} |  6 +++---
 arch/arm/boot/dts/st/stm32mp157c-ev1-scmi.dts          |  4 ++--
 10 files changed, 23 insertions(+), 23 deletions(-)
 rename arch/arm/boot/dts/st/{stm32mp157a-dk1.dts => stm32mp157a-dk1-no-scmi.dts} (76%)
 rename arch/arm/boot/dts/st/{stm32mp157c-dk2.dts => stm32mp157c-dk2-no-scmi.dts} (94%)
 rename arch/arm/boot/dts/st/{stm32mp157c-ed1.dts => stm32mp157c-ed1-no-scmi.dts} (98%)
 rename arch/arm/boot/dts/st/{stm32mp157c-ev1.dts => stm32mp157c-ev1-no-scmi.dts} (97%)

diff --git a/Documentation/devicetree/bindings/arm/stm32/stm32.yaml b/Documentation/devicetree/bindings/arm/stm32/stm32.yaml
