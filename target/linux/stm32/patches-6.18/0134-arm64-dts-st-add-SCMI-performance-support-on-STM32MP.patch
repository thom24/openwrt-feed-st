From 2b8c01665cef8d15f4997fbc3cfa27b5f362a9f3 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 17 Feb 2026 08:43:11 +0100
Subject: [PATCH] arm64: dts: st: add SCMI performance support on STM32MP2

Update the device-tree to add support for scmi performance
on cpu0 and cpu1. This leads to enable cpu-freq on the CPUs.

Signed-off-by: Pascal Paillet <p.paillet@st.com>
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I023aab05d19eab1d8831a5936430c397c0424f03
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/537245
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp211.dtsi | 9 +++++++--
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 9 +++++++--
 arch/arm64/boot/dts/st/stm32mp233.dtsi | 4 ++--
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 9 +++++++--
 arch/arm64/boot/dts/st/stm32mp253.dtsi | 4 ++--
 5 files changed, 25 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp211.dtsi b/arch/arm64/boot/dts/st/stm32mp211.dtsi
index b39e51402d5b..6f6a6d17c4fa 100644
--- a/arch/arm64/boot/dts/st/stm32mp211.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp211.dtsi
@@ -19,8 +19,8 @@ cpu0: cpu@0 {
 			reg = <0>;
 			device_type = "cpu";
 			enable-method = "psci";
-			power-domains = <&cpu0_pd>;
-			power-domain-names = "psci";
+			power-domains = <&cpu0_pd>, <&scmi_perf 0>;
+			power-domain-names = "psci", "perf";
 		};
 
 		idle-states {
@@ -97,6 +97,11 @@ scmi: scmi {
 			#size-cells = <0>;
 			linaro,optee-channel-id = <0>;
 
+			scmi_perf: protocol@13 {
+				reg = <0x13>;
+				#power-domain-cells = <1>;
+			};
+
 			scmi_clk: protocol@14 {
 				reg = <0x14>;
 				#clock-cells = <1>;
diff --git a/arch/arm64/boot/dts/st/stm32mp231.dtsi b/arch/arm64/boot/dts/st/stm32mp231.dtsi
index 18736a9978b7..74920950867b 100644
--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -21,8 +21,8 @@ cpu0: cpu@0 {
 			reg = <0>;
 			device_type = "cpu";
 			enable-method = "psci";
-			power-domains = <&cpu0_pd>;
-			power-domain-names = "psci";
+			power-domains = <&cpu0_pd>, <&scmi_perf 0>;
+			power-domain-names = "psci", "perf";
 		};
 
 		idle-states {
@@ -111,6 +111,11 @@ scmi_devpd: protocol@11 {
 				#power-domain-cells = <1>;
 			};
 
+			scmi_perf: protocol@13 {
+				reg = <0x13>;
+				#power-domain-cells = <1>;
+			};
+
 			scmi_clk: protocol@14 {
 				reg = <0x14>;
 				#clock-cells = <1>;
diff --git a/arch/arm64/boot/dts/st/stm32mp233.dtsi b/arch/arm64/boot/dts/st/stm32mp233.dtsi
index 8d0abd7a7925..76762bf7bdad 100644
--- a/arch/arm64/boot/dts/st/stm32mp233.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp233.dtsi
@@ -12,8 +12,8 @@ cpu1: cpu@1 {
 			reg = <1>;
 			device_type = "cpu";
 			enable-method = "psci";
-			power-domains = <&cpu1_pd>;
-			power-domain-names = "psci";
+			power-domains = <&cpu1_pd>, <&scmi_perf 0>;
+			power-domain-names = "psci", "perf";
 		};
 	};
 
diff --git a/arch/arm64/boot/dts/st/stm32mp251.dtsi b/arch/arm64/boot/dts/st/stm32mp251.dtsi
index 94402e36a7e7..34ac0bd2acaf 100644
--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -22,8 +22,8 @@ cpu0: cpu@0 {
 			device_type = "cpu";
 			reg = <0>;
 			enable-method = "psci";
-			power-domains = <&cpu0_pd>;
-			power-domain-names = "psci";
+			power-domains = <&cpu0_pd>, <&scmi_perf 0>;
+			power-domain-names = "psci", "perf";
 		};
 
 		idle-states {
@@ -120,6 +120,11 @@ scmi_devpd: protocol@11 {
 				#power-domain-cells = <1>;
 			};
 
+			scmi_perf: protocol@13 {
+				reg = <0x13>;
+				#power-domain-cells = <1>;
+			};
+
 			scmi_clk: protocol@14 {
 				reg = <0x14>;
 				#clock-cells = <1>;
diff --git a/arch/arm64/boot/dts/st/stm32mp253.dtsi b/arch/arm64/boot/dts/st/stm32mp253.dtsi
index ebc6ccfad3ff..e39f2d1d2902 100644
--- a/arch/arm64/boot/dts/st/stm32mp253.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp253.dtsi
@@ -12,8 +12,8 @@ cpu1: cpu@1 {
 			device_type = "cpu";
 			reg = <1>;
 			enable-method = "psci";
-			power-domains = <&cpu1_pd>;
-			power-domain-names = "psci";
+			power-domains = <&cpu1_pd>, <&scmi_perf 0>;
+			power-domain-names = "psci", "perf";
 		};
 	};
 
-- 
2.53.0

