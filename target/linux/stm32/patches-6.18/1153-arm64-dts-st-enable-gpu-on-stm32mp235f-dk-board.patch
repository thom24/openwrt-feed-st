From 3aa5571d9d762cf6eeab98357149ba54f5fae9b5 Mon Sep 17 00:00:00 2001
From: Philippe Cornu <philippe.cornu@foss.st.com>
Date: Tue, 5 May 2026 11:18:43 +0200
Subject: [PATCH] arm64: dts: st: enable gpu on stm32mp235f-dk board

This patch enables the use of the GPU peripheral on stm32mp235f-dk.

Change-Id: I10171eac26e2728de2365f749e7c5480d2916fbc
Signed-off-by: Philippe Cornu <philippe.cornu@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/564758
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp235f-dk.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
index 0a51c29c1cf1..f3eaa6a84f1d 100644
--- a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
@@ -358,6 +358,10 @@ &gpioz {
 	bootph-all;
 };
 
+&gpu {
+	contiguous-area = <&gpu_reserved>;
+};
+
 &hpdma {
 	memory-region = <&hpdma1_lli>;
 };
-- 
2.53.0

