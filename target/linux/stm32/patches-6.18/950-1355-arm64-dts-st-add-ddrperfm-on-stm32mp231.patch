From 0cbe1644edac7336861974efe9108f5639bfde3c Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Tue, 9 Sep 2025 12:12:25 +0200
Subject: [PATCH] arm64: dts: st: add ddrperfm on stm32mp231

The DDRPERFM is the DDR Performance Monitor embedded in STM32MP231 SoC.

Keep the node disabled at SoC level as it requires the property
`memory-channel` which is provided in board dtsi file.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: Id67a634ce84ffc4147af003d85156946415bca48
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/571228
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 7 +++++++
 1 file changed, 7 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -2707,6 +2707,13 @@
 				<&intc GIC_SPI 213 IRQ_TYPE_LEVEL_HIGH>;	/* EXTI_70 */
 		};
 
+		ddrperfm: perf@48041000 {
+			compatible = "st,stm32mp231-ddr-pmu", "st,stm32mp251-ddr-pmu";
+			reg = <0x48041000 0x400>;
+			access-controllers = <&dbg_bus 2>;
+			status = "disabled";
+		};
+
 		fmc: memory-controller@48200000 {
 			compatible = "st,stm32mp25-fmc2-ebi";
 			reg = <0x48200000 0x400>;
