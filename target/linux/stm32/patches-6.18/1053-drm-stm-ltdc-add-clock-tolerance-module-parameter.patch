From 922818285cb895bcc9f09713cb9e15913e79c0d8 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Wed, 8 Jan 2025 11:12:42 +0100
Subject: [PATCH] drm/stm: ltdc: add clock tolerance module parameter

Clock tolerance is set by default to 0.5% (HDMI requirement).
Via a module parameter, it is possible to modify it (useful for debug).

Change-Id: I3538001113e2d7ea37b0105c0adea4ed25e9207b
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/429696
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 drivers/gpu/drm/stm/ltdc.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

--- a/drivers/gpu/drm/stm/ltdc.c
+++ b/drivers/gpu/drm/stm/ltdc.c
@@ -525,6 +525,11 @@ static const struct regmap_config stm32_
 	.cache_type = REGCACHE_NONE,
 };
 
+/* Set by default the clock tolerance to 5‰ */
+static int clock_tolerance = 5;
+module_param_named(clock_tolerance, clock_tolerance, int, 0444);
+MODULE_PARM_DESC(clock_tolerance, "Clock tolerance ‰");
+
 static const u32 ltdc_ycbcr2rgb_coeffs[DRM_COLOR_ENCODING_MAX][DRM_COLOR_RANGE_MAX][2] = {
 	[DRM_COLOR_YCBCR_BT601][DRM_COLOR_YCBCR_LIMITED_RANGE] = {
 		0x02040199,	/* (b_cb = 516 / r_cr = 409) */
@@ -2012,8 +2017,6 @@ static int ltdc_crtc_init(struct drm_dev
 	return 0;
 }
 
-#define CLK_TOLERANCE_HZ 50
-
 static enum drm_mode_status ltdc_encoder_mode_valid(struct drm_encoder *encoder,
 						    const struct drm_display_mode *mode)
 {
@@ -2021,8 +2024,8 @@ static enum drm_mode_status ltdc_encoder
 	struct ltdc_device *ldev =  ddev->dev_private;
 	struct device *dev = ddev->dev;
 	int target = mode->clock * 1000;
-	int target_min = (mode->clock * 1000) - CLK_TOLERANCE_HZ;
-	int target_max = (mode->clock * 1000) + CLK_TOLERANCE_HZ;
+	int target_min = mode->clock * (1000 - clock_tolerance);
+	int target_max = mode->clock * (1000 + clock_tolerance);
 	int result;
 
 	if (of_device_is_compatible(dev->of_node, "st,stm32mp255-ltdc")) {
