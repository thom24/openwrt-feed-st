From 05e79126f7b03d86190be92d71095d747d86efaf Mon Sep 17 00:00:00 2001
From: Thomas Richard <thomas.richard@bootlin.com>
Date: Tue, 21 Jan 2025 15:29:09 +0100
Subject: [PATCH] stm32: disable wakeup buttons

The gpio-button-hotplug kernel module does not support wakeup buttons
(KEY_WAKEUP key), so disable them for supported boards.

Signed-off-by: Thomas Richard <thomas.richard@bootlin.com>
---
 arch/arm/boot/dts/st/stm32mp135f-dk.dts    | 1 +
 arch/arm/boot/dts/st/stm32mp157f-dk2.dts   | 1 +
 arch/arm64/boot/dts/st/stm32mp215f-dk.dts  | 2 +-
 arch/arm64/boot/dts/st/stm32mp235f-dk.dts  | 2 +-
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts  | 2 +-
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 2 +-
 6 files changed, 6 insertions(+), 4 deletions(-)

--- a/arch/arm/boot/dts/st/stm32mp135f-dk.dts
+++ b/arch/arm/boot/dts/st/stm32mp135f-dk.dts
@@ -79,6 +79,7 @@
 			linux,code = <KEY_WAKEUP>;
 			interrupts-extended = <&optee 0>;
 			wakeup-source;
+			status = "disabled";
 		};
 	};
 
--- a/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
+++ b/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
@@ -42,6 +42,7 @@
 			linux,code = <KEY_WAKEUP>;
 			interrupts-extended = <&optee 0>;
 			wakeup-source;
+			status = "disabled";
 		};
 	};
 
--- a/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp215f-dk.dts
@@ -71,7 +71,7 @@
 			linux,code = <KEY_WAKEUP>;
 			interrupts-extended = <&optee 0>;
 			wakeup-source;
-			status = "okay";
+			status = "disabled";
 		};
 	};
 
--- a/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp235f-dk.dts
@@ -78,7 +78,7 @@
 			linux,code = <KEY_WAKEUP>;
 			interrupts-extended = <&optee 0>;
 			wakeup-source;
-			status = "okay";
+			status = "disabled";
 		};
 	};
 
--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -111,7 +111,7 @@
 			linux,code = <KEY_WAKEUP>;
 			interrupts-extended = <&optee 0>;
 			wakeup-source;
-			status = "okay";
+			status = "disabled";
 		};
 	};
 
--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -97,7 +97,7 @@
 			linux,code = <KEY_WAKEUP>;
 			interrupts-extended = <&optee 0>;
 			wakeup-source;
-			status = "okay";
+			status = "disabled";
 		};
 	};
 
