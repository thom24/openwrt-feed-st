From 44b902b11a43bea6772c3fb29669c0acae1c6dfe Mon Sep 17 00:00:00 2001
From: Patrice Chotard <patrice.chotard@foss.st.com>
Date: Fri, 6 Mar 2026 11:19:34 +0100
Subject: [PATCH] spi: stm32-ospi: Make usage of spi_get_chipselect()

Replace spi->chip_select() by spi_get_chipselect().

Signed-off-by: Patrice Chotard <patrice.chotard@foss.st.com>
---
 drivers/spi/spi-stm32-ospi.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

--- a/drivers/spi/spi-stm32-ospi.c
+++ b/drivers/spi/spi-stm32-ospi.c
@@ -851,7 +851,7 @@ static int stm32_ospi_send(struct spi_de
 	u64 addr = op->addr.val;
 	unsigned int nbytes = op->data.nbytes;
 	int timeout, err = 0, err_poll_status = 0;
-	u8 cs = spi->chip_select[ffs(spi->cs_index_mask) - 1];
+	u8 cs = spi_get_chipselect(spi, 0);
 
 	dev_dbg(common->dev, "cmd:%#x dtr:%d mode:%d.%d.%d.%d addr:%#llx len:%#x\n",
 		op->cmd.opcode, op->cmd.dtr, op->cmd.buswidth,
@@ -1494,7 +1494,7 @@ static int stm32_ospi_setup(struct spi_d
 	u32 clk_rate = common->clk_rate;
 	u32 bus_freq;
 	int ret;
-	u8 cs = spi->chip_select[ffs(spi->cs_index_mask) - 1];
+	u8 cs = spi_get_chipselect(spi, 0);
 
 	if (ctrl->busy)
 		return -EBUSY;
