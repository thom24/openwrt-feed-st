From 2f548f7ae6caf9e206059df58b736027ecf3931c Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Tue, 23 Jun 2026 16:34:38 +0200
Subject: [PATCH] ASoC: stm32: i2s: advertise batched PCM pointer reporting

On STM32 I2S, obtaining burst-accurate DMA residue may require extra DMA
channel synchronization in the pointer reporting path. That is not always
desirable for audio streaming, where minimizing disturbance to an active
transfer can be more important than reporting sub-period progress.

Configure the DMA slave setup to request segment-level residue reporting
and advertise SNDRV_PCM_INFO_BATCH so ALSA userspace knows that the
hardware pointer may advance in batches, typically once per period,
rather than continuously.

This keeps pointer reporting aligned with the granularity that can be
obtained without disruptive DMA synchronization.

Change-Id: I7f1eb810ffd3a4baca01e842439d038930427b80
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/582123
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Tested-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Olivier MOYSAN <olivier.moysan@foss.st.com>
---
 sound/soc/stm/stm32_i2s.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/sound/soc/stm/stm32_i2s.c b/sound/soc/stm/stm32_i2s.c
index 6ca21780f21d..d90f4f035c2b 100644
--- a/sound/soc/stm/stm32_i2s.c
+++ b/sound/soc/stm/stm32_i2s.c
@@ -1107,7 +1107,7 @@ static const struct snd_soc_dai_ops stm32_i2s_pcm_dai_ops = {
 };
 
 static const struct snd_pcm_hardware stm32_i2s_pcm_hw = {
-	.info = SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_MMAP,
+	.info = SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_BATCH,
 	.buffer_bytes_max = 8 * PAGE_SIZE,
 	.period_bytes_min = 1024,
 	.period_bytes_max = 4 * PAGE_SIZE,
@@ -1115,9 +1115,25 @@ static const struct snd_pcm_hardware stm32_i2s_pcm_hw = {
 	.periods_max = 8,
 };
 
+static int stm32_i2s_prepare_slave_config(struct snd_pcm_substream *substream,
+					  struct snd_pcm_hw_params *params,
+					  struct dma_slave_config *slave_config)
+{
+	int ret;
+
+	ret = snd_dmaengine_pcm_prepare_slave_config(substream, params, slave_config);
+	if (ret)
+		return ret;
+
+	/* Prefer DMA_RESIDUE_GRANULARITY_SEGMENT to avoid disruptive DMA synchronization */
+	slave_config->residue_granularity = DMA_RESIDUE_GRANULARITY_SEGMENT;
+
+	return 0;
+}
+
 static const struct snd_dmaengine_pcm_config stm32_i2s_pcm_config = {
 	.pcm_hardware	= &stm32_i2s_pcm_hw,
-	.prepare_slave_config = snd_dmaengine_pcm_prepare_slave_config,
+	.prepare_slave_config = stm32_i2s_prepare_slave_config,
 	.prealloc_buffer_size = PAGE_SIZE * 8,
 };
 
