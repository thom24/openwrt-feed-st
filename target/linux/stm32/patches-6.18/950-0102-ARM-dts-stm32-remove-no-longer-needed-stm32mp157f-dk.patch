From 1afa7a0fe5a7e15bd90bb1a5f106a7c21fa0e63f Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Mon, 28 Sep 2026 17:46:48 +0200
Subject: [PATCH] ARM: dts: stm32: remove no longer needed
 stm32mp157f-dk2-scmi.dtsi file

Merge the content of stm32mp157f-dk2-scmi.dtsi into stm32mp157f-dk2.dts,
so the file is no longer needed and can be removed.

Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I19d399dee935a1fd8c05e62c9d81b9cf789d56f0
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/593156
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 .../arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi | 98 -------------------
 arch/arm/boot/dts/st/stm32mp157f-dk2.dts      | 76 +++++++++++++-
 2 files changed, 72 insertions(+), 102 deletions(-)
 delete mode 100644 arch/arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi

diff --git a/arch/arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi b/arch/arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi
deleted file mode 100644
index ff49a2c493b7..000000000000
--- a/arch/arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi
+++ /dev/null
@@ -1,98 +0,0 @@
-// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
-/*
- * Copyright (C) STMicroelectronics 2025 - All Rights Reserved
- * Author: Amelie Delaunay <amelie.delaunay@foss.st.com> for STMicroelectronics.
- */
-
-#include "stm32mp15-scmi.dtsi"
-
-/ {
-	reserved-memory {
-		optee@de000000 {
-			reg = <0xde000000 0x2000000>;
-			no-map;
-		};
-	};
-
-	arm_wdt: watchdog {
-		compatible = "arm,smc-wdt";
-		arm,smc-id = <0xbc000000>;
-		status = "disabled";
-	};
-
-};
-
-&cpu0 {
-	clocks = <&scmi_clk CK_SCMI_MPU>;
-};
-
-&cpu1 {
-	clocks = <&scmi_clk CK_SCMI_MPU>;
-};
-
-&cryp1 {
-	clocks = <&scmi_clk CK_SCMI_CRYP1>;
-	resets = <&scmi_reset RST_SCMI_CRYP1>;
-};
-
-&dsi {
-	clocks = <&rcc DSI>, <&scmi_clk CK_SCMI_HSE>, <&rcc DSI_PX>;
-};
-
-&gpioz {
-	clocks = <&scmi_clk CK_SCMI_GPIOZ>;
-};
-
-&hash1 {
-	clocks = <&scmi_clk CK_SCMI_HASH1>;
-	resets = <&scmi_reset RST_SCMI_HASH1>;
-};
-
-&i2c4 {
-	clocks = <&scmi_clk CK_SCMI_I2C4>;
-	resets = <&scmi_reset RST_SCMI_I2C4>;
-};
-
-&iwdg2 {
-	clocks = <&rcc IWDG2>, <&scmi_clk CK_SCMI_LSI>;
-};
-
-&m4_rproc {
-	/delete-property/ st,syscfg-holdboot;
-	resets = <&scmi_reset RST_SCMI_MCU>,
-		 <&scmi_reset RST_SCMI_MCU_HOLD_BOOT>;
-	reset-names = "mcu_rst", "hold_boot";
-};
-
-&mdma1 {
-	resets = <&scmi_reset RST_SCMI_MDMA>;
-};
-
-&optee {
-	interrupt-parent = <&intc>;
-	interrupts = <GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_LOW)>;
-	bootph-some-ram;
-};
-
-&rcc {
-	compatible = "st,stm32mp1-rcc-secure", "syscon";
-	clock-names = "hse", "hsi", "csi", "lse", "lsi";
-	clocks = <&scmi_clk CK_SCMI_HSE>,
-		 <&scmi_clk CK_SCMI_HSI>,
-		 <&scmi_clk CK_SCMI_CSI>,
-		 <&scmi_clk CK_SCMI_LSE>,
-		 <&scmi_clk CK_SCMI_LSI>;
-};
-
-&rng1 {
-	clocks = <&scmi_clk CK_SCMI_RNG1>;
-	resets = <&scmi_reset RST_SCMI_RNG1>;
-};
-
-&rtc {
-	clocks = <&scmi_clk CK_SCMI_RTCAPB>, <&scmi_clk CK_SCMI_RTC>;
-};
-
-&scmi {
-	bootph-some-ram;
-};
diff --git a/arch/arm/boot/dts/st/stm32mp157f-dk2.dts b/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
index e1e51683f397..ac3f0c60591b 100644
--- a/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
+++ b/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
@@ -11,7 +11,7 @@
 #include "stm32mp15-pinctrl.dtsi"
 #include "stm32mp15xxac-pinctrl.dtsi"
 #include "stm32mp15xx-dkx.dtsi"
-#include "stm32mp157f-dk2-scmi.dtsi"
+#include "stm32mp15-scmi.dtsi"
 
 / {
 	model = "STMicroelectronics STM32MP157F-DK2 Discovery Board";
@@ -26,22 +26,35 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	reserved-memory {
+		optee@de000000 {
+			reg = <0xde000000 0x2000000>;
+			no-map;
+		};
+	};
+
 	wifi_pwrseq: wifi-pwrseq {
 		compatible = "mmc-pwrseq-simple";
 		reset-gpios = <&gpioh 4 GPIO_ACTIVE_LOW>;
 	};
 };
 
-&arm_wdt {
-	timeout-sec = <32>;
-	status = "okay";
+&cpu0 {
+	clocks = <&scmi_clk CK_SCMI_MPU>;
+};
+
+&cpu1 {
+	clocks = <&scmi_clk CK_SCMI_MPU>;
 };
 
 &cryp1 {
+	clocks = <&scmi_clk CK_SCMI_CRYP1>;
+	resets = <&scmi_reset RST_SCMI_CRYP1>;
 	status = "okay";
 };
 
 &dsi {
+	clocks = <&rcc DSI>, <&scmi_clk CK_SCMI_HSE>, <&rcc DSI_PX>;
 	#address-cells = <1>;
 	#size-cells = <0>;
 	status = "okay";
@@ -68,6 +81,15 @@ &dsi_out {
 	remote-endpoint = <&panel_in>;
 };
 
+&gpioz {
+	clocks = <&scmi_clk CK_SCMI_GPIOZ>;
+};
+
+&hash1 {
+	clocks = <&scmi_clk CK_SCMI_HASH1>;
+	resets = <&scmi_reset RST_SCMI_HASH1>;
+};
+
 &hdp {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&hdp2_gpo &hdp2_pins_a>;
@@ -85,6 +107,15 @@ touchscreen@38 {
 	};
 };
 
+&i2c4 {
+	clocks = <&scmi_clk CK_SCMI_I2C4>;
+	resets = <&scmi_reset RST_SCMI_I2C4>;
+};
+
+&iwdg2 {
+	clocks = <&rcc IWDG2>, <&scmi_clk CK_SCMI_LSI>;
+};
+
 &ltdc {
 	bootph-some-ram;
 	status = "okay";
@@ -100,7 +131,40 @@ ltdc_ep1_out: endpoint@1 {
 	};
 };
 
+&m4_rproc {
+	/delete-property/ st,syscfg-holdboot;
+	resets = <&scmi_reset RST_SCMI_MCU>,
+		 <&scmi_reset RST_SCMI_MCU_HOLD_BOOT>;
+	reset-names = "mcu_rst", "hold_boot";
+};
+
+&mdma1 {
+	resets = <&scmi_reset RST_SCMI_MDMA>;
+};
+
+&optee {
+	interrupt-parent = <&intc>;
+	interrupts = <GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_LOW)>;
+	bootph-some-ram;
+};
+
+&rcc {
+	compatible = "st,stm32mp1-rcc-secure", "syscon";
+	clock-names = "hse", "hsi", "csi", "lse", "lsi";
+	clocks = <&scmi_clk CK_SCMI_HSE>,
+		 <&scmi_clk CK_SCMI_HSI>,
+		 <&scmi_clk CK_SCMI_CSI>,
+		 <&scmi_clk CK_SCMI_LSE>,
+		 <&scmi_clk CK_SCMI_LSI>;
+};
+
+&rng1 {
+	clocks = <&scmi_clk CK_SCMI_RNG1>;
+	resets = <&scmi_reset RST_SCMI_RNG1>;
+};
+
 &rtc {
+	clocks = <&scmi_clk CK_SCMI_RTCAPB>, <&scmi_clk CK_SCMI_RTC>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&rtc_rsvd_pins_a>;
 
@@ -110,6 +174,10 @@ rtc_lsco_pins_a: rtc-lsco-0 {
 	};
 };
 
+&scmi {
+	bootph-some-ram;
+};
+
 /* Wifi */
 &sdmmc2 {
 	pinctrl-names = "default", "opendrain", "sleep";
-- 
2.53.0

