From 29d72dc59d289e95b047919675ce172ca8796ba8 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Tue, 19 Sep 2023 18:25:33 +0200
Subject: [PATCH] pinctrl: stm32: simplify stm32_gpio_domain_activate()

The variable 'ret' is only used locally and there is no need to
initialize and propagate it till the function's end.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I317786d3573a943c8ae22f9c5fe89bb3c054aa9b
---
 drivers/pinctrl/stm32/pinctrl-stm32.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/pinctrl/stm32/pinctrl-stm32.c b/drivers/pinctrl/stm32/pinctrl-stm32.c
index adf8f4d3851f..1accdddae652 100644
--- a/drivers/pinctrl/stm32/pinctrl-stm32.c
+++ b/drivers/pinctrl/stm32/pinctrl-stm32.c
@@ -612,7 +612,7 @@ static int stm32_gpio_domain_activate(struct irq_domain *d,
 {
 	struct stm32_gpio_bank *bank = d->host_data;
 	struct stm32_pinctrl *pctl = dev_get_drvdata(bank->gpio_chip.parent);
-	int ret = 0;
+	int ret;
 
 	if (pctl->hwlock) {
 		ret = hwspin_lock_timeout_in_atomic(pctl->hwlock,
@@ -628,7 +628,7 @@ static int stm32_gpio_domain_activate(struct irq_domain *d,
 	if (pctl->hwlock)
 		hwspin_unlock_in_atomic(pctl->hwlock);
 
-	return ret;
+	return 0;
 }
 
 static int stm32_gpio_domain_alloc(struct irq_domain *d,
-- 
2.53.0

