From bde7b6425f07e9346ca9fa78069d2d266331ff82 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Thu, 26 Mar 2026 15:29:29 +0100
Subject: [PATCH] arm64: dts: st: add ltdc on stm32mp231

The LCD-TFT Display Controller (LTDC) handles display composition,
scaling and rotation.
It provides a parallel digital RGB flow to be used by
display interfaces.

Change-Id: I869e1c40f893c26c641f1d3f0c94beb193a889d4
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/552096
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 27 ++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp231.dtsi b/arch/arm64/boot/dts/st/stm32mp231.dtsi
index 7edf0bf4f3f1..9ad107404a58 100644
--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -1845,6 +1845,33 @@ i3c4: i3c@46080000 {
 				status = "disabled";
 			};
 
+			ltdc: display-controller@48010000 {
+				compatible = "st,stm32mp251-ltdc";
+				reg = <0x48010000 0x400>;
+				interrupts = <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>,
+					<GIC_SPI 159 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_LTDC>, <&rcc CK_BUS_LTDC>;
+				clock-names = "lcd", "bus";
+				resets = <&rcc LTDC_R>;
+				power-domains = <&d1_pd>;
+				status = "disabled";
+
+				access-controllers = <&rifsc 80>;
+				access-controller-names = "cmn";
+				l1l2 {
+					access-controllers = <&rifsc 119>;
+					access-controller-names = "l1l2";
+				};
+				l3 {
+					access-controllers = <&rifsc 120>;
+					access-controller-names = "l3";
+				};
+				rot {
+					access-controllers = <&rifsc 121>;
+					access-controller-names = "rot";
+				};
+			};
+
 			csi: csi@48020000 {
 				compatible = "st,stm32mp25-csi";
 				reg = <0x48020000 0x2000>;
-- 
2.53.0

