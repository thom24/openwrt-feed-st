From 633c6395c8d9e218614b34796b6476b47e8df1df Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Tue, 4 Aug 2026 10:59:21 +0200
Subject: [PATCH] arm64: dts: st: switch typec to dual role on stm32mp257f-dk

Switch USB Type-C connector to dual role mode now that the tcpp and
ucpd drivers supports it. IRQs may report Vbus change on TCPP when
in LP mode on both edges, so change to both edges.
When acting as a source, the board can deliver up to 1.5A.
To drive Vconn up to 1W for USB3 devices, external gates are controlled
by GPIOs on PF5, PC3 resp. for CC1 and CC2.

Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: I7bac5227d140b41145bac60b3e651af0183e922a
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/595966
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
index a148e4621c8e..da0ffcfeedcf 100644
--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -453,7 +453,7 @@ tcpp: typec@34 {
 		reg = <0x34>;
 		enable-gpios = <&gpioa 3 GPIO_ACTIVE_HIGH>;
 		interrupt-parent = <&gpiog>;
-		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
+		interrupts = <1 IRQ_TYPE_EDGE_BOTH>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&tcpp_flgn_pins_a>;
 		status = "okay";
@@ -917,15 +917,19 @@ pwm3: pwm {
 };
 
 &ucpd {
+	vconn-cc1-gpios = <&gpiof 5 GPIO_ACTIVE_HIGH>;
+	vconn-cc2-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
+	vconn-supply = <&scmi_v5v_vconn>;
 	st,tcpp = <&tcpp>;
 	status = "okay";
 
 	connector {
 		compatible = "usb-c-connector";
 		label = "USB-C";
-		data-role = "device";
-		power-role = "sink";
-		typec-power-opmode = "default";
+		data-role = "dual";
+		power-role = "dual";
+		try-power-role = "sink";
+		typec-power-opmode = "1.5A";
 		pd-disable;
 		self-powered;
 		port {
-- 
2.53.0

