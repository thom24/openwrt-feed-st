From fd258a504155b9b4402af7a70939c0e373cb9117 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Wed, 4 Feb 2026 16:18:12 +0100
Subject: [PATCH] ARM: dts: stm32: align stm32mp157f-dk2 SCMI config with
 stm32mp157c-dk2-scmi

As with other recent STM32 MPU families, the STM32MP157F-DK2 relies on
OP-TEE SCMI services for SoC clock and reset controller resources.
I2C4 and the PMIC were intended to be controlled by OP-TEE, but this is not
the case on stm32mp157c-dk2-scmi.
Therefore, I2C4 is restored, and PMIC regulators are reverted to non-SCMI
control.

Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I2d7a1819dd1f4f910bf4b3f59fcf5a588a145b98
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/601125
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 .../arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi | 107 +-----------------
 arch/arm/boot/dts/st/stm32mp157f-dk2.dts      |  39 +------
 2 files changed, 7 insertions(+), 139 deletions(-)

diff --git a/arch/arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi b/arch/arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi
index 1991d642e089..ab7b437055e0 100644
--- a/arch/arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp157f-dk2-scmi.dtsi
@@ -22,11 +22,6 @@ arm_wdt: watchdog {
 
 };
 
-&adc {
-	vdd-supply = <&scmi_vdd>;
-	vdda-supply = <&scmi_vdd>;
-};
-
 &cpu0 {
 	clocks = <&scmi_clk CK_SCMI_MPU>;
 };
@@ -40,13 +35,6 @@ &cryp1 {
 	resets = <&scmi_reset RST_SCMI_CRYP1>;
 };
 
-&cs42l51 {
-	VL-supply = <&scmi_v3v3>;
-	VD-supply = <&scmi_v1v8_audio>;
-	VA-supply = <&scmi_v1v8_audio>;
-	VAHP-supply = <&scmi_v1v8_audio>;
-};
-
 &dsi {
 	phy-dsi-supply = <&scmi_reg18>;
 	clocks = <&rcc DSI>, <&scmi_clk CK_SCMI_HSE>, <&rcc DSI_PX>;
@@ -61,11 +49,9 @@ &hash1 {
 	resets = <&scmi_reset RST_SCMI_HASH1>;
 };
 
-&i2c1 {
-	hdmi-transmitter@39 {
-		iovcc-supply = <&scmi_v3v3_hdmi>;
-		cvcc12-supply = <&scmi_v1v2_hdmi>;
-	};
+&i2c4 {
+	clocks = <&scmi_clk CK_SCMI_I2C4>;
+	resets = <&scmi_reset RST_SCMI_I2C4>;
 };
 
 &iwdg2 {
@@ -89,12 +75,6 @@ &optee {
 	bootph-some-ram;
 };
 
-&pwr_regulators {
-	vdd-supply = <&scmi_vdd>;
-	vdd_3v3_usbfs-supply = <&scmi_vdd_usb>;
-	status = "disabled";
-};
-
 &rcc {
 	compatible = "st,stm32mp1-rcc-secure", "syscon";
 	clock-names = "hse", "hsi", "csi", "lse", "lsi";
@@ -117,84 +97,3 @@ &rtc {
 &scmi {
 	bootph-some-ram;
 };
-
-&scmi_reguls {
-	scmi_vddcore: regulator@3 {
-		reg = <VOLTD_SCMI_STPMIC1_BUCK1>;
-		regulator-name = "vddcore";
-	};
-
-	scmi_vdd: regulator@5 {
-		reg = <VOLTD_SCMI_STPMIC1_BUCK3>;
-		regulator-name = "vdd";
-	};
-
-	scmi_v3v3: regulator@6 {
-		reg = <VOLTD_SCMI_STPMIC1_BUCK4>;
-		regulator-name = "v3v3";
-	};
-
-	scmi_v1v8_audio: regulator@7 {
-		reg = <VOLTD_SCMI_STPMIC1_LDO1>;
-		regulator-name = "v1v8_audio";
-	};
-
-	scmi_v3v3_hdmi: regulator@8 {
-		reg = <VOLTD_SCMI_STPMIC1_LDO2>;
-		regulator-name = "v3v3_hdmi";
-	};
-
-	scmi_vdd_usb: regulator@a {
-		reg = <VOLTD_SCMI_STPMIC1_LDO4>;
-		regulator-name = "vdd_usb";
-	};
-
-	scmi_vdda: regulator@b {
-		reg = <VOLTD_SCMI_STPMIC1_LDO5>;
-		regulator-name = "vdda";
-	};
-
-	scmi_v1v2_hdmi: regulator@c {
-		reg = <VOLTD_SCMI_STPMIC1_LDO6>;
-		regulator-name = "v1v2_hdmi";
-		regulator-min-microvolt = <1200000>;
-		regulator-max-microvolt = <1200000>;
-		regulator-always-on;
-	};
-
-	scmi_vbus_otg: regulator@f {
-		reg = <VOLTD_SCMI_STPMIC1_PWR_SW1>;
-		regulator-name = "vbus_otg";
-	 };
-
-	 scmi_vbus_sw: regulator@10 {
-		reg = <VOLTD_SCMI_STPMIC1_PWR_SW2>;
-		regulator-name = "vbus_sw";
-	 };
-};
-
-&sdmmc1 {
-	vmmc-supply = <&scmi_v3v3>;
-};
-
-&sdmmc3 {
-	vmmc-supply = <&scmi_v3v3>;
-};
-
-&usbh_ehci {
-	hub@1 {
-		vdd-supply = <&scmi_v3v3>;
-	};
-};
-
-&usbphyc_port0 {
-	phy-supply = <&scmi_vdd_usb>;
-};
-
-&usbphyc_port1 {
-	phy-supply = <&scmi_vdd_usb>;
-};
-
-&vrefbuf {
-	vdda-supply = <&scmi_vdd>;
-};
diff --git a/arch/arm/boot/dts/st/stm32mp157f-dk2.dts b/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
index e893b42ab186..e1e51683f397 100644
--- a/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
+++ b/arch/arm/boot/dts/st/stm32mp157f-dk2.dts
@@ -50,7 +50,7 @@ panel@0 {
 		compatible = "orisetech,otm8009a";
 		reg = <0>;
 		reset-gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
-		power-supply = <&scmi_v3v3>;
+		power-supply = <&v3v3>;
 
 		port {
 			panel_in: endpoint {
@@ -85,23 +85,6 @@ touchscreen@38 {
 	};
 };
 
-/* I2C4 is managed by OP-TEE */
-&i2c4 {
-	status = "disabled";
-
-	/* i2c4 subnodes, which won't be managed by Linux */
-	typec@28 {
-		status = "disabled";
-		connector {
-			status = "disabled";
-		};
-	};
-
-	stpmic@33 {
-		status = "disabled";
-	};
-};
-
 &ltdc {
 	bootph-some-ram;
 	status = "okay";
@@ -137,7 +120,7 @@ &sdmmc2 {
 	cap-sdio-irq;
 	st,neg-edge;
 	bus-width = <4>;
-	vmmc-supply = <&scmi_v3v3>;
+	vmmc-supply = <&v3v3>;
 	mmc-pwrseq = <&wifi_pwrseq>;
 	#address-cells = <1>;
 	#size-cells = <0>;
@@ -164,21 +147,7 @@ bluetooth {
 		shutdown-gpios = <&gpioz 6 GPIO_ACTIVE_HIGH>;
 		compatible = "brcm,bcm43438-bt";
 		max-speed = <3000000>;
-		vbat-supply = <&scmi_v3v3>;
-		vddio-supply = <&scmi_v3v3>;
+		vbat-supply = <&v3v3>;
+		vddio-supply = <&v3v3>;
 	};
 };
-
-/* Since I2C4 is disabled, STUSB1600 is also disabled so there is no Type-C support */
-&usbotg_hs {
-	dr_mode = "peripheral";
-	role-switch-default-mode = "peripheral";
-	/*
-	 * Forcing dr_mode = "peripheral"/"role-switch-default-mode = "peripheral";
-	 * will cause the pull-up on D+/D- to be raised as soon as the OTG is configured at runtime,
-	 * regardless of the presence of VBUS. Notice that on self-powered devices like
-	 * stm32mp157f-dk2, this isn't compliant with the USB standard. That's why usbotg_hs is kept
-	 * disabled here.
-	 */
-	status = "disabled";
-};
-- 
2.53.0

