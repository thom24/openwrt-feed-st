From e67db90abae5fdb488a297ee100b5e5b4719ec79 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Tue, 2 Jun 2026 17:35:33 +0200
Subject: [PATCH] bus: rifsc: reduce the verbosity for not accessible
 peripherals

Depending on security settings of the platform, some peripheral
can be not accessible.

Don't log an error message in this case; use a debug message.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I913e333783fb81c907cc9fdebb3b86a56f894d62
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/573869
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 drivers/bus/stm32_rifsc.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

--- a/drivers/bus/stm32_rifsc.c
+++ b/drivers/bus/stm32_rifsc.c
@@ -791,8 +791,8 @@ static int stm32_rifsc_populate_bus(stru
 				 */
 				fwnode_links_purge(of_fwnode_handle(child));
 				of_detach_node(child);
-				dev_err(parent, "%s: Device driver will not be probed, error: %d\n",
-					child->full_name, err);
+				dev_dbg(parent, "%s: Device driver will not be probed\n",
+					child->full_name);
 			}
 			if (IS_ENABLED(CONFIG_STM32_RIFSC_DEBUG)) {
 				dev_dbg(parent, "Unprivileged %s", child->full_name);
