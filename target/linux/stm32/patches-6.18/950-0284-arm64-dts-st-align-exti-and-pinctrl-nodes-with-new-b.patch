From 30c22beda9265a60fec76e0419cc358807380b2a Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Wed, 9 Aug 2023 11:13:07 +0200
Subject: [PATCH] arm64: dts: st: align exti and pinctrl nodes with new
 bindings to stm32mp231

Remove the property "st,syscfg" from pinctrl and the compatible
"syscon" from EXTI.

Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -975,7 +975,7 @@
 		};
 
 		exti1: interrupt-controller@44220000 {
-			compatible = "st,stm32mp1-exti", "syscon";
+			compatible = "st,stm32mp1-exti";
 			reg = <0x44220000 0x400>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
@@ -1080,7 +1080,6 @@
 			#address-cells = <1>;
 			#size-cells = <1>;
 			interrupt-parent = <&exti1>;
-			st,syscfg = <&exti1 0x60 0xff>;
 			interrupts-extended =
 				<&exti1  0 0>, <&exti1  1 0>, <&exti1  2 0>, <&exti1  3 0>,
 				<&exti1  4 0>, <&exti1  5 0>, <&exti1  6 0>, <&exti1  7 0>,
@@ -1207,7 +1206,6 @@
 			#address-cells = <1>;
 			#size-cells = <1>;
 			interrupt-parent = <&exti1>;
-			st,syscfg = <&exti1 0x60 0xff>;
 			interrupts-extended =
 				<&exti1  0 0>, <&exti1  1 0>, <&exti1  2 0>, <&exti1  3 0>,
 				<&exti1  4 0>, <&exti1  5 0>, <&exti1  6 0>, <&exti1  7 0>,
@@ -1233,7 +1231,7 @@
 		};
 
 		exti2: interrupt-controller@46230000 {
-			compatible = "st,stm32mp1-exti", "syscon";
+			compatible = "st,stm32mp1-exti";
 			reg = <0x46230000 0x400>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
