From 43766dce4bee17a6b87c71e0a41533fd223a44aa Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Tue, 29 Jul 2025 11:27:38 +0200
Subject: [PATCH] arm64: dts: st: add I3C4 support on stm32mp257f-ev1

I3C4 is available on GPIO expansion connector and on mikroBus connector of
stm32mp257f-ev1 board.
On GPIO expansion connector and on mikroBus connector, it can use the same
pins as I2C8 (PZ3 and PZ4 configured with i3c4 pins_a pinctrl), but there
are external pull-ups on the board (it affects the performance of the I3C).
On mikroBus connector, it could also be configured with i3c4 pins_b pinctrl
but it uses the same pins as SPI8, without external pull-up on the board.

Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: Id351a6eff729dce4f87b6d33c27310e517dddcb7
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/545084
Tested-by: Alain VOLMAT <alain.volmat@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-ev1.dts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-ev1.dts
@@ -400,6 +400,23 @@
 	/delete-property/dma-names;
 };
 
+&i3c4 {
+	/*
+	 *  Connector | pins_a  | pins_b |
+	 * -----------+---------+--------|
+	 *  GPIO Exp. | I2C8+PU |   X    |
+	 * -----------+---------+--------|
+	 *  mikroBus  | I2C8+PU | SPI8   |
+	 *
+	 * X = not wired ; PU = External Pull-Up
+	 */
+	pinctrl-names = "default", "init", "sleep";
+	pinctrl-0 = <&i3c4_pins_b>;
+	pinctrl-1 = <&i3c4_init_pins_b>;
+	pinctrl-2 = <&i3c4_sleep_pins_b>;
+	status = "disabled";
+};
+
 &ipcc1 {
 	status = "okay";
 };
