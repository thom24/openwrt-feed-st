From 138cf7e71291db503cd0f4701676c04a2d7ba0c4 Mon Sep 17 00:00:00 2001
From: Alain Volmat <alain.volmat@foss.st.com>
Date: Fri, 20 Feb 2026 08:50:49 +0100
Subject: [PATCH] arm64: dts: st: add csi node on stm32mp215

Add the csi node in stm32mp215.dtsi

Signed-off-by: Alain Volmat <alain.volmat@foss.st.com>
Change-Id: Ic69add42f7d26b28fff059c8808f9654307777fd
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/539589
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Philippe CORNU <philippe.cornu@foss.st.com>
Reviewed-by: Hugues FRUCHET <hugues.fruchet@st.com>
Domain-Review: Philippe CORNU <philippe.cornu@foss.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
Tested-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp215.dtsi | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

--- a/arch/arm64/boot/dts/st/stm32mp215.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp215.dtsi
@@ -5,5 +5,17 @@
  */
 #include "stm32mp213.dtsi"
 
-/ {
+&rifsc {
+	csi: csi@48020000 {
+		compatible = "st,stm32mp25-csi";
+		reg = <0x48020000 0x0 0x2000>;
+		interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;
+		resets = <&rcc CSI_R>;
+		clocks = <&rcc CK_KER_CSI>, <&rcc CK_KER_CSITXESC>,
+			 <&rcc CK_KER_CSIPHY>;
+		clock-names = "pclk", "txesc", "csi2phy";
+		access-controllers = <&rifsc 86>;
+		power-domains = <&d1_pd>;
+		status = "disabled";
+	};
 };
