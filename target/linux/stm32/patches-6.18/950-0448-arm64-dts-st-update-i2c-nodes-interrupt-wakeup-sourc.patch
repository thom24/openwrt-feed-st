-				interrupts = <GIC_SPI 168 IRQ_TYPE_LEVEL_HIGH>;
+				interrupts-extended = <&exti1 24 IRQ_TYPE_LEVEL_HIGH>;
 				clocks = <&rcc CK_KER_I2C4>;
 				resets = <&rcc I2C4_R>;
 				#address-cells = <1>;
@@ -897,6 +900,7 @@ i2c4: i2c@40150000 {
 				access-controllers = <&rifsc 44>;
 				power-domains = <&d1_pd>;
 				i2c-analog-filter;
+				wakeup-source;
