From 0d10a00aeebf72d88b559e892ca5229e0c28823d Mon Sep 17 00:00:00 2001
From: Hugues Fruchet <hugues.fruchet@foss.st.com>
Date: Mon, 28 Sep 2026 11:33:35 +0200
Subject: [PATCH] media: v4l2-common: Fix v4l2_[g/s]_parm_cap

As a client of subdev frame_interval, v4l2_[g/s]_parm_cap must
set "which" field to active instead of try (default 0 value).

Fixes: 805d4311a54a ("media: v4l2-subdev: Add which field to struct v4l2_subdev_frame_interval")

Change-Id: Ie02b5ea89366042af1bc8d8761d955f1c680aa2a
Signed-off-by: Hugues Fruchet <hugues.fruchet@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/617937
Reviewed-by: Hugues FRUCHET <hugues.fruchet@st.com>
Tested-by: Hugues FRUCHET <hugues.fruchet@st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
Domain-Review: Philippe CORNU <philippe.cornu@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Philippe CORNU <philippe.cornu@foss.st.com>
---
 drivers/media/v4l2-core/v4l2-common.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/media/v4l2-core/v4l2-common.c b/drivers/media/v4l2-core/v4l2-common.c
index 59df53336450..7b65374943f0 100644
--- a/drivers/media/v4l2-core/v4l2-common.c
+++ b/drivers/media/v4l2-core/v4l2-common.c
@@ -197,7 +197,7 @@ EXPORT_SYMBOL_GPL(__v4l2_find_nearest_size_conditional);
 int v4l2_g_parm_cap(struct video_device *vdev,
 		    struct v4l2_subdev *sd, struct v4l2_streamparm *a)
 {
-	struct v4l2_subdev_frame_interval ival = { 0 };
+	struct v4l2_subdev_frame_interval ival = { .which = V4L2_SUBDEV_FORMAT_ACTIVE };
 	int ret;
 
 	if (a->type != V4L2_BUF_TYPE_VIDEO_CAPTURE &&
@@ -219,6 +219,7 @@ int v4l2_s_parm_cap(struct video_device *vdev,
 		    struct v4l2_subdev *sd, struct v4l2_streamparm *a)
 {
 	struct v4l2_subdev_frame_interval ival = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
 		.interval = a->parm.capture.timeperframe
 	};
 	int ret;
-- 
2.53.0

