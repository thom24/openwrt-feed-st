From ef89cda430e953edc8f72dd45131407344ee29a8 Mon Sep 17 00:00:00 2001
From: Pankaj Dev <pankaj.dev@st.com>
Date: Tue, 19 Apr 2022 12:29:50 +0530
Subject: [PATCH] arm64: dts: st: add usb2phy support on stm32mp251

Add USB2PHY support on stm32mp251:
- usb2phy1 is dedicated to the usb 2.0 host controller
- usb2phy2 is dedicated to the usb dwc3 Dual-Role Controller,
  supporting Low/Full/High-Speed

The USB2PHY is a clock provider. It provides clocks (e.g. 48MHz) to
the controllers, through RCC:
_______________      ____________________      ______________________
| USB2PHY PLL | ---> | RCC clock gating | ---> | EHCI/OHCI , or DWC3 |
---------------      --------------------      ----------------------
Add the necessary #clock-cells, so the clock can be requested in the
controller nodes. Distinguish OHCI and PLL clocks on stm32mp251, by
using one cell clock bindings. The OHCI clock must be enabled
specifically during resume from low power.

Change-Id: I44c08b37d2c51e9e6269792b8b2bb2cbaf4a0fc8
Signed-off-by: Pankaj Dev <pankaj.dev@st.com>
Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559880
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp251.dtsi b/arch/arm64/boot/dts/st/stm32mp251.dtsi
index 81d4138f3e3e..3310c0770538 100644
--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -261,6 +261,28 @@ timer {
 		arm,no-tick-in-suspend;
 	};
 
+	usb2_phy1: usb2-phy1 {
+		compatible      = "st,stm32mp25-usb2phy";
+		#phy-cells      = <0>;
+		#clock-cells    = <1>;
+		st,syscfg       = <&syscfg 0x2400>;
+		clocks          = <&rcc CK_KER_USB2PHY1>, <&rcc CK_KER_USB2PHY1STP>;
+		clock-names     = "core", "stp";
+		resets          = <&rcc USB2PHY1_R>;
+		status          = "disabled";
+	};
+
+	usb2_phy2: usb2-phy2 {
+		compatible      = "st,stm32mp25-usb2phy";
+		#phy-cells      = <0>;
+		#clock-cells    = <1>;
+		st,syscfg       = <&syscfg 0x2800>;
+		clocks          = <&rcc CK_KER_USB2PHY2EN>;
+		clock-names     = "core";
+		resets          = <&rcc USB2PHY2_R>;
+		status          = "disabled";
+	};
+
 	soc@0 {
 		compatible = "simple-bus";
 		#address-cells = <1>;
-- 
2.53.0

