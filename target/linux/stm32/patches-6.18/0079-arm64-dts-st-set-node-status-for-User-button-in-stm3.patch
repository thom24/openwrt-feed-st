From ef502e0acfc7c280d3f5ad51a5b414436fe9c177 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Wed, 1 Apr 2026 16:39:04 +0200
Subject: [PATCH] arm64: dts: st: set node status for User button in
 stm32mp257f-dk

Add the node status for the 'User1' and 'User2' button on the
stm32mp257f-dk board.

Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Ibd7e77e9bd2927403b606a3ca5b6417dc773f620
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/553204
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp257f-dk.dts | 2 ++
 1 file changed, 2 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
+++ b/arch/arm64/boot/dts/st/stm32mp257f-dk.dts
@@ -34,12 +34,14 @@
 			label = "User-1";
 			linux,code = <BTN_1>;
 			gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
+			status = "okay";
 		};
 
 		button-user-2 {
 			label = "User-2";
 			linux,code = <BTN_2>;
 			gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>;
+			status = "disabled";
 		};
 	};
 
