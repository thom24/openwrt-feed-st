From 2bb5771ebfd0055622e1d3fa4aaf076642f26141 Mon Sep 17 00:00:00 2001
From: Alain Volmat <alain.volmat@foss.st.com>
Date: Mon, 15 Dec 2025 13:19:43 +0100
Subject: [PATCH] arm64: dts: st: enable i2c analog-filter in stm32mp251.dtsi

By default enable the analog filter on all i2c instances on
the stm32mp25x series.

Signed-off-by: Alain Volmat <alain.volmat@foss.st.com>
Change-Id: Idabb9f7c51bd5744a03aafb19d1c9eb1d00eeda8
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/536945
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Alain VOLMAT <alain.volmat@st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Tested-by: Alain VOLMAT <alain.volmat@st.com>
---
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -842,6 +842,7 @@
 				dma-names = "rx", "tx";
 				access-controllers = <&rifsc 41>;
 				power-domains = <&d1_pd>;
+				i2c-analog-filter;
 				status = "disabled";
 			};
 
@@ -859,6 +860,7 @@
 				dma-names = "rx", "tx";
 				access-controllers = <&rifsc 42>;
 				power-domains = <&d1_pd>;
+				i2c-analog-filter;
