 6 files changed, 140 insertions(+), 3 deletions(-)

--- a/arch/arm/boot/dts/st/stm32mp131.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp131.dtsi
@@ -22,9 +22,54 @@
 			compatible = "arm,cortex-a7";
 			device_type = "cpu";
 			reg = <0>;
-			power-domains = <&scmi_perf 0>;
-			power-domain-names = "perf";
+			power-domains = <&cpu0_pd>, <&scmi_perf 0>;
+			power-domain-names = "psci", "perf";
+			enable-method = "psci";
 			#cooling-cells = <2>;
+
+		};
+
+		domain-idle-states {
+			stop1: domain-stop1 {
+				compatible = "domain-idle-state";
+				arm,psci-suspend-param = <0x00000012>;
+				/* TODO: update latency values */
+				entry-latency-us = <300>;
+				exit-latency-us = <500>;
+				min-residency-us = <1500>;
+			};
+
+			lp_stop1: domain-lp-stop1 {
+				compatible = "domain-idle-state";
+				arm,psci-suspend-param = <0x0000022>;
+				/* TODO: update latency values */
+				entry-latency-us = <350>;
+				exit-latency-us = <600>;
+				min-residency-us = <2000>;
+			};
+
+			lplv_stop1: domain-lplv-stop1 {
+				compatible = "domain-idle-state";
+				arm,psci-suspend-param = <0x00000222>;
+				/* TODO: update latency values */
+				entry-latency-us = <500>;
+				exit-latency-us = <2000>;
+				min-residency-us = <2500>;
+			};
+		};
+
+		idle-states {
+			entry-method = "psci";
+
+			cpu_pwrdn: cpu-power-down {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x00000002>;
+				local-timer-stop;
+				/* TODO: update latency values */
+				entry-latency-us = <150>;
+				exit-latency-us = <200>;
+				min-residency-us = <1000>;
+			};
 		};
 	};
 
@@ -104,9 +149,32 @@
 		      <0xa0022000 0x2000>;
 	};
 
+	d1_pd: power-domain-d1 {
+		compatible = "st,stm32mp-pm-domain";
+		#power-domain-cells = <0>;
+		power-domains = <&pd_core>;
+	};
+
 	psci: psci {
 		compatible = "arm,psci-1.0";
 		method = "smc";
+
+		cpu0_pd: power-domain-cpu0 {
+			#power-domain-cells = <0>;
+			domain-idle-states = <&cpu_pwrdn>;
+			power-domains = <&pd_core>;
+		};
+
+		pd_core: power-domain-cluster {
+			#power-domain-cells = <0>;
+			domain-idle-states = <&stop1>, <&lp_stop1>;
+			power-domains = <&pd_core_ret>;
+		};
+
+		pd_core_ret: power-domain-retention {
+			#power-domain-cells = <0>;
+			domain-idle-states = <&lplv_stop1>;
+		};
 	};
 
