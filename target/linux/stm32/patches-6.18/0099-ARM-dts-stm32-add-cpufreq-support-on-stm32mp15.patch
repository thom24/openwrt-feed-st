+ * Copyright (C) STMicroelectronics 2026 - All Rights Reserved
+ * Author: Alexandre Torgue <alexandre.torgue@foss.st.com> for STMicroelectronics.
+ */
+
+&cpu_thermal {
+	trips {
+		cpu-crit {
+			temperature = <100000>;
+			hysteresis = <1000>;
+			type = "critical";
+		};
+
+		cpu_alert: cpu-alert {
+			temperature = <90000>;
+			hysteresis = <10000>;
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map0 {
+			trip = <&cpu_alert>;
+			cooling-device = <&cpu0 1 1>;
+		};
+	};
+};
