 arch/arm/boot/dts/st/stm32mp15xf.dtsi     |  2 ++
 arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi |  8 ++++++
 9 files changed, 83 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm/boot/dts/st/stm32mp15xd.dtsi

diff --git a/arch/arm/boot/dts/st/stm32mp151.dtsi b/arch/arm/boot/dts/st/stm32mp151.dtsi
index dd8319a0a3cf..ead2c0f0e69b 100644
--- a/arch/arm/boot/dts/st/stm32mp151.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp151.dtsi
@@ -17,9 +17,34 @@ cpus {
 
 		cpu0: cpu@0 {
 			compatible = "arm,cortex-a7";
-			clock-frequency = <650000000>;
 			device_type = "cpu";
 			reg = <0>;
+			clocks = <&rcc CK_MPU>;
+			clock-names = "cpu";
+			operating-points-v2 = <&cpu0_opp_table>;
+			nvmem-cells = <&cpu_speed_grade>;
+			nvmem-cell-names = "speed_grade";
+			#cooling-cells = <2>;
+		};
+	};
+
+	cpu0_opp_table: opp-table-cpu0 {
+		bootph-pre-ram;
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-650000000 {
+			bootph-pre-ram;
+			opp-hz = /bits/ 64 <650000000>;
+			opp-microvolt = <1200000>;
+			opp-supported-hw = <0x3>;
+		};
+
+		opp-800000000 {
+			bootph-pre-ram;
+			opp-hz = /bits/ 64 <800000000>;
+			opp-microvolt = <1350000>;
+			opp-supported-hw = <0x2>;
 		};
 	};
 
@@ -405,7 +430,8 @@ bsec: efuse@5c005000 {
 			reg = <0x5c005000 0x400>;
 			#address-cells = <1>;
 			#size-cells = <1>;
-			part_number_otp: part-number-otp@4 {
+
+			cpu_speed_grade: cpu-speed-grade@4 {
 				reg = <0x4 0x1>;
 			};
 			vrefint: vrefin-cal@52 {
diff --git a/arch/arm/boot/dts/st/stm32mp153.dtsi b/arch/arm/boot/dts/st/stm32mp153.dtsi
index 92794b942ab2..483b8ac90e98 100644
