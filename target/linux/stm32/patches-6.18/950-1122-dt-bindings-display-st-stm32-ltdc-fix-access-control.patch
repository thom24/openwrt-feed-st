From 9c2b1e5f8ba069525b372164e68470e1455dadc9 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Tue, 21 Apr 2026 11:20:30 +0200
Subject: [PATCH] dt-bindings: display: st,stm32-ltdc: fix access-controllers
 and power-domains

Add new access-controller properties separately (several sub-nodes) to
describe the common controller, the rotation controller, and the L1, L2,
and L3 layers.

Describe power-domains property.

Change-Id: I60b9f64387c985aca2673b628c350dd173250640
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/559637
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 .../bindings/display/st,stm32-ltdc.yaml       | 60 ++++++++++++++++++-
 1 file changed, 59 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/display/st,stm32-ltdc.yaml b/Documentation/devicetree/bindings/display/st,stm32-ltdc.yaml
index 77058a5ccf68..2c3849ba4df3 100644
--- a/Documentation/devicetree/bindings/display/st,stm32-ltdc.yaml
+++ b/Documentation/devicetree/bindings/display/st,stm32-ltdc.yaml
@@ -42,7 +42,62 @@ properties:
     maxItems: 1
 
   access-controllers:
-    maxItems: 1
+    description: phandle to the rifsc device to check access right.
+    items:
+      - description: phandle to common controller
+
+  access-controller-names:
+    items:
+      - const: cmn
+
+  l1l2:
+    type: object
+    additionalProperties: false
+
+    properties:
+      access-controllers:
+        description: phandle to the rifsc device to check access right.
+        items:
+          - description: phandle to l1 & l2 layers
+
+      access-controller-names:
+        items:
+          - const: l1l2
+
+  l3:
+    type: object
+    additionalProperties: false
+
+    properties:
+      access-controllers:
+        description: phandle to the rifsc device to check access right.
+        items:
+          - description: phandle to l3 layer
+
+      access-controller-names:
+        items:
+          - const: l3
+
+  rot:
+    type: object
+    additionalProperties: false
+
+    properties:
+      access-controllers:
+        description: phandle to the rifsc device to check access right.
+        items:
+          - description: phandle to rotation controller
+
+      access-controller-names:
+        items:
+          - const: rot
+
+  rotation-memory:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    description:
+      List of phandles to the reserved memory regions associated with the
+      rotation feature. The size of this memory is at least two frames.
+      (see ../reserved-memory/reserved-memory.txt)
 
   port:
     $ref: /schemas/graph.yaml#/properties/port
@@ -53,6 +108,9 @@ properties:
       - for internal dpi input of the MIPI DSI host controller.
       Note: These 2 endpoints cannot be activated simultaneously.
 
+  power-domains:
+    maxItems: 1
+
 required:
   - compatible
   - reg
-- 
2.53.0

