From ecbfbc688c5963d1973859f6cb37450af6524f3c Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Wed, 4 Feb 2026 11:25:21 +0100
Subject: [PATCH] arm64: dts: st: change PCIE bus clock reference to use the
 SCMI clock

The PCIE bus clock should be managed by SCMI, therefore, update the
clock reference to use the SCMI clock.

Change-Id: I53cd050e8c9615db076691885639a5680a889aa6
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/532273
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Tested-by: Christian BRUEL <christian.bruel@foss.st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -1814,7 +1814,7 @@
 				      <0x48700000 0x80000>,
 				      <0x10000000 0x10000000>;
 				reg-names = "dbi", "dbi2", "atu", "addr_space";
-				clocks = <&rcc CK_BUS_PCIE>;
+				clocks = <&scmi_clk CK_SCMI_ICN_PCIE>;
 				resets = <&rcc PCIE_R>;
 				phys = <&combophy PHY_TYPE_PCIE>;
 				access-controllers = <&rifsc 68>;
@@ -1840,7 +1840,7 @@
 					 <0x02000000 0x0 0x10020000 0x10020000 0x0 0x7fe0000>,
 					 <0x42000000 0x0 0x18000000 0x18000000 0x0 0x8000000>;
 				dma-ranges = <0x42000000 0x0 0x80000000 0x80000000 0x0 0x80000000>;
-				clocks = <&rcc CK_BUS_PCIE>;
+				clocks = <&scmi_clk CK_SCMI_ICN_PCIE>;
 				resets = <&rcc PCIE_R>;
 				msi-parent = <&v2m0>;
 				access-controllers = <&rifsc 68>;
