From 780e90d77ca15a71ed1754dfd7f04cb447a9d7d9 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Thu, 26 Mar 2026 15:11:56 +0100
Subject: [PATCH] dt-bindings: display: st,stm32mp25-lvds: add second port

Add second output port node for support clone mode (same panels)
or a panel with 8 data lanes (2 channels).

Change-Id: I3c727ba12ef0c4738097640afd3d87f72e2fffba
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
---
 .../bindings/display/st,stm32mp25-lvds.yaml       | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

--- a/Documentation/devicetree/bindings/display/st,stm32mp25-lvds.yaml
+++ b/Documentation/devicetree/bindings/display/st,stm32mp25-lvds.yaml
@@ -79,6 +79,12 @@ properties:
         description:
           LVDS output port node, connected to a panel or bridge input port.
 
+      port@2:
+        $ref: /schemas/graph.yaml#/properties/port
+        description:
+          LVDS output port node, connected to a panel or bridge input second port.
+          (sink for odd or even pixels).
+
     required:
       - port@0
       - port@1
@@ -121,7 +127,14 @@ examples:
             port@1 {
                 reg = <1>;
                 lvds_out0: endpoint {
-                   remote-endpoint = <&lvds_panel_in>;
+                   remote-endpoint = <&lvds_panel_in0>;
+                };
+            };
+
+            port@2 {
+                reg = <2>;
+                lvds_out1: endpoint {
+                    remote-endpoint = <&lvds_panel_in1>;
                 };
             };
         };
