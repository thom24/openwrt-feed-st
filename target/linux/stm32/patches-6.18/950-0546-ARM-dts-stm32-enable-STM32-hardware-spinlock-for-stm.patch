From 2b6ee139626ead9da0beb72d2fe0323c18b914d0 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Wed, 4 Mar 2026 12:01:33 +0100
Subject: [PATCH] ARM: dts: stm32: enable STM32 hardware spinlock for
 stm32mp151

Enable the STM32 hardware spinlock controller in the Device Tree
according to the binding documented in
devicetree.org/schemas/hwlock/st,stm32-hwspinlock.yaml.

Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I37b241633893d1fc6eb356f4434f3ed30ac793c5
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/543229
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Reviewed-by: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 arch/arm/boot/dts/st/stm32mp151.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

--- a/arch/arm/boot/dts/st/stm32mp151.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp151.dtsi
@@ -155,6 +155,14 @@
 		interrupt-parent = <&intc>;
 		ranges;
 
+		hsem: hwspinlock@4c000000 {
+			compatible = "st,stm32-hwspinlock";
+			#hwlock-cells = <2>;
+			reg = <0x4c000000 0x400>;
+			clocks = <&rcc HSEM>;
+			clock-names = "hsem";
+		};
+
 		ipcc: mailbox@4c001000 {
 			compatible = "st,stm32mp1-ipcc";
 			#mbox-cells = <1>;
