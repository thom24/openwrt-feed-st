[   99.281146] pstate: 60000005 (nZCv daif -PAN -UAO -TCO -DIT -SSBS BTYPE=--)
[   99.288093] pc : dwc2_disable_global_interrupts+0x8/0x50
[   99.293446] lr : dwc2_driver_shutdown+0x1c/0x34
[   99.297883] sp : ffff8000822ebc10
