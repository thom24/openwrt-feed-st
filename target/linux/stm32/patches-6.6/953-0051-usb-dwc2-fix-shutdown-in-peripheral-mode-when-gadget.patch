[   99.322568] x20: ffff000004290810 x19: ffff0000043b6080 x18: ffffffffffffffff
[   99.329622] x17: 0000000000000000 x16: 0000000000000000 x15: 00001e792d2d8ca8
[   99.336776] x14: 00001e792d2d8ca8 x13: 0000000000000094 x12: ffff000005f6d11c
[   99.343929] x11: 0000000000000040 x10: ffff80008190d658 x9 : ffff80008190d650
[   99.350983] x8 : ffff000004400028 x7 : 0000000000000000 x6 : 0000000000000000
[   99.358136] x5 : ffff000004290848 x4 : 0000000000000000 x3 : 0000000000000002
[   99.365189] x2 : 0000000000000001 x1 : ffff800082090008 x0 : ffff0000043b6080
[   99.372344] Call trace:
[   99.374764]  dwc2_disable_global_interrupts+0x8/0x50
[   99.379704]  platform_shutdown+0x24/0x34
[   99.383638]  device_shutdown+0x150/0x25c
[   99.387472]  kernel_restart+0x40/0xc0
[   99.391109]  __do_sys_reboot+0x178/0x268
[   99.395044]  __arm64_sys_reboot+0x24/0x30
