+++ b/arch/arm/boot/dts/st/stm32mp157a-ed1.dts
@@ -419,6 +419,7 @@
 };
 
 &uart4 {
+	bootph-all;
 	pinctrl-names = "default", "sleep", "idle";
 	pinctrl-0 = <&uart4_pins_a>;
 	pinctrl-1 = <&uart4_sleep_pins_a>;
@@ -428,6 +429,16 @@
 	status = "okay";
 };
 
+&uart4_pins_a {
+	bootph-all;
+	pins1 {
