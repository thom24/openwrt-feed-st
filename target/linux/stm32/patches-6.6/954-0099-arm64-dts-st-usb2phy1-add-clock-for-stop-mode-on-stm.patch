From f7c527db25b27272fa6a61284358114906a5e81c Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Wed, 3 Sep 2025 14:42:29 +0200
Subject: [PATCH] arm64: dts: st: usb2phy1: add clock for stop mode on
 stm32mp251

On STM32MP23/25, USB2PHY1 clock can remain active in stop mode.
This is useful for PSCI/OSI. So add clock names, as defined in the
bindings, and associated stop clock on usb2phy1.

Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: If83e74a08bb04f8f11274c6d4501621866038d93
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/487221
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Christian BRUEL <christian.bruel@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -303,7 +303,8 @@
 		#phy-cells      = <0>;
 		#clock-cells    = <1>;
 		st,syscfg       = <&syscfg 0x2400>;
-		clocks          = <&rcc CK_KER_USB2PHY1>;
+		clocks          = <&rcc CK_KER_USB2PHY1>, <&rcc CK_KER_USB2PHY1STP>;
+		clock-names     = "core", "stp";
 		resets          = <&rcc USB2PHY1_R>;
 		status          = "disabled";
 	};
@@ -314,6 +315,7 @@
 		#clock-cells    = <1>;
 		st,syscfg       = <&syscfg 0x2800>;
 		clocks          = <&rcc CK_KER_USB2PHY2EN>;
+		clock-names     = "core";
 		resets          = <&rcc USB2PHY2_R>;
 		status          = "disabled";
 	};
