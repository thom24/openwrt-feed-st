From 6b17bdb794729916b99e75619928b2d4d7b52c08 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Fri, 3 Oct 2025 17:26:32 +0200
Subject: [PATCH] arm64: dts: st: add phase tags marking on stm32mp23

bootph-all as phase tag was added to dt-schema
(dtschema/schemas/bootph.yaml) to describe various node usage during
boot phases with DT.

Describe it for STM32MP23 boot devices.

Change-Id: I9fccc48290010924a5217bfc7be8a8131979f07b
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/linux-stm32/+/496302
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Patrice CHOTARD <patrice.chotard@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp231.dtsi | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

--- a/arch/arm64/boot/dts/st/stm32mp231.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp231.dtsi
@@ -125,6 +125,7 @@
 
 	firmware {
 		optee: optee {
+			bootph-all;
 			compatible = "linaro,optee-tz";
 			method = "smc";
 			interrupt-parent = <&intc>;
@@ -134,6 +135,7 @@
 		};
 
 		scmi: scmi {
+			bootph-all;
 			compatible = "linaro,scmi-optee";
 			#address-cells = <1>;
 			#size-cells = <0>;
@@ -150,6 +152,7 @@
 			};
 
 			scmi_clk: protocol@14 {
+				bootph-all;
 				reg = <0x14>;
 				#clock-cells = <1>;
 			};
@@ -224,6 +227,7 @@
 	};
 
 	psci {
+		bootph-all;
 		compatible = "arm,psci-1.0";
 		method = "smc";
 
@@ -321,6 +325,7 @@
 	};
 
 	soc@0 {
+		bootph-all;
 		compatible = "simple-bus";
 		#address-cells = <1>;
 		#size-cells = <1>;
@@ -461,6 +466,7 @@
 		};
 
 		rifsc: bus@42080000 {
+			bootph-all;
 			compatible = "st,stm32mp25-rifsc", "simple-bus";
 			reg = <0x42080000 0x1000>;
 			#address-cells = <1>;
@@ -1923,6 +1929,7 @@
 			};
 
 			ltdc: display-controller@48010000 {
+				bootph-all;
 				compatible = "st,stm32mp25-ltdc";
 				reg = <0x48010000 0x400>;
 				st,syscon = <&syscfg>;
@@ -2205,6 +2212,7 @@
 		};
 
 		bsec: efuse@44000000 {
+			bootph-all;
 			compatible = "st,stm32mp25-bsec";
 			reg = <0x44000000 0x1000>;
 			#address-cells = <1>;
@@ -2244,6 +2252,7 @@
 		};
 
 		rcc: clock-controller@44200000 {
+			bootph-all;
 			compatible = "st,stm32mp25-rcc";
 			reg = <0x44200000 0x10000>;
 			#clock-cells = <1>;
@@ -2436,12 +2445,14 @@
 		};
 
 		syscfg: syscon@44230000 {
+			bootph-all;
 			compatible = "st,stm32mp25-syscfg", "syscon";
 			reg = <0x44230000 0x10000>;
 			#clock-cells = <1>;
 		};
 
 		pinctrl: pinctrl@44240000 {
+			bootph-all;
 			#address-cells = <1>;
 			#size-cells = <1>;
 			compatible = "st,stm32mp257-pinctrl";
@@ -2458,6 +2469,7 @@
 				<&exti2 12 0>, <&exti2 13 0>, <&exti2 14 0>, <&exti2 15 0>;
 
 			gpioa: gpio@44240000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2469,6 +2481,7 @@
 			};
 
 			gpiob: gpio@44250000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2480,6 +2493,7 @@
 			};
 
 			gpioc: gpio@44260000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2491,6 +2505,7 @@
 			};
 
 			gpiod: gpio@44270000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2502,6 +2517,7 @@
 			};
 
 			gpioe: gpio@44280000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2513,6 +2529,7 @@
 			};
 
 			gpiof: gpio@44290000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2524,6 +2541,7 @@
 			};
 
 			gpiog: gpio@442a0000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2535,6 +2553,7 @@
 			};
 
 			gpioh: gpio@442b0000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2546,6 +2565,7 @@
 			};
 
 			gpioi: gpio@442c0000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
@@ -2609,6 +2629,7 @@
 		};
 
 		pinctrl_z: pinctrl@46200000 {
+			bootph-all;
 			#address-cells = <1>;
 			#size-cells = <1>;
 			compatible = "st,stm32mp257-z-pinctrl";
@@ -2625,6 +2646,7 @@
 				<&exti2 12 0>, <&exti2 13 0>, <&exti2 14 0>, <&exti2 15 0>;
 
 			gpioz: gpio@46200000 {
+				bootph-all;
 				gpio-controller;
 				#gpio-cells = <2>;
 				interrupt-controller;
