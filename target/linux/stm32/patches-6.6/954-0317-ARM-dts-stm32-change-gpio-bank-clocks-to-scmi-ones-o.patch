+++ b/arch/arm/boot/dts/st/stm32mp157a-dk1-scmi.dtsi
@@ -27,6 +27,50 @@
 	clocks = <&rcc DSI>, <&scmi_clk CK_SCMI_HSE>, <&rcc DSI_PX>;
 };
 
