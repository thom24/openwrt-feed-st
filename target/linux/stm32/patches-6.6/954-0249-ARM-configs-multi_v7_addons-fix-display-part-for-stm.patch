 CONFIG_STM32_IPCC=y
 CONFIG_STM32_RPROC=y
 CONFIG_TEE_REMOTEPROC=y
-CONFIG_TOUCHSCREEN_EDT_FT5X06=y
-CONFIG_TOUCHSCREEN_GOODIX=y
