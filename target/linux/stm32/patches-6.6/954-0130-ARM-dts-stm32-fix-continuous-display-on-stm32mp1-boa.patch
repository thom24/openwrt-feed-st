+++ b/arch/arm/boot/dts/st/stm32mp157a-ev1.dts
@@ -134,7 +134,6 @@ panel_backlight: panel-backlight {
 		compatible = "gpio-backlight";
 		gpios = <&gpiod 13 GPIO_ACTIVE_LOW>;
 		default-on;
-		default-brightness-level = <1>;
 		status = "okay";
 	};
 
@@ -340,7 +339,6 @@ dfsdm_endpoint3: endpoint {
 &dsi {
 	#address-cells = <1>;
 	#size-cells = <0>;
-	default-on;
 	status = "okay";
 
 	panel_dsi: panel@0 {
@@ -351,7 +349,6 @@ panel_dsi: panel@0 {
 		power-supply = <&v3v3>;
 		vcc-supply = <&v3v3>;
 		iovcc-supply = <&v3v3>;
-		default-on;
 		status = "okay";
 
 		port {
@@ -550,7 +547,6 @@ &i2c5 {
 };
 
 &ltdc {
-	default-on;
 	status = "okay";
 
 	port {
